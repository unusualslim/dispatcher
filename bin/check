#!/usr/bin/env bash
# Everything to pass before finishing a change, stopping at the first failure:
#   1. RuboCop on the Ruby files changed since origin/main (committed, uncommitted and new)
#   2. Brakeman security scan (accepted warnings live in config/brakeman.ignore)
#   3. The full test suite
# bin/check --all runs RuboCop on the whole app instead of the changed files.
# The pre-push hook (bin/hooks/pre-push) runs this.
set -euo pipefail
cd "$(dirname "$0")/.."

step() { printf '\n== %s ==\n' "$1"; }

step 'RuboCop'
if [ "${1:-}" = '--all' ]; then
  bin/rubocop
else
  base=$(git rev-parse --verify --quiet '@{upstream}' || git rev-parse --verify --quiet origin/main || true)
  files=$( { [ -n "$base" ] && git diff --name-only --diff-filter=ACMR "$base" -- '*.rb' '*.rake' Gemfile Rakefile config.ru
             git ls-files --others --exclude-standard -- '*.rb' '*.rake'; } | sort -u)
  if [ -n "$files" ]; then
    # shellcheck disable=SC2086
    bin/rubocop --force-exclusion $files
  else
    echo 'No changed Ruby files.'
  fi
fi

step 'Brakeman'
bundle exec brakeman --quiet --no-pager --no-summary

step 'Tests'
bin/rails test

printf '\nAll checks passed.\n'
