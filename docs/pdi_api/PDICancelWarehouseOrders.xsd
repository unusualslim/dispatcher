<?xml version="1.0" encoding="utf-8"?>
<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">

	<xs:complexType name="PDIWarehouseOrder">
		<xs:sequence>
			<xs:element name="OrderNo" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base ="xs:string">
						<xs:maxLength value="15"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="PurchaseOrderNo" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="20"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="AlternateReferenceNo" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base ="xs:string">
						<xs:maxLength value="15"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:element name="PDIWarehouseOrders">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="PDIWarehouseOrder" type="PDIWarehouseOrder" maxOccurs="unbounded" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	
</xs:schema>
