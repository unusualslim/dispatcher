          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="UnitCostOverridden" minOccurs="0">
        <xs:simpleType>
          <xs:restriction base="xs:integer">
            <xs:pattern value="-1|0" />
