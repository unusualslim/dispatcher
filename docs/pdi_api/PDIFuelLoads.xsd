<?xml version="1.0" encoding="utf-8"?>
<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">

	<xs:complexType name="LoadDetailType">
		<xs:sequence>
			<xs:element name="LoadDetailKey" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:decimal">
						<xs:fractionDigits value="0"/>
						<xs:totalDigits value="15"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="LoadProductID">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="50"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="LoadQuantity">
				<xs:simpleType>
					<xs:restriction base="xs:decimal">
						<xs:fractionDigits value="2"/>
						<xs:totalDigits value="12"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="LiftGrossQuantity">
				<xs:simpleType>
					<xs:restriction base="xs:decimal">
						<xs:fractionDigits value="2"/>
						<xs:totalDigits value="12"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="LiftNetQuantity">
				<xs:simpleType>
					<xs:restriction base="xs:decimal">
						<xs:fractionDigits value="2"/>
						<xs:totalDigits value="12"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="OriginType">
				<xs:simpleType>
					<xs:restriction base="xs:byte">
						<xs:enumeration value="0">
							<xs:annotation>
								<xs:documentation>Vendor/Terminal</xs:documentation>
							</xs:annotation>
						</xs:enumeration>
						<xs:enumeration value="1">
							<xs:annotation>
								<xs:documentation>Company Owned Bulk Plant</xs:documentation>
							</xs:annotation>
						</xs:enumeration>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="OriginVendorID" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="50"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="OriginTerminalID" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="50"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="OriginSiteID" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="50"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="OriginTankNo" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="30"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="OriginTankID" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="10"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="BOLNo" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="15"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="UnitCost">
				<xs:simpleType>
					<xs:restriction base="xs:decimal">
						<xs:fractionDigits value="7"/>
						<xs:totalDigits value="12"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="UnitCostOverridden" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:integer">
						<xs:pattern value="-1|0" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="FreightUnitCost">
				<xs:simpleType>
					<xs:restriction base="xs:decimal">
						<xs:fractionDigits value="7"/>
						<xs:totalDigits value="12"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="FreightUnitCostOverridden" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:integer">
						<xs:pattern value="-1|0" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="ContractID" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="50"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="AllocationID" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="50"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="LoadingNo" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="20"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="FuelDetailType">
		<xs:sequence>
			<xs:element name="OrderLineItemNo" type="xs:byte"/>
            <xs:element name="FuelDetailKey" minOccurs="0">
                <xs:simpleType>
                    <xs:restriction base="xs:decimal">
                        <xs:fractionDigits value="0"/>
                        <xs:totalDigits value="15"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
			<xs:element name="OrderedProductID">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="50"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="PurchasedProductID">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="50"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="ProductBlendID" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="50"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="DestinationTankNo" type="xs:short" minOccurs="0"/>
			<xs:element name="DestinationTankID" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="10"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="OrderedQuantity">
				<xs:simpleType>
					<xs:restriction base="xs:decimal">
						<xs:fractionDigits value="2"/>
						<xs:totalDigits value="12"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="DeliveredGrossQuantity">
				<xs:simpleType>
					<xs:restriction base="xs:decimal">
						<xs:fractionDigits value="2"/>
						<xs:totalDigits value="12"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="DeliveredNetQuantity">
				<xs:simpleType>
					<xs:restriction base="xs:decimal">
						<xs:fractionDigits value="2"/>
						<xs:totalDigits value="12"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="UnitPrice">
				<xs:simpleType>
					<xs:restriction base="xs:decimal">
						<xs:fractionDigits value="7"/>
						<xs:totalDigits value="12"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="UnitPriceOverridden" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:integer">
						<xs:pattern value="-1|0" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="FreightUnitPrice">
				<xs:simpleType>
					<xs:restriction base="xs:decimal">
						<xs:fractionDigits value="7"/>
						<xs:totalDigits value="12"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="FreightUnitPriceOverridden" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:integer">
						<xs:pattern value="-1|0" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="EstimatedPerUnitTaxAmount" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:decimal">
						<xs:fractionDigits value="7"/>
						<xs:totalDigits value="12"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="UnitPriceIncludesTaxes" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:integer">
						<xs:pattern value="-1|0" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="UnitPriceIncludesFreight" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:integer">
						<xs:pattern value="-1|0" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="TankCapacity" minOccurs="0" type="xs:decimal" />
			<xs:element name="OrderLineItemNote" minOccurs="0" type="xs:string" />
			<xs:element name="UsePercentFull" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:integer">
						<xs:pattern value="-1|0" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="PercentFull" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:decimal">
						<xs:fractionDigits value="2"/>
						<xs:totalDigits value="6"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="CustomerFuelContractID" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="15"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="EquipmentID" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="15"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="EquipmentDeliveryNotes" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="512"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="LoadDetail" type="LoadDetailType" maxOccurs="unbounded" />
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="Payment">
		<xs:sequence>
			<xs:element name="TransactionCode">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="10"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="ReferenceNo">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="30"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="PaymentAmount" type="xs:decimal"/>
			<xs:element name="IncludePaymentOnInvoice">
				<xs:simpleType>
					<xs:restriction base="xs:byte">
						<xs:enumeration value="0">
							<xs:annotation>
								<xs:documentation>No</xs:documentation>
							</xs:annotation>
						</xs:enumeration>
						<xs:enumeration value="1">
							<xs:annotation>
								<xs:documentation>Yes</xs:documentation>
							</xs:annotation>
						</xs:enumeration>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="PerLoadChargeType">
		<xs:sequence>
			<xs:element name="FuelFrtRule_Key" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:decimal">
						<xs:fractionDigits value="0"/>
						<xs:totalDigits value="15"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="FreightChargeID">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="50"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="FreightChargeAmount">
				<xs:simpleType>
					<xs:restriction base="xs:decimal">
						<xs:fractionDigits value="2"/>
						<xs:totalDigits value="12"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="PDIFuelOrder">
		<xs:sequence>
			<xs:element name="OrderNo" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base ="xs:string">
						<xs:maxLength value="15"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="OrderKey" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base ="xs:decimal">
						<xs:fractionDigits value="0"/>
						<xs:totalDigits value="15"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="OrderStatus" minOccurs="0" type="xs:integer" />
			<xs:element name="DestinationType">
				<xs:simpleType>
					<xs:restriction base="xs:byte">
						<xs:enumeration value="0">
							<xs:annotation>
								<xs:documentation>Company owned site</xs:documentation>
							</xs:annotation>
						</xs:enumeration>
						<xs:enumeration value="1">
							<xs:annotation>
								<xs:documentation>Customer location</xs:documentation>
							</xs:annotation>
						</xs:enumeration>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="CustomerID" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="50"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="CustomerLocationID" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="50"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="SiteID" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="50"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="PurchaseOrderNo" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="20"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="AlternateReferenceNo" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base ="xs:string">
						<xs:maxLength value="20"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="DeliveryDateTime" type="xs:dateTime" />
			<xs:element name="ActualDeliveryDateTime"  minOccurs="0" type="xs:dateTime" />
			<xs:element name="BusinessDate" type="xs:date" />
			<xs:element name="SplitBlends" minOccurs="0" type="xs:byte" />
			<xs:element name="DeliveryDirections" minOccurs="0" type="xs:string" />
			<xs:element name="DeliveryNotes" minOccurs="0" type="xs:string" />
			<xs:element name="CODPayment" minOccurs="0" type="xs:integer" />
			<xs:element name="CODAmountToCollect" minOccurs="0" type="xs:decimal" />
			<xs:element name="PaymentReceived" minOccurs="0" type="xs:integer" />
			<xs:element name="ShipToOverride" minOccurs="0" type="xs:integer" />
			<xs:element name="ShipToDescription" minOccurs="0" type="xs:string" />
			<xs:element name="ShipToAddress1" minOccurs="0" type="xs:string" />
			<xs:element name="ShipToAddress2" minOccurs="0" type="xs:string" />
			<xs:element name="ShipToCity" minOccurs="0" type="xs:string" />
			<xs:element name="ShipToState" minOccurs="0" type="xs:string" />
			<xs:element name="ShipToPostalCode" minOccurs="0" type="xs:string" />
			<xs:element name="ShipToPhone" minOccurs="0" type="xs:string" />
			<xs:element name="OrderTotalAmount" minOccurs="0" type="xs:decimal" />
			<xs:element name="EstimatedReserveDate" minOccurs="0" type="xs:dateTime" >
				<xs:annotation>
					<xs:documentation>This field won't be imported.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EstimatedRunOutDate" minOccurs="0" type="xs:dateTime" >
				<xs:annotation>
					<xs:documentation>This field won't be imported.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IsUrgent" minOccurs="0" type="xs:boolean" />
			<xs:element name="FuelDetail" type="FuelDetailType" maxOccurs="unbounded" />
			<xs:element name="PerLoadCharge" type="PerLoadChargeType" minOccurs="0" maxOccurs="unbounded" />
			<xs:element name="Payment" type ="Payment" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="PDIFuelLoad">
		<xs:sequence>
			<xs:element name="Load_Key" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:decimal">
						<xs:fractionDigits value="0"/>
						<xs:totalDigits value="15"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="LoadNo" maxOccurs="1">
				<xs:simpleType>
					<xs:restriction base="xs:decimal">
						<xs:fractionDigits value="0"/>
						<xs:totalDigits value="15"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="LoadReferenceNo" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="15"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="LiftDateTime" type="xs:dateTime" minOccurs="0"/>
			<xs:element name="CarrierID" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="50"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="VehicleID" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="15"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="VehicleDescription" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="30"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="DriverID" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="10"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="DriverName" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="40"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="BusinessDate" type="xs:date" />
			<xs:element name="TransportationMode" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="3"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="OdometerOut" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:decimal">
						<xs:fractionDigits value="1"/>
						<xs:totalDigits value="12"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="OdometerIn" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:decimal">
						<xs:fractionDigits value="1"/>
						<xs:totalDigits value="12"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="DateTimeOut" minOccurs="0" type="xs:dateTime" />
			<xs:element name="DateTimeIn" minOccurs="0" type="xs:dateTime" />
			<xs:element name="DiversionNo" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="30"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="LiftNotes" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="255"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="DiversionOrigDestCustID" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="15"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="DiversionOrigDestCustLocID" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="30"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="DiversionOrigDestSiteID" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="30"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="DiversionOrigDestTaxAuthorityID" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="20"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="PDIFuelOrder" type="PDIFuelOrder" maxOccurs="unbounded" />
			<xs:element name="PerLoadCharge" type="PerLoadChargeType" minOccurs="0" maxOccurs="unbounded" />
		</xs:sequence>
	</xs:complexType>

	<xs:element name="PDIFuelLoads">
		<xs:complexType>
			<xs:sequence>
