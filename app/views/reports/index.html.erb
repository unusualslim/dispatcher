<div class="container-fluid px-4 py-4" style="max-width: 1100px;">
  <h1 class="mb-1">Reports</h1>
  <p class="text-muted">Each report has filters, totals, CSV export and print.</p>

  <% Reports::Registry::AREAS.each do |area, label| %>
    <% reports = @reports[area] || [] %>
    <% pages = @pages[area] || [] %>
    <% next if reports.empty? && pages.empty? %>
    <h5 class="mt-4 mb-2"><%= label %></h5>
    <div class="row g-3">
      <% reports.each do |report| %>
        <div class="col-md-6 col-lg-4">
          <%= link_to report_path(report.key), class: 'card shadow-sm h-100 text-decoration-none text-body' do %>
            <div class="card-body">
              <div class="fw-semibold"><i class="bi bi-table me-1 text-muted"></i><%= report.title %></div>
              <div class="small text-muted mt-1"><%= report.description %></div>
            </div>
          <% end %>
        </div>
      <% end %>
      <% pages.each do |_area, title, description, path| %>
        <div class="col-md-6 col-lg-4">
          <%= link_to send(path), class: 'card shadow-sm h-100 text-decoration-none text-body' do %>
            <div class="card-body">
              <div class="fw-semibold"><i class="bi bi-box-arrow-up-right me-1 text-muted"></i><%= title %></div>
              <div class="small text-muted mt-1"><%= description %></div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
