<div class="container mt-4" style="max-width: 600px;">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Import Vendor Freight Terms</h1>
    <%= link_to 'Back to Vendors', vendors_path, class: 'btn btn-outline-secondary btn-sm' %>
  </div>

  <div class="card shadow-sm mb-3">
    <div class="card-body">
      <p class="text-muted small mb-3">
        Upload a CSV exported from PDI with vendor freight term assignments.
        Expected columns: <code>vendor_id</code> and <code>freight_term</code>.
        Existing assignments are not duplicated — safe to re-run.
      </p>

      <%= form_with url: vendor_freight_term_import_path, method: :post,
            multipart: true, local: true, data: { turbo: false } do |f| %>
        <div class="mb-3">
          <%= f.label :file, "CSV File", class: 'form-label' %>
          <%= f.file_field :file, class: 'form-control', accept: '.csv' %>
        </div>
        <%= f.submit "Import", class: 'btn btn-primary' %>
      <% end %>
    </div>
  </div>
</div>
