<div class="container mt-4" style="max-width: 600px;">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Edit Vendor</h1>
    <%= link_to 'Back', vendor_path(@vendor), class: 'btn btn-outline-secondary btn-sm' %>
  </div>

  <% if @vendor.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% @vendor.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @vendor, local: true do |form| %>
    <div class="card shadow-sm mb-3">
      <div class="card-header fw-semibold">Vendor Info</div>
      <div class="card-body row g-3">
        <div class="col-12">
          <%= form.label :name, class: 'form-label' %>
          <%= form.text_field :name, class: 'form-control', required: true %>
        </div>
        <div class="col-6">
          <%= form.label :contact_name, "Contact Name", class: 'form-label' %>
          <%= form.text_field :contact_name, class: 'form-control' %>
        </div>
        <div class="col-6">
          <%= form.label :phone, class: 'form-label' %>
          <%= form.text_field :phone, class: 'form-control' %>
        </div>
        <div class="col-12">
          <%= form.label :email, class: 'form-label' %>
          <%= form.email_field :email, class: 'form-control' %>
        </div>
        <div class="col-6">
          <%= form.label :lead_time_days, "Lead Time (days)", class: 'form-label' %>
          <%= form.number_field :lead_time_days, class: 'form-control', min: 0 %>
        </div>
        <div class="col-6">
          <%= form.label :payment_terms, class: 'form-label' %>
          <%= form.text_field :payment_terms, class: 'form-control', placeholder: 'e.g. Net 30' %>
        </div>
        <div class="col-6">
          <%= form.label :payment_method, class: 'form-label' %>
          <%= form.text_field :payment_method, class: 'form-control', placeholder: 'e.g. ACH' %>
        </div>
        <div class="col-12">
          <label class="form-label">Allowed Freight Terms</label>
          <div class="border rounded p-2">
            <% VendorFreightTerm::TERMS.each do |code, label| %>
              <div class="form-check">
                <input class="form-check-input" type="checkbox"
                       name="vendor[freight_term_names][]"
                       value="<%= code %>"
                       id="ft_<%= code.parameterize %>"
                       <%= 'checked' if form.object.freight_term_names.include?(code) %>>
                <label class="form-check-label" for="ft_<%= code.parameterize %>"><%= label %></label>
              </div>
            <% end %>
          </div>
          <%# sentinel so an empty selection submits [] instead of nothing %>
          <input type="hidden" name="vendor[freight_term_names][]" value="">
          <div class="form-text">These terms will be available when creating a PO for this vendor.</div>
        </div>
      </div>
    </div>

    <div class="card shadow-sm mb-3">
      <div class="card-header fw-semibold">PDI Integration</div>
      <div class="card-body">
        <div class="col-12">
          <%= form.label :id, "PDI Vendor ID", class: 'form-label' %>
          <%= form.text_field :id, class: 'form-control', disabled: true %>
          <div class="form-text">The vendor ID is set by PDI and synced automatically.</div>
        </div>
      </div>
    </div>

    <div class="d-flex gap-2">
      <%= form.submit 'Save Changes', class: 'btn btn-success' %>
      <%= link_to 'Cancel', vendor_path(@vendor), class: 'btn btn-secondary' %>
    </div>
  <% end %>
</div>
