<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Vendors</h1>
    <div class="d-flex gap-2 flex-wrap align-items-center">
      <button type="button" class="btn btn-outline-secondary btn-sm d-none" id="export-selected-btn"
              data-export-url="<%= export_csv_vendors_path %>">
        Export Selected (<span id="csv-selected-count">0</span>)
      </button>
      <%= link_to "Export All", export_csv_vendors_path, class: "btn btn-outline-secondary btn-sm" %>
      <%= link_to "Import CSV", import_csv_vendors_path, class: "btn btn-outline-primary btn-sm" %>
      <%= link_to "Import Freight Terms", new_vendor_freight_term_import_path, class: "btn btn-outline-primary btn-sm" %>
      <%= button_to "Import Preferred Vendors (one-time)", import_preferred_vendors_vendors_path,
            method: :post,
            data: { confirm: "This will assign preferred vendors to products that don't have one yet. Run this once on production. Continue?" },
            class: "btn btn-outline-warning btn-sm" %>
    </div>
  </div>

  <div class="d-flex justify-content-between align-items-center mb-2">
    <h3 class="mb-0">Vendor List</h3>
    <input type="text" id="vendor-search" class="form-control form-control-sm w-auto" placeholder="Search vendors…" autocomplete="off" style="min-width: 220px;">
  </div>
  <table class="table table-bordered align-middle" id="vendors-table">
    <thead>
      <tr>
        <th style="width:32px;"><input type="checkbox" class="form-check-input" id="bulk-select-all"></th>
        <th>Name</th>
        <th>PDI ID</th>
        <th>Address</th>
        <th>Phone</th>
        <th>Freight Terms</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @vendors.each do |vendor| %>
        <tr>
          <td><input type="checkbox" class="form-check-input bulk-row-select" value="<%= vendor.id %>"></td>
          <td><%= vendor.name %></td>
          <td><code><%= vendor.id %></code></td>
          <td class="text-nowrap">
            <%= [vendor.city, vendor.state].select(&:present?).join(', ') %>
          </td>
          <td class="text-nowrap"><%= vendor.phone %></td>
          <td>
            <% terms = vendor.vendor_freight_terms.map(&:freight_term).sort %>
            <% if terms.any? %>
              <% terms.each do |t| %>
                <span class="badge bg-secondary me-1"><%= t %></span>
              <% end %>
            <% else %>
              <span class="text-muted small">—</span>
            <% end %>
          </td>
          <td>
            <div class="btn-group">
              <%= link_to "View", vendor_path(vendor), class: "btn btn-primary btn-sm" %>
              <%= link_to "Edit", edit_vendor_path(vendor), class: "btn btn-outline-secondary btn-sm" %>
              <%= button_to "Delete", vendor_path(vendor), method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-danger btn-sm" %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<script>
  document.addEventListener('turbo:load', function() {
    var input = document.getElementById('vendor-search');
    if (!input) return;
    input.addEventListener('input', function() {
      var q = this.value.toLowerCase();
      document.querySelectorAll('#vendors-table tbody tr').forEach(function(row) {
        row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
      });
    });
  });
</script>
<%= render 'shared/bulk_select_js' %>
