<%= javascript_include_tag 'application', 'data-turbo-track': 'reload' %>

<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <% title = safe_join([@customer.name, (tag.span('Inactive', class: 'badge bg-secondary fs-6 align-middle') unless @customer.active)].compact, ' ') %>
      <%= render layout: 'shared/page_header',
                 locals: { title: title, subtitle: ("PDI customer #{@customer.pdi_customer_id}" if @customer.pdi_customer_id.present?),
                           previous_path: (customer_path(@previous_id) if @previous_id),
                           next_path: (customer_path(@next_id) if @next_id) } do %>
        <%= link_to 'Edit', edit_customer_path(@customer), class: 'btn btn-warning btn-sm', data: { turbo: false } %>
        <%= link_to 'Back', customers_path, class: 'btn btn-outline-secondary btn-sm' %>
        <%= button_to 'Delete', customer_path(@customer), method: :delete, class: 'btn btn-outline-danger btn-sm',
                      form: { data: { turbo_confirm: 'Delete this customer?' } } %>
      <% end %>

      <!-- Customer Info Card -->
      <div class="card shadow-sm border-primary">
        <div class="card-body">
          <!-- Additional Customer Info -->
          <p><strong>Email:</strong> <%= @customer.email %></p>
          <p><strong>Preferred Contact Method:</strong> <%= @customer.preferred_contact_method %></p>
          <% if @customer.pdi_customer_id.present? %>
            <p><strong>PDI Customer:</strong> <%= @customer.pdi_customer_id %></p>
            <div class="mb-3">
              <strong>PDI Credit:</strong>
              <turbo-frame id="pdi_credit" src="<%= pdi_credit_customer_path(@customer) %>" loading="lazy">
                <span class="text-muted small">Checking PDI…</span>
              </turbo-frame>
            </div>
          <% end %>

          <!-- Associated Locations Section -->
          <h4>Locations</h4>
          <% if @customer.locations.any? %>
            <ul class="list-group mb-4">
              <% @customer.locations.each do |location| %>
                <li class="list-group-item">
                  <%= link_to location.company_name, location_path(location) %>
                  <span class="text-muted float-end"><%= location.city %>, <%= location.state %></span>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-muted">No locations associated.</p>
          <% end %>

        </div>
      </div>

      <!-- Phone Numbers Table -->
      <div class="mt-5">
        <h4 class="text-center mb-3">Phone Numbers</h4>
        <% if @customer.phone_numbers.any? %>
          <div class="card shadow-sm">
            <div class="card-body">
              <table class="table table-bordered table-striped mt-3">
                <thead class="table-info">
                  <tr>
                    <th>Phone Number</th>
                    <th>Date Created</th>
                  </tr>
                </thead>
                <tbody>
                  <% @customer.phone_numbers.each do |phone_number| %>
                    <tr>
                      <td><%= phone_number.number %></td>
                      <td><%= phone_number.created_at.strftime("%B %d, %Y %I:%M %p") %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        <% else %>
          <p class="text-muted text-center">No phone numbers associated.</p>
        <% end %>
      </div>

      <!-- Locked Prices -->
      <% if sees?(:customer_pricing) %>
      <% locks = QuoteProduct.joins(:quote).merge(Quote.accepted_locks)
                             .where(quotes: { customer_id: @customer.id })
                             .where('quotes.expiry_date >= ?', Date.today)
                             .includes(:product, :quote)
                             .order('quotes.valid_from')
                             .select { |qp| %i[active scheduled].include?(qp.lock_status) } %>
      <div class="mt-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h4 class="mb-0">Locked Prices</h4>
          <div class="d-flex gap-2">
            <%= link_to 'All quotes', quotes_path(customer_id: @customer.id), class: 'btn btn-outline-secondary btn-sm' %>
            <%= link_to 'New Quote', new_quote_path(customer_id: @customer.id), class: 'btn btn-primary btn-sm' %>
          </div>
        </div>
        <% if locks.any? %>
          <div class="card shadow-sm">
            <table class="table table-sm align-middle mb-0">
              <thead class="table-light">
                <tr><th>Product</th><th class="text-end">Locked Price</th><th>Valid</th><th>Quote</th><th>Status</th></tr>
              </thead>
              <tbody>
                <% locks.each do |qp| %>
                  <tr>
                    <td><%= qp.product&.name || qp.product_name %></td>
                    <td class="text-end"><%= number_to_currency(qp.price, precision: 4) %></td>
                    <td class="small"><%= qp.quote.valid_from.strftime('%b %-d') %> – <%= qp.locked_through.strftime('%b %-d, %Y') %></td>
                    <td><%= link_to qp.quote.quote_number, quote_path(qp.quote) %></td>
                    <td><%= lock_status_badge(qp.lock_status) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p class="text-muted text-center">No locked prices. Orders are priced from the live pricing rules.</p>
        <% end %>
      </div>
      <% end %>

      <div class="mt-5">
        <h4 class="text-center mb-3">Customer Part Numbers</h4>
        <% numbers = @customer.customer_item_numbers.includes(:product).order(:product_id) %>
        <div class="card shadow-sm">
          <% if numbers.any? %>
            <table class="table table-sm align-middle mb-0">
              <thead class="table-light"><tr><th>Our item</th><th>Their part #</th><th>Their description</th><th></th></tr></thead>
              <tbody>
                <% numbers.each do |number| %>
                  <tr>
                    <td><%= number.product_id %> <span class="text-muted small"><%= number.product&.name %></span></td>
                    <td class="fw-semibold"><%= number.part_number %></td>
                    <td><%= number.description %></td>
                    <td class="text-end">
                      <% if can?(:sales, :edit) %>
                        <%= button_to 'Remove', customer_customer_item_number_path(@customer, number), method: :delete,
                                      class: 'btn btn-link btn-sm p-0 text-danger', form: { data: { turbo_confirm: 'Remove this part number?' } } %>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <p class="text-muted text-center my-3">No customer part numbers. They print beside ours on quotes and bills of lading.</p>
          <% end %>
          <% if can?(:sales, :edit) %>
            <div class="card-footer">
              <%= form_with url: customer_customer_item_numbers_path(@customer), method: :post, class: 'd-flex flex-wrap gap-2' do %>
                <%= text_field_tag :product_id, nil, required: true, placeholder: 'Our item # (e.g. 901)', class: 'form-control form-control-sm', style: 'width: 180px' %>
                <%= text_field_tag :part_number, nil, required: true, placeholder: 'Their part #', class: 'form-control form-control-sm', style: 'width: 160px' %>
                <%= text_field_tag :description, nil, placeholder: 'Their description (optional)', class: 'form-control form-control-sm', style: 'min-width: 220px' %>
                <%= submit_tag 'Add', class: 'btn btn-sm btn-outline-primary' %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Orders Table -->
      <div class="mt-5">
        <h4 class="text-center mb-3">Associated Orders</h4>
        <% if @customer.customer_orders.any? %>
          <div class="card shadow-sm">
            <div class="card-body">
              <table class="table table-bordered table-striped mt-3">
                <thead class="table-success">
                  <tr>
                    <th>Order ID</th>
                    <th>Order Date</th>
                    <th>Products</th>
                  </tr>
                </thead>
                <tbody>
                  <% @customer.customer_orders.each do |order| %>
                    <tr>
                      <td><%= link_to order.id, customer_order_path(order) %></td>
                      <td><%= order.created_at.strftime("%B %d, %Y") %></td>
                      <td>
                        <% if order.products.any? %>
                          <ul>
                            <% order.products.each do |product| %>
                              <li><%= product.name %> (Quantity: <%= order.customer_order_products.find_by(product_id: product.id).quantity %>)</li>
                            <% end %>
                          </ul>
                        <% else %>
                          <p>No products associated with this order.</p>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        <% else %>
          <p class="text-muted text-center">No orders associated with this customer.</p>
        <% end %>
      </div>

    </div>
  </div>
</div>

<div class="container-fluid">
  <%= render 'shared/history', record: @customer, children: { 'CustomerItemNumber' => 'customer_id' } %>
</div>
