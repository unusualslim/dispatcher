<%= javascript_include_tag 'application', 'data-turbo-track': 'reload' %>

<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <h1 class="text-center mb-4">Customer Details</h1>
      <p class="text-center text-muted">View and manage customer information and associated locations.</p>
      
      <!-- Customer Info Card -->
      <div class="card shadow-sm border-primary">
        <div class="card-header bg-primary text-white">
          <h2><%= @customer.name %><% unless @customer.active %> <span class="badge bg-secondary fs-6 align-middle">Inactive</span><% end %></h2>
        </div>
        <div class="card-body">
          <!-- Additional Customer Info -->
          <p><strong>Email:</strong> <%= @customer.email %></p>
          <p><strong>Preferred Contact Method:</strong> <%= @customer.preferred_contact_method %></p>
          <% if @customer.pdi_customer_id.present? %>
            <p><strong>PDI Customer:</strong> <%= @customer.pdi_customer_id %></p>
            <div class="mb-3">
              <strong>PDI Credit:</strong>
              <turbo-frame id="pdi_credit" src="<%= pdi_credit_customer_path(@customer) %>" loading="lazy">
                <span class="text-muted small">Checking PDI…</span>
              </turbo-frame>
            </div>
          <% end %>

          <!-- Associated Locations Section -->
          <h4>Locations</h4>
          <% if @customer.locations.any? %>
            <ul class="list-group mb-4">
              <% @customer.locations.each do |location| %>
                <li class="list-group-item">
                  <%= link_to location.company_name, location_path(location) %>
                  <span class="text-muted float-end"><%= location.city %>, <%= location.state %></span>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-muted">No locations associated.</p>
          <% end %>

          <!-- Action Buttons -->
          <div class="mt-3">
            <%= link_to 'Edit Customer', edit_customer_path(@customer), class: 'btn btn-warning', data: { turbo: false } %>
            <%= link_to 'Back to Customers', customers_path, class: 'btn btn-secondary' %>
            <%= form_with url: customer_path(@customer), method: :delete, class: "d-inline" do %>
  <%= submit_tag 'Delete Customer', class: 'btn btn-danger', data: { confirm: 'Are you sure?' } %>
<% end %>
          </div>
        </div>
      </div>

      <!-- Phone Numbers Table -->
      <div class="mt-5">
        <h4 class="text-center mb-3">Phone Numbers</h4>
        <% if @customer.phone_numbers.any? %>
          <div class="card shadow-sm">
            <div class="card-body">
              <table class="table table-bordered table-striped mt-3">
                <thead class="table-info">
                  <tr>
                    <th>Phone Number</th>
                    <th>Date Created</th>
                  </tr>
                </thead>
                <tbody>
                  <% @customer.phone_numbers.each do |phone_number| %>
                    <tr>
                      <td><%= phone_number.number %></td>
                      <td><%= phone_number.created_at.strftime("%B %d, %Y %I:%M %p") %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        <% else %>
          <p class="text-muted text-center">No phone numbers associated.</p>
        <% end %>
      </div>

      <!-- Locked Prices -->
      <% locks = QuoteProduct.joins(:quote).merge(Quote.accepted_locks)
                             .where(quotes: { customer_id: @customer.id })
                             .where('quotes.expiry_date >= ?', Date.today)
                             .includes(:product, :quote)
                             .order('quotes.valid_from')
                             .select { |qp| %i[active scheduled].include?(qp.lock_status) } %>
      <div class="mt-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h4 class="mb-0">Locked Prices</h4>
          <div class="d-flex gap-2">
            <%= link_to 'All quotes', quotes_path(customer_id: @customer.id), class: 'btn btn-outline-secondary btn-sm' %>
            <%= link_to 'New Quote', new_quote_path(customer_id: @customer.id), class: 'btn btn-primary btn-sm' %>
          </div>
        </div>
        <% if locks.any? %>
          <div class="card shadow-sm">
            <table class="table table-sm align-middle mb-0">
              <thead class="table-light">
                <tr><th>Product</th><th class="text-end">Locked Price</th><th>Valid</th><th>Quote</th><th>Status</th></tr>
              </thead>
              <tbody>
                <% locks.each do |qp| %>
                  <tr>
                    <td><%= qp.product&.name || qp.product_name %></td>
                    <td class="text-end"><%= number_to_currency(qp.price, precision: 4) %></td>
                    <td class="small"><%= qp.quote.valid_from.strftime('%b %-d') %> – <%= qp.locked_through.strftime('%b %-d, %Y') %></td>
                    <td><%= link_to qp.quote.quote_number, quote_path(qp.quote) %></td>
                    <td><%= lock_status_badge(qp.lock_status) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p class="text-muted text-center">No locked prices. Orders are priced from the live pricing rules.</p>
        <% end %>
      </div>

      <!-- Orders Table -->
      <div class="mt-5">
        <h4 class="text-center mb-3">Associated Orders</h4>
        <% if @customer.customer_orders.any? %>
          <div class="card shadow-sm">
            <div class="card-body">
              <table class="table table-bordered table-striped mt-3">
                <thead class="table-success">
                  <tr>
                    <th>Order ID</th>
                    <th>Order Date</th>
                    <th>Products</th>
                  </tr>
                </thead>
                <tbody>
                  <% @customer.customer_orders.each do |order| %>
                    <tr>
                      <td><%= link_to order.id, customer_order_path(order) %></td>
                      <td><%= order.created_at.strftime("%B %d, %Y") %></td>
                      <td>
                        <% if order.products.any? %>
                          <ul>
                            <% order.products.each do |product| %>
                              <li><%= product.name %> (Quantity: <%= order.customer_order_products.find_by(product_id: product.id).quantity %>)</li>
                            <% end %>
                          </ul>
                        <% else %>
                          <p>No products associated with this order.</p>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        <% else %>
          <p class="text-muted text-center">No orders associated with this customer.</p>
        <% end %>
      </div>

    </div>
  </div>
</div>
