<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Customers</h1>
  <div class="d-flex gap-2 align-items-center flex-wrap">
    <button type="button" class="btn btn-outline-secondary btn-sm d-none" id="export-selected-btn"
            data-export-url="<%= export_csv_customers_path %>">
      Export Selected (<span id="csv-selected-count">0</span>)
    </button>
    <%= link_to "Export All", export_csv_customers_path, class: "btn btn-outline-secondary btn-sm" %>
    <%= link_to "Import CSV", import_csv_customers_path, class: "btn btn-outline-primary btn-sm" %>
    <%= link_to "New Customer", new_customer_path, class: "btn btn-primary btn-sm" %>
  </div>
</div>

<div class="card shadow-sm mb-3">
  <div class="card-body py-2">
    <%= form_with(url: customers_path, method: :get, local: true, class: "d-flex gap-2") do %>
      <%= text_field_tag :search, params[:search], placeholder: "Search customers...", class: "form-control form-control-sm", style: "max-width:300px;" %>
      <%= submit_tag "Search", class: "btn btn-primary btn-sm" %>
      <% if params[:search].present? %>
        <%= link_to "Clear", customers_path, class: "btn btn-outline-secondary btn-sm" %>
      <% end %>
    <% end %>
  </div>
</div>

<table class="table table-hover table-bordered align-middle">
  <thead class="table-light">
    <tr>
      <th style="width:32px;"><input type="checkbox" class="form-check-input" id="bulk-select-all"></th>
      <th>Name</th>
      <th>Locations</th>
    </tr>
  </thead>
  <tbody>
    <% @customers.each do |customer| %>
      <tr>
        <td><input type="checkbox" class="form-check-input bulk-row-select" value="<%= customer.id %>"></td>
        <td><%= link_to customer.name, customer_path(customer), class: "text-decoration-none fw-semibold" %></td>
        <td class="text-muted small">
          <% if customer.locations.any? %>
            <%= customer.locations.map(&:company_name).join(', ') %>
          <% else %>
            <span class="fst-italic">No locations</span>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= render 'shared/bulk_select_js' %>
