<div style="max-width:560px;">

  <% if user.errors.any? %>
    <div class="alert alert-danger mb-4">
      <ul class="mb-0 ps-3">
        <% user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with(model: user, data: { turbo: false }) do |form| %>
    <div class="card shadow-sm">

      <%# ── User header ───────────────────────────────────────── %>
      <div class="card-body border-bottom d-flex align-items-center gap-3 py-3">
        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold flex-shrink-0"
             style="width:48px;height:48px;font-size:1.1rem;">
          <%= [user.first_name&.first, user.last_name&.first].compact.join.upcase.presence || "?" %>
        </div>
        <div>
          <div class="fw-semibold"><%= user.full_name.presence || "New User" %></div>
          <div class="text-muted small"><%= user.email %></div>
        </div>
      </div>

      <%# ── Account info ──────────────────────────────────────── %>
      <div class="card-body border-bottom">
        <h6 class="text-muted text-uppercase fw-semibold mb-3" style="font-size:.72rem;letter-spacing:.06em;">Account</h6>

        <div class="row g-3 mb-3">
          <div class="col-sm-6">
            <%= form.label :first_name, class: "form-label mb-1" %>
            <%= form.text_field :first_name, class: "form-control" %>
          </div>
          <div class="col-sm-6">
            <%= form.label :last_name, class: "form-label mb-1" %>
            <%= form.text_field :last_name, class: "form-control" %>
          </div>
        </div>

        <div class="mb-3">
          <%= form.label :email, class: "form-label mb-1" %>
          <%= form.email_field :email, class: "form-control" %>
        </div>

        <div class="row g-3">
          <div class="col-sm-6">
            <%= form.label :phone_number, class: "form-label mb-1" %>
            <%= form.text_field :phone_number, class: "form-control", placeholder: "e.g. 229-555-0100" %>
          </div>
          <div class="col-sm-6">
            <%= form.label :role, class: "form-label mb-1" %>
            <%= form.select :role, User::ROLES.invert, { include_blank: "— select —" }, class: "form-select", id: "user_role_select" %>
            <div class="form-text">Admin has full access. Staff get the area access below.</div>
          </div>
          <div class="col-sm-6">
            <%= form.label :employment_type, "Employment", class: "form-label mb-1" %>
            <%= form.select :employment_type, User::EMPLOYMENT_TYPES.invert, {}, class: "form-select" %>
            <div class="form-text">Sets which wage account /line labor posts to.</div>
          </div>
          <% if @user.persisted? && HomePage.choosable?(@user) %>
            <div class="col-sm-6">
              <%= form.label :home_page, "Home page", class: "form-label mb-1" %>
              <%= form.select :home_page, HomePage.choices(@user), { include_blank: "Default for their role" }, class: "form-select" %>
              <div class="form-text">Where they land after signing in. They can change it on My Account.</div>
            </div>
          <% end %>
        </div>
      </div>

      <%# ── Roles (staff) ─────────────────────────────────────── %>
      <div class="card-body border-bottom" id="area-access">
        <h6 class="text-muted text-uppercase fw-semibold mb-1" style="font-size:.72rem;letter-spacing:.06em;">Roles</h6>
        <p class="text-muted small mb-2">
          For <strong>Staff</strong> users. Their access adds up across every role they hold.
          Build and change roles on <%= link_to 'Roles', roles_path %>.
        </p>
        <%= hidden_field_tag 'user[role_ids][]', '' %>
        <div class="row g-1">
          <% Role.ordered.each do |role| %>
            <div class="col-md-6">
              <div class="form-check">
                <%= check_box_tag 'user[role_ids][]', role.id, user.role_ids.include?(role.id), id: "user_role_#{role.id}", class: 'form-check-input' %>
                <label class="form-check-label" for="user_role_<%= role.id %>">
                  <%= role.name %> <span class="text-muted small"><%= role.area_summary %></span>
                </label>
              </div>
            </div>
          <% end %>
        </div>
        <% if Role.none? %><p class="text-muted small mb-0">No roles yet: <%= link_to 'create one', new_role_path %>.</p><% end %>
      </div>

      <%# ── Hidden data (anyone, admins too) ─────────────────── %>
      <div class="card-body border-bottom">
        <h6 class="text-muted text-uppercase fw-semibold mb-1" style="font-size:.72rem;letter-spacing:.06em;">Hidden from this user</h6>
        <p class="text-muted small mb-2">Wins over roles and over Admin: ticked data stays hidden from this person.</p>
        <%= hidden_field_tag 'user[hidden_flags][]', '' %>
        <% User::DATA_FLAGS.each do |key, flag| %>
          <div class="form-check form-check-inline">
            <%= check_box_tag 'user[hidden_flags][]', key, user.hidden_flags.include?(key), id: "user_hidden_#{key}", class: 'form-check-input' %>
            <label class="form-check-label" for="user_hidden_<%= key %>"><%= flag[:label] %></label>
          </div>
        <% end %>
      </div>

      <% if user.persisted? && (user.admin? || user.staff?) %>
        <%= render 'users/access_summary', user: user %>
      <% end %>

      <%# ── Password reset ────────────────────────────────────── %>
      <div class="card-body border-bottom">
        <h6 class="text-muted text-uppercase fw-semibold mb-1" style="font-size:.72rem;letter-spacing:.06em;">Set New Password</h6>
        <p class="text-muted small mb-3">Leave blank to keep the current password.</p>

        <div class="row g-3">
          <div class="col-sm-6">
            <%= form.label :password, class: "form-label mb-1" %>
            <%= form.password_field :password, class: "form-control", autocomplete: "new-password", placeholder: "New password" %>
          </div>
          <div class="col-sm-6">
            <%= form.label :password_confirmation, "Confirm", class: "form-label mb-1" %>
            <%= form.password_field :password_confirmation, class: "form-control", autocomplete: "new-password", placeholder: "Confirm password" %>
          </div>
        </div>
      </div>

      <%# ── Notifications ─────────────────────────────────────── %>
      <div class="card-body border-bottom">
        <h6 class="text-muted text-uppercase fw-semibold mb-3" style="font-size:.72rem;letter-spacing:.06em;">Notifications</h6>

        <div class="form-check form-switch mb-2">
          <%= form.check_box :email_opt_in, class: "form-check-input", role: "switch", id: "email_opt_in_toggle" %>
          <%= form.label :email_opt_in, "Email notifications", class: "form-check-label", for: "email_opt_in_toggle" %>
        </div>
        <div class="form-check form-switch">
          <%= form.check_box :sms_opt_in, class: "form-check-input", role: "switch", id: "sms_opt_in_toggle" %>
          <%= form.label :sms_opt_in, "SMS notifications", class: "form-check-label", for: "sms_opt_in_toggle" %>
        </div>
      </div>

      <%# ── Actions ───────────────────────────────────────────── %>
      <div class="card-body d-flex gap-2">
        <%= form.submit "Save Changes", class: "btn btn-primary" %>
        <%= link_to "Cancel", users_path, class: "btn btn-outline-secondary" %>
      </div>

    </div>
  <% end %>

</div>
