<div class="container-fluid px-4 py-4">

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-semibold mb-0">Users</h4>
    <div class="d-flex gap-2 align-items-center">
      <%# Quick-add line worker (no login needed) %>
      <%= form_with url: create_line_worker_users_path, method: :post, class: "d-flex gap-2 align-items-center" do |f| %>
        <%= f.text_field :first_name, placeholder: "First name", class: "form-control form-control-sm", style: "width:120px", required: true %>
        <%= f.text_field :last_name,  placeholder: "Last name",  class: "form-control form-control-sm", style: "width:120px", required: true %>
        <%= f.select :employment_type, User::EMPLOYMENT_TYPES.invert, {}, class: "form-select form-select-sm", style: "width:auto" %>
        <%= f.submit "Add Line Worker", class: "btn btn-outline-secondary btn-sm text-nowrap" %>
      <% end %>
      <%= link_to new_user_registration_path, class: "btn btn-primary btn-sm text-nowrap" do %>
        <i class="bi bi-person-plus"></i> Add User
      <% end %>
    </div>
  </div>

  <%# ── User sections ──────────────────────────────────────────────────────────── %>
  <% active_users = @users.select(&:active?) %>
  <% admins       = active_users.select { |u| u.role == 'admin' } %>
  <% staff        = active_users.select { |u| u.role == 'staff' } %>
  <% drivers      = active_users.select { |u| u.role == 'worker' } %>
  <% line_workers = active_users.select { |u| u.role == 'line_worker' } %>
  <% inactive     = @users.reject(&:active?) %>

  <% sections = [["Admins", admins], ["Staff", staff], ["Drivers", drivers], ["Line Workers", line_workers]] %>
  <% sections << ["Inactive", inactive] if inactive.any? %>
  <% sections.each do |section_title, group| %>
    <div class="mb-4">
      <h6 class="text-muted text-uppercase fw-semibold mb-2" style="font-size:.75rem; letter-spacing:.05em;">
        <%= section_title %> (<%= group.size %>)
      </h6>
      <div class="card shadow-sm">
        <% if group.empty? %>
          <div class="card-body text-muted fst-italic">None.</div>
        <% else %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>Name</th>
                  <th>Email</th>
                  <th>Phone</th>
                  <th>Role</th>
                  <th>Notifications</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% group.each do |user| %>
                  <tr style="cursor:pointer;" onclick="window.location='<%= user_path(user) %>'">
                    <td>
                      <div class="fw-semibold">
                        <%= user.full_name.presence || "—" %>
                        <% if user.staff? %>
                          <div class="fw-normal small">
                            <% user.permissions.each do |area, level| %>
                              <span class="badge bg-light text-dark border"><%= User::AREAS[area] %>: <%= level.capitalize %></span>
                            <% end %>
                            <% if user.permissions.empty? %><span class="text-muted">No area access yet</span><% end %>
                          </div>
                        <% end %>
                        <% if user.employment_type == 'temp' %><span class="badge bg-info-subtle text-info-emphasis border ms-1">Temp</span><% end %>
                      </div>
                    </td>
                    <td><%= user.email.end_with?("@nologin.internal") ? content_tag(:span, "N/A", class: "text-muted") : user.email %></td>
                    <td><%= user.phone_number.presence || "—" %></td>
                    <td onclick="event.stopPropagation()">
                      <%= form_with model: user, url: user_path(user), method: :patch, data: { turbo: false } do |f| %>
                        <%= f.select :role,
                              User::ROLES.invert,
                              { selected: user.role },
                              class: "form-select form-select-sm",
                              style: "min-width:100px",
                              onchange: "this.form.requestSubmit()" %>
                      <% end %>
                    </td>
                    <td>
                      <% if user.email_opt_in? %>
                        <span class="badge bg-light text-dark border me-1"><i class="bi bi-envelope"></i> Email</span>
                      <% end %>
                      <% if user.sms_opt_in? %>
                        <span class="badge bg-light text-dark border"><i class="bi bi-phone"></i> SMS</span>
                      <% end %>
                      <% unless user.email_opt_in? || user.sms_opt_in? %>
                        <span class="text-muted small">None</span>
                      <% end %>
                    </td>
                    <td class="text-end" onclick="event.stopPropagation()">
                      <%= link_to edit_user_path(user), class: "btn btn-sm btn-outline-secondary me-1" do %>
                        <i class="bi bi-pencil"></i>
                      <% end %>
                      <% if user.active? %>
                        <% unless user == current_user %>
                          <%= button_to deactivate_user_path(user), method: :patch, class: "btn btn-sm btn-outline-warning me-1",
                                                                    form: { class: "d-inline", data: { turbo_confirm: "Deactivate #{user.full_name}? They won't be able to sign in." } },
                                                                    title: "Deactivate" do %>
                            <i class="bi bi-person-slash"></i>
                          <% end %>
                        <% end %>
                      <% else %>
                        <%= button_to reactivate_user_path(user), method: :patch, class: "btn btn-sm btn-outline-success me-1",
                                                                  form: { class: "d-inline" }, title: "Reactivate" do %>
                          <i class="bi bi-person-check"></i>
                        <% end %>
                      <% end %>
                      <%= form_with url: user_path(user), method: :delete, class: "d-inline" do %>
                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete"
                                data-confirm="Delete <%= user.full_name %>?">
                          <i class="bi bi-trash"></i>
                        </button>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

</div>
