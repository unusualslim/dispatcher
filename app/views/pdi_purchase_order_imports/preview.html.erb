<div class="container-fluid px-4 mt-4">
  <div class="d-flex justify-content-between align-items-start mb-3">
    <div>
      <h1 class="mb-1">Preview PDI Purchase Order Import</h1>
      <p class="text-muted mb-0">
        <% if @create_count > 0 %>
          <span class="text-success fw-semibold"><%= @create_count %> purchase orders to create</span>
        <% end %>
        <% if @skip_exists_count > 0 %>
          &nbsp;&middot;&nbsp;<span class="text-muted"><%= @skip_exists_count %> already imported</span>
        <% end %>
      </p>
    </div>
    <%= link_to "Cancel", new_pdi_purchase_order_import_path, class: "btn btn-outline-secondary" %>
  </div>

  <%= form_with url: pdi_purchase_order_import_path, method: :post, data: { turbo: false } do |f| %>

    <% creates = @rows.select { |r| r.action == :create } %>
    <% if creates.any? %>
      <div class="card shadow-sm mb-3">
        <div class="card-header bg-success text-white">
          <h6 class="mb-0">Purchase Orders to Create (<%= creates.size %>)</h6>
        </div>
        <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
          <table class="table table-sm table-hover mb-0">
            <thead class="table-light" style="position: sticky; top: 0;">
              <tr>
                <th>PO #</th>
                <th>Vendor</th>
                <th>Status</th>
                <th>Order Date</th>
                <th>Delivery Date</th>
                <th class="text-center">Lines</th>
                <th class="text-end">Total</th>
              </tr>
            </thead>
            <tbody>
              <% creates.each do |row| %>
                <tr>
                  <td class="font-monospace small"><%= row.po_no || row.po_key %></td>
                  <td><%= row.vendor_name %></td>
                  <td>
                    <% case row.status %>
                    <% when 'Inventoried' %>
                      <span class="badge bg-success">Inventoried</span>
                    <% when 'Invoiced' %>
                      <span class="badge bg-info">Invoiced</span>
                    <% when 'Ordered' %>
                      <span class="badge bg-primary">Ordered</span>
                    <% when 'Entered' %>
                      <span class="badge bg-secondary">Entered</span>
                    <% else %>
                      <span class="badge bg-light text-dark"><%= row.status || '—' %></span>
                    <% end %>
                  </td>
                  <td class="text-nowrap"><%= row.order_date&.strftime('%b %-d, %Y') || '—' %></td>
                  <td class="text-nowrap"><%= row.delivery_date&.strftime('%b %-d, %Y') || '—' %></td>
                  <td class="text-center"><%= row.line_count %></td>
                  <td class="text-end"><%= row.total_cost ? number_to_currency(row.total_cost) : '—' %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>

    <% if @skip_exists_count > 0 %>
      <div class="alert alert-secondary">
        <i class="bi bi-check-circle"></i> <strong><%= @skip_exists_count %> purchase orders</strong> already imported — will be skipped.
      </div>
    <% end %>

    <div class="d-flex gap-2 mt-3 mb-5">
      <%= f.submit "Confirm Import", class: "btn btn-success btn-lg" %>
      <%= link_to "Cancel", new_pdi_purchase_order_import_path, class: "btn btn-outline-secondary btn-lg" %>
    </div>
  <% end %>
</div>
