<div class="container mt-4" style="max-width: 640px;">
  <h1>Import Purchase Orders from PDI</h1>
  <p class="text-muted">Import historical purchase orders with line items, vendors, costs, and status from PDI.</p>

  <div class="alert alert-info">
    <strong><%= @po_count %> purchase orders</strong> in the system
    <% if @pdi_count > 0 %>
      (<%= @pdi_count %> from previous PDI imports).
    <% end %>
  </div>

  <%= form_with url: preview_pdi_purchase_order_import_path, method: :post, multipart: true, data: { turbo: false } do |f| %>
    <div class="card shadow-sm">
      <div class="card-body">
        <div class="mb-3">
          <%= f.label :file, "PDI Purchase Orders Export (.csv)", class: "form-label fw-semibold" %>
          <%= f.file_field :file, class: "form-control", accept: ".csv" %>
          <div class="form-text">Export from PDI SQL Server using the Warehouse Purchases query.</div>
        </div>
        <%= f.submit "Preview Import", class: "btn btn-primary" %>
      </div>
    </div>
  <% end %>

  <div class="card shadow-sm mt-3">
    <div class="card-header fw-semibold">What this does</div>
    <div class="card-body small text-muted">
      <ul class="mb-0">
        <li>Creates purchase orders with line items, vendor, location, costs, and freight</li>
        <li>PDI status mapping: Entered → Draft, Ordered → Submitted, Invoiced/Inventoried → Received</li>
        <li>Creates missing vendors automatically from the PDI data</li>
        <li>Updates POs already imported that aren't in inventory yet (matched on PDI's PO key)</li>
        <li>POs received on or after the inventory start date at one of our warehouses go into inventory at their line costs;
            older and dropship POs are only marked posted</li>
        <li>Safe to run multiple times</li>
      </ul>
    </div>
  </div>

  <%= link_to "← Back", purchase_orders_path, class: "btn btn-outline-secondary mt-3" %>

  <%= render 'shared/import_history', logs: @logs, download_path: :download_pdi_purchase_order_import_path %>
</div>
