<div class="container-fluid px-4 py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Quality Exceptions</h1>
  </div>
  <p class="text-muted" style="max-width: 820px;">
    Quality check results outside the product's target range. The order could still be completed; record what was done
    about each one here.
  </p>

  <ul class="nav nav-pills mb-3 small">
    <li class="nav-item"><%= link_to "Needs review (#{@unreviewed_count})", quality_exceptions_path, class: "nav-link #{'active' unless @show_reviewed}" %></li>
    <li class="nav-item"><%= link_to 'Reviewed', quality_exceptions_path(reviewed: 1), class: "nav-link #{'active' if @show_reviewed}" %></li>
  </ul>

  <div class="card shadow-sm">
    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead class="table-light">
          <tr><th>Order</th><th>Product</th><th>Check</th><th>Result</th><th>Target</th><th>Tested</th><th style="min-width: 320px;"><%= @show_reviewed ? 'Resolution' : 'Review' %></th></tr>
        </thead>
        <tbody>
          <% if @results.empty? %>
            <tr><td colspan="7" class="text-center text-muted py-4"><%= @show_reviewed ? 'Nothing reviewed yet.' : 'No exceptions waiting for review.' %></td></tr>
          <% end %>
          <% @results.each do |result| %>
            <% order = result.production_order %>
            <tr>
              <td><%= link_to order.number, production_order_path(order, anchor: 'quality-check') %><div class="small text-muted"><%= order.lot_number %></div></td>
              <td><%= order.product&.name || order.item %></td>
              <td><%= result.name %><% if result.test_method.present? %><div class="small text-muted"><%= result.test_method %></div><% end %></td>
              <td class="fw-semibold text-danger"><%= result.display_value %></td>
              <td class="text-muted small"><%= result.target_label %></td>
              <td class="small"><%= result.tested_at.strftime('%m/%d/%Y') %><div class="text-muted"><%= result.tested_by&.full_name %></div><% if result.notes.present? %><div class="text-muted fst-italic"><%= result.notes %></div><% end %></td>
              <td>
                <% if result.reviewed? %>
                  <div><%= result.resolution %></div>
                  <div class="small text-muted"><%= result.reviewed_by&.full_name %> · <%= result.reviewed_at.strftime('%m/%d/%Y') %></div>
                <% elsif can?(:production, :approve) %>
                  <%= form_with url: review_quality_exception_path(result), method: :patch, local: true, class: 'd-flex gap-2' do %>
                    <%= text_field_tag :resolution, nil, class: 'form-control form-control-sm', placeholder: 'What was done (required)', required: true %>
                    <%= submit_tag 'Reviewed', class: 'btn btn-sm btn-outline-primary' %>
                  <% end %>
                <% else %>
                  <span class="text-muted small">Waiting for review</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
