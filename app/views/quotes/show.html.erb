<div class="container-fluid px-4 py-3" style="max-width: 1000px;">

  <!-- Header -->
  <div class="d-flex justify-content-between align-items-start mb-3">
    <div>
      <h4 class="mb-0"><%= @quote.quote_number %></h4>
      <span class="badge <%= status_badge_class(@quote.status) %> mt-1"><%= @quote.status.capitalize %></span>
      <span class="d-print-none"><%= lock_status_badge(@quote.lock_status) %></span>
    </div>
    <div class="d-flex gap-2 d-print-none">
      <% if @quote.editable? %>
        <%= link_to edit_quote_path(@quote), class: "btn btn-outline-secondary btn-sm" do %>
          <i class="bi bi-pencil"></i> Edit
        <% end %>
        <%= button_to send_quote_quote_path(@quote), method: :post, class: "btn btn-primary btn-sm",
              data: { confirm: "Send quote to #{@quote.customer.email}?" } do %>
          <i class="bi bi-envelope"></i> Send
        <% end %>
        <%= button_to accept_quote_path(@quote), method: :post, class: "btn btn-success btn-sm",
              data: { confirm: @quote.locks_pricing? ?
                "Accept this quote and lock its prices for #{@quote.customer.name} from #{@quote.valid_from&.strftime('%b %-d')} through #{@quote.expiry_date&.strftime('%b %-d, %Y')}? Any earlier locked price on these products ends the day before." :
                "Mark this quote as accepted?" } do %>
          <i class="bi bi-check-lg"></i> Accept
        <% end %>
        <%= button_to reject_quote_path(@quote), method: :post, class: "btn btn-outline-danger btn-sm",
              data: { confirm: "Mark this quote as rejected?" } do %>
          <i class="bi bi-x-lg"></i> Reject
        <% end %>
      <% end %>
      <% if @quote.orderable? %>
        <%= link_to new_customer_order_path(from_quote: @quote.id), class: "btn btn-success btn-sm" do %>
          <i class="bi bi-cart-plus"></i> Create Order
        <% end %>
      <% end %>
      <% if @quote.locks_pricing? && @quote.accepted? %>
        <%= link_to margin_review_quote_path(@quote), class: "btn btn-outline-primary btn-sm" do %>
          <i class="bi bi-graph-down-arrow"></i> Margin Review
        <% end %>
      <% end %>
      <% if @quote.lock_endable? %>
        <button type="button" class="btn btn-outline-dark btn-sm" data-bs-toggle="modal" data-bs-target="#endLockModal">
          <i class="bi bi-unlock"></i> <%= @quote.lock_ended_on ? 'Change Lock End' : 'End Lock Early' %>
        </button>
      <% end %>
      <button onclick="window.print()" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-printer"></i>
      </button>
      <% if @quote.draft? %>
        <%= button_to quote_path(@quote), method: :delete, class: "btn btn-outline-danger btn-sm",
              data: { confirm: "Delete this quote?" } do %>
          <i class="bi bi-trash"></i>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Details -->
  <div class="row g-3 mb-4">
    <div class="col-md-6">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <div class="mb-2">
            <div class="text-muted small">Customer</div>
            <div class="fw-semibold"><%= @quote.customer.name %></div>
            <% if @quote.customer.email.present? %>
              <div class="text-muted small"><%= @quote.customer.email %></div>
            <% end %>
          </div>
          <% if @quote.location %>
            <div>
              <div class="text-muted small">Delivery Location</div>
              <div><%= @quote.location.company_name %></div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <div class="mb-2">
            <div class="text-muted small">Quote Date</div>
            <div><%= @quote.created_at.strftime("%B %-d, %Y") %></div>
          </div>
          <% if @quote.valid_from || @quote.expiry_date %>
            <div class="mb-2">
              <div class="text-muted small"><%= @quote.locks_pricing? ? 'Prices Valid' : 'Valid Until' %></div>
              <div>
                <% if @quote.valid_from %><%= @quote.valid_from.strftime("%B %-d, %Y") %> – <% end %>
                <%= @quote.expiry_date&.strftime("%B %-d, %Y") || 'further notice' %>
              </div>
            </div>
          <% end %>
          <% if @quote.sent_at %>
            <div class="mb-2">
              <div class="text-muted small">Sent</div>
              <div><%= @quote.sent_at.strftime("%B %-d, %Y at %l:%M %p") %></div>
            </div>
          <% end %>
          <% if @quote.accepted_at %>
            <div class="mb-2 d-print-none">
              <div class="text-muted small">Accepted</div>
              <div><%= @quote.accepted_at.strftime("%B %-d, %Y") %><% if (by = @quote.accepted_by) %> by <%= [by.first_name, by.last_name].compact.join(' ').presence || by.email %><% end %></div>
            </div>
          <% end %>
          <% if @quote.customer_order %>
            <div class="d-print-none">
              <div class="text-muted small">Linked Order</div>
              <div><%= link_to @quote.customer_order_id, customer_order_path(@quote.customer_order) %></div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <% if @quote.lock_ended_on %>
    <% ended = @quote.lock_ended_on <= Date.today %>
    <div class="alert <%= ended ? 'alert-dark' : 'alert-warning' %> small d-print-none">
      <i class="bi bi-unlock me-1"></i>
      <strong><%= ended ? 'Price lock ended early' : 'Price lock ends early' %></strong>
      on <%= @quote.lock_ended_on.strftime('%B %-d, %Y') %>
      (the quote was valid through <%= @quote.expiry_date.strftime('%B %-d, %Y') %>).
      <%= ended ? 'Orders for this customer use' : 'From that day, orders for this customer use' %> the live pricing rules.
      <div class="text-muted mt-1">
        Ended by <% by = @quote.lock_ended_by %><%= by ? ([by.first_name, by.last_name].compact.join(' ').presence || by.email) : 'unknown' %>
        on <%= @quote.lock_ended_at&.strftime('%b %-d, %Y') %><% if @quote.lock_end_reason.present? %> — <%= @quote.lock_end_reason %><% end %>
      </div>
    </div>
  <% end %>

  <% if !@quote.locks_pricing? %>
    <div class="alert alert-light border small d-print-none">
      This quote doesn't lock prices<%= ' (created before price locking existed)' if @quote.valid_from.nil? %>.
      Orders for this customer are priced from the live pricing rules.
    </div>
  <% end %>

  <!-- Line Items -->
  <div class="card shadow-sm mb-4">
    <div class="table-responsive">
      <table class="table table-sm align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Product</th>
            <th class="text-end" style="width:90px;">Qty</th>
            <th class="text-end" style="width:120px;">Unit Price</th>
            <th class="text-end" style="width:120px;">Total</th>
            <th class="d-print-none">How it was priced</th>
            <% if @quote.locks_pricing? && @quote.accepted? %>
              <th class="d-print-none">Lock</th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% @quote.quote_products.each do |qp| %>
            <tr>
              <td>
                <% if qp.product %>
                  <%= link_to qp.product.name, product_path(qp.product), class: 'text-decoration-none text-reset' %>
                <% else %>
                  <%= qp.product_name %>
                <% end %>
              </td>
              <td class="text-end"><%= number_with_precision(qp.quantity, precision: 3, strip_insignificant_zeros: true) %></td>
              <td class="text-end"><%= number_to_currency(qp.price, precision: 4) %></td>
              <td class="text-end"><%= number_to_currency(qp.line_total) %></td>
              <td class="small text-muted d-print-none">
                <% if qp.pricing_basis %>
                  <%= qp.pricing_rule ? link_to(qp.pricing_rule.name, edit_pricing_rule_path(qp.pricing_rule)) : 'Deleted rule' %>:
                  <%= { 'standard_cost' => 'Standard Cost', 'inventory_cost' => 'Inventory Cost', 'standard_calculated' => 'BOM Std Cost' }[qp.pricing_basis] %>
                  <%= qp.basis_cost ? number_to_currency(qp.basis_cost, precision: 4) : '—' %>
                  <% if qp.pricing_method == 'flat' %>
                    · Flat <%= number_to_currency(qp.rule_value, precision: 4) %>
                  <% else %>
                    · <%= qp.pricing_method&.capitalize %> <%= number_with_precision(qp.rule_value, precision: 2, strip_insignificant_zeros: true) %>%
                  <% end %>
                  <% if qp.price_overridden? %>
                    <div class="text-warning-emphasis">Price overridden by hand</div>
                  <% end %>
                <% else %>
                  Manual price
                <% end %>
              </td>
              <% if @quote.locks_pricing? && @quote.accepted? %>
                <td class="small d-print-none">
                  <% status = qp.lock_status %>
                  <% if status == :active %>
                    <span class="text-success">Active through <%= qp.locked_through.strftime('%b %-d, %Y') %></span>
                    <% if qp.superseded_on && (@quote.lock_ended_on.nil? || qp.superseded_on < @quote.lock_ended_on) %>
                      <div class="text-warning-emphasis">Newer quote takes over <%= qp.superseded_on.strftime('%b %-d, %Y') %></div>
                    <% elsif @quote.lock_ended_on %>
                      <div class="text-warning-emphasis">Lock ends early</div>
                    <% end %>
                  <% elsif status == :scheduled %>
                    <span class="text-info-emphasis">Starts <%= @quote.valid_from.strftime('%b %-d') %></span>
                  <% elsif status == :superseded %>
                    <span class="text-warning-emphasis">Replaced from <%= qp.superseded_on.strftime('%b %-d, %Y') %></span>
                  <% elsif status == :expired %>
                    <span class="text-muted">Expired</span>
                  <% elsif status == :ended %>
                    <span class="text-muted">Ended <%= @quote.lock_ended_on.strftime('%b %-d, %Y') %></span>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr class="fw-bold">
            <td colspan="3" class="text-end">Total</td>
            <td class="text-end"><%= number_to_currency(@quote.total) %></td>
            <td class="d-print-none" colspan="<%= @quote.locks_pricing? && @quote.accepted? ? 2 : 1 %>"></td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>

  <% if @quote.notes.present? %>
    <div class="card shadow-sm mb-4">
      <div class="card-body">
        <div class="text-muted small mb-1">Notes</div>
        <div><%= @quote.notes %></div>
      </div>
    </div>
  <% end %>

  <% priced_lines = CustomerOrderProduct.where(quote_product_id: @quote.quote_products.map(&:id)).includes(:customer_order, :product) %>
  <% if priced_lines.any? %>
    <div class="card shadow-sm mb-4 d-print-none">
      <div class="card-header fw-semibold">Orders priced from this quote</div>
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
          <thead class="table-light">
            <tr><th>Order</th><th>Product</th><th class="text-end">Qty</th><th class="text-end">Price</th><th>Status</th></tr>
          </thead>
          <tbody>
            <% priced_lines.sort_by { |l| -l.customer_order_id }.each do |line| %>
              <tr>
                <td><%= link_to "##{line.customer_order_id}", customer_order_path(line.customer_order) %></td>
                <td><%= line.product&.name || line.product_name %></td>
                <td class="text-end"><%= line.quantity %></td>
                <td class="text-end"><%= number_to_currency(line.price, precision: 4) %></td>
                <td class="small text-muted"><%= line.customer_order.order_status_before_type_cast %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <%= link_to "← All Quotes", quotes_path, class: "text-muted small d-print-none" %>
</div>

<% if @quote.lock_endable? %>
  <div class="modal fade d-print-none" id="endLockModal" tabindex="-1" aria-labelledby="endLockModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <%= form_with url: end_lock_quote_path(@quote), method: :patch, local: true, class: 'modal-content' do %>
        <div class="modal-header">
          <h5 class="modal-title" id="endLockModalLabel">End price lock early</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p class="small text-muted">
            From the date below, new orders for <strong><%= @quote.customer.name %></strong> are priced from the live
            pricing rules instead of this quote. Orders already priced keep their prices. The quote itself still shows
            the dates it was quoted for.
          </p>
          <div class="mb-3">
            <label class="form-label fw-semibold" for="lock_ended_on">End lock on</label>
            <input type="date" class="form-control" id="lock_ended_on" name="lock_ended_on" required
                   value="<%= (@quote.lock_ended_on || Date.today).iso8601 %>"
                   min="<%= Date.today.iso8601 %>" max="<%= @quote.expiry_date.iso8601 %>">
            <div class="form-text">The first day orders use the live rules. Choose today to end it now.</div>
          </div>
          <div>
            <label class="form-label fw-semibold" for="lock_end_reason">Reason</label>
            <textarea class="form-control" id="lock_end_reason" name="lock_end_reason" rows="2"
                      placeholder="e.g. Customer agreed to re-price after supplier increase"><%= @quote.lock_end_reason %></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-dark">End Lock</button>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<style>
  @media print {
    #sidebar, .sidebar, nav, .sidebar-overlay, .d-print-none { display: none !important; }
    .main-content { margin-left: 0 !important; }
  }
</style>
