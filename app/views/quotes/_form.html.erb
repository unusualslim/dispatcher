<%= form_with model: quote, local: true, data: { turbo: false }, id: 'quote-form' do |f| %>
  <% if quote.errors.any? %>
    <div class="alert alert-danger">
      <% quote.errors.full_messages.each do |msg| %>
        <div><%= msg %></div>
      <% end %>
    </div>
  <% end %>

  <div class="row g-3 mb-4">
    <div class="col-md-6">
      <label class="form-label fw-semibold">Customer</label>
      <%= f.collection_select :customer_id, Customer.selectable(f.object.customer_id).order(:name), :id, :name,
            { include_blank: "— Select customer —", selected: quote.customer_id },
            class: "form-select select2-customer", id: 'quote-customer' %>
    </div>
    <div class="col-md-6">
      <label class="form-label fw-semibold">Delivery Location <span class="text-muted fw-normal">(optional)</span></label>
      <%= f.collection_select :location_id, Location.where(location_category_id: 2).order(:company_name), :id, :company_name,
            { include_blank: "— Select location —", selected: quote.location_id },
            class: "form-select select2-location" %>
    </div>
  </div>

  <%# ── Price lock period ─────────────────────────────────────────────────── %>
  <div class="card mb-4">
    <div class="card-header fw-semibold">Price Lock Period</div>
    <div class="card-body">
      <div class="form-check mb-3">
        <%= f.check_box :locks_pricing, class: 'form-check-input', id: 'locks-pricing' %>
        <label class="form-check-label" for="locks-pricing">
          Lock these prices for the customer when the quote is accepted
        </label>
        <div class="form-text">
          While locked, orders for this customer use the quoted price instead of the live pricing rules.
          A later accepted quote for the same product replaces this one from its start date.
        </div>
      </div>
      <div class="row g-3 align-items-end">
        <div class="col-md-3">
          <label class="form-label fw-semibold" for="quote-valid-from">Valid From</label>
          <%= f.date_field :valid_from, class: "form-control", id: 'quote-valid-from' %>
        </div>
        <div class="col-md-3">
          <label class="form-label fw-semibold" for="quote-valid-until">Valid Until</label>
          <%= f.date_field :expiry_date, class: "form-control", id: 'quote-valid-until' %>
        </div>
        <div class="col-md-6">
          <div class="d-flex flex-wrap gap-1">
            <% Quote::DURATION_PRESETS.each_key do |label| %>
              <button type="button" class="btn btn-outline-secondary btn-sm duration-preset" data-preset="<%= label %>"><%= label %></button>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="mb-4">
    <label class="form-label fw-semibold">Notes</label>
    <%= f.text_area :notes, rows: 3, class: "form-control", placeholder: "Any special terms or notes..." %>
  </div>

  <%# ── Line items ────────────────────────────────────────────────────────── %>
  <div class="card mb-3">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
      <span class="fw-semibold">Products</span>
      <div class="d-flex flex-wrap align-items-center gap-2">
        <select id="add-from-rule" class="form-select form-select-sm" style="width:auto;">
          <option value="">Add products from pricing rule…</option>
          <% @pricing_rules.each do |rule| %>
            <option value="<%= rule.id %>"><%= rule.name %><%= " (#{rule.customer.name})" if rule.customer %></option>
          <% end %>
        </select>
        <button type="button" class="btn btn-outline-secondary btn-sm" id="reprice-all"
                title="Re-price every line from the current pricing rules (discards overrides)">
          <i class="bi bi-arrow-clockwise"></i> Refresh prices
        </button>
      </div>
    </div>
    <div id="customer-needed" class="alert alert-info small m-3 mb-0" style="display:none;">
      Select a customer to price lines from the pricing rules.
    </div>
    <div class="card-body p-0">
      <table class="table table-sm align-middle mb-0" id="quote-products-table">
        <thead class="table-light">
          <tr>
            <th>Product</th>
            <th style="width:110px;">Qty</th>
            <th style="width:230px;">Unit Price</th>
            <th style="width:110px;">Total</th>
            <th style="width:40px;"></th>
          </tr>
        </thead>
        <tbody id="quote-products-body">
          <%= f.fields_for :quote_products do |pf| %>
            <%= render 'quote_product_row', pf: pf, products: @products %>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="card-footer d-flex justify-content-between align-items-center">
      <%= link_to "Add Product", "#", class: "btn btn-outline-secondary btn-sm", id: "add-product-row" %>
      <div class="fw-bold">Total: <span id="quote-grand-total">$0.00</span></div>
    </div>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit quote.new_record? ? "Create Quote" : "Save Changes", class: "btn btn-primary" %>
    <%= link_to "Cancel", quote.new_record? ? quotes_path : quote_path(quote), class: "btn btn-outline-secondary" %>
  </div>

  <%# New-row template, rendered from the same partial as existing rows. %>
  <template id="quote-product-template">
    <%= f.fields_for :quote_products, QuoteProduct.new, child_index: 'NEW_INDEX' do |pf| %>
      <%= render 'quote_product_row', pf: pf, products: @products %>
    <% end %>
  </template>
<% end %>

<script>
(function() {
  var RULE_PRODUCTS = <%= raw @pricing_rules.to_h { |r| [r.id, r.pricing_rule_products.map(&:product_id)] }.to_json %>;
  var body          = document.getElementById('quote-products-body');
  var customerField = document.getElementById('quote-customer');
  var validFrom     = document.getElementById('quote-valid-from');
  var validUntil    = document.getElementById('quote-valid-until');

  function visibleRows() {
    return Array.from(body.querySelectorAll('tr.quote-line')).filter(function(r) { return r.style.display !== 'none'; });
  }

  function money(n, d) { return '$' + n.toFixed(d === undefined ? 2 : d); }

  // ── Totals ──────────────────────────────────────────────────────────────
  function updateRowTotal(row) {
    var qty   = parseFloat(row.querySelector('.qty-field').value) || 0;
    var price = parseFloat(row.querySelector('.price-field').value) || 0;
    row.querySelector('.row-total').textContent = money(qty * price);
  }

  function updateGrandTotal() {
    var grand = 0;
    visibleRows().forEach(function(row) {
      grand += (parseFloat(row.querySelector('.qty-field').value) || 0) *
               (parseFloat(row.querySelector('.price-field').value) || 0);
    });
    document.getElementById('quote-grand-total').textContent = money(grand);
  }

  // ── Price source line under each price ──────────────────────────────────
  function renderSource(row) {
    var el        = row.querySelector('.line-source');
    var ruleName  = row.dataset.ruleName;
    var rulePrice = parseFloat(row.dataset.rulePrice);
    var price     = parseFloat(row.querySelector('.price-field').value);
    el.innerHTML  = '';

    if (!row.querySelector('.rule-field').value) {
      if (!isNaN(price)) el.textContent = 'Manual price';
      return;
    }
    el.appendChild(document.createTextNode('From: ' + ruleName));
    if (!isNaN(rulePrice) && price.toFixed(4) !== rulePrice.toFixed(4)) {
      var warn = document.createElement('span');
      warn.className = 'text-warning-emphasis';
      warn.textContent = ' · overridden (rule price ' + money(rulePrice, 4) + ')';
      el.appendChild(warn);
    }
  }

  function renderMissing(row, data) {
    var el = row.querySelector('.line-source');
    el.innerHTML = '';
    var warn = document.createElement('span');
    warn.className = 'text-warning-emphasis';
    warn.appendChild(document.createTextNode('Can\'t price from "' + data.rule_name + '": missing standard cost on '));
    data.missing_components.forEach(function(c, i) {
      if (i > 0) warn.appendChild(document.createTextNode(', '));
      var a = document.createElement('a');
      a.href = c.url; a.target = '_blank'; a.textContent = c.name;
      warn.appendChild(a);
    });
    el.appendChild(warn);
  }

  // ── Pricing lookups (live rule prices, ignoring existing locks) ─────────
  function priceRow(row, ruleId) {
    var productId  = row.querySelector('.product-select').value;
    var customerId = customerField.value;
    document.getElementById('customer-needed').style.display = customerId ? 'none' : '';
    if (!productId || !customerId) return;

    var url = '/pricing_rules/lookup?live=1&customer_id=' + encodeURIComponent(customerId) +
              '&product_id=' + encodeURIComponent(productId) +
              (ruleId ? '&rule_id=' + encodeURIComponent(ruleId) : '');

    fetch(url, { headers: { 'Accept': 'application/json' } })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        var ruleField = row.querySelector('.rule-field');
        if (data.missing_components && data.missing_components.length) {
          ruleField.value = '';
          row.dataset.auto = '0';
          renderMissing(row, data);
          return;
        }
        if (data.price == null) {
          ruleField.value = '';
          row.dataset.auto = '0';
          row.querySelector('.line-source').textContent = 'No pricing rule applies — enter a price';
          return;
        }
        ruleField.value       = data.rule_id;
        row.dataset.ruleName  = data.rule_name;
        row.dataset.rulePrice = data.price;
        row.dataset.auto      = '1';
        row.querySelector('.price-field').value = data.price.toFixed(4);
        renderSource(row);
        updateRowTotal(row);
        updateGrandTotal();
      })
      .catch(function() {});
  }

  // ── Rows ────────────────────────────────────────────────────────────────
  var rowIndex = Date.now();
  function addRow(productId) {
    var html = document.getElementById('quote-product-template').innerHTML.replace(/NEW_INDEX/g, rowIndex++);
    body.insertAdjacentHTML('beforeend', html);
    var row = body.lastElementChild;
    if (productId) row.querySelector('.product-select').value = productId;
    return row;
  }

  document.getElementById('add-product-row').addEventListener('click', function(e) {
    e.preventDefault();
    addRow();
  });

  document.getElementById('add-from-rule').addEventListener('change', function() {
    var ruleId = this.value;
    if (!ruleId) return;
    var existing = visibleRows().map(function(r) { return r.querySelector('.product-select').value; });
    (RULE_PRODUCTS[ruleId] || []).forEach(function(productId) {
      if (existing.indexOf(String(productId)) !== -1) return;
      var row = addRow(productId);
      if (row.querySelector('.product-select').value) priceRow(row, ruleId);
    });
    this.value = '';
  });

  document.getElementById('reprice-all').addEventListener('click', function() {
    visibleRows().forEach(function(row) { priceRow(row); });
  });

  // Customer-specific rules may apply, so re-price lines that came from a rule.
  function onCustomerChange() {
    visibleRows().forEach(function(row) {
      if (row.dataset.auto === '1' || !row.querySelector('.price-field').value) priceRow(row);
    });
  }
  // select2 fires jQuery change events; without it, listen natively.
  if (!window.$) customerField.addEventListener('change', onCustomerChange);

  body.addEventListener('change', function(e) {
    if (e.target.classList.contains('product-select')) priceRow(e.target.closest('tr'));
  });

  body.addEventListener('input', function(e) {
    var row = e.target.closest('tr');
    if (e.target.classList.contains('price-field')) {
      row.dataset.auto = '0';
      renderSource(row);
    }
    if (e.target.classList.contains('qty-field') || e.target.classList.contains('price-field')) {
      updateRowTotal(row);
      updateGrandTotal();
    }
  });

  body.addEventListener('click', function(e) {
    if (!e.target.closest('.remove-product-row')) return;
    e.preventDefault();
    var row = e.target.closest('tr');
    var destroyField = row.querySelector('.destroy-field');
    if (row.querySelector('input[name$="[id]"]')) {
      destroyField.value = '1';
      row.style.display = 'none';
    } else {
      row.remove();
    }
    updateGrandTotal();
  });

  // ── Validity presets ────────────────────────────────────────────────────
  function parseDate(s) { var p = s.split('-'); return new Date(+p[0], +p[1] - 1, +p[2]); }
  function fmtDate(d) {
    return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
  }
  var PRESETS = {
    'End of month':   function(d) { return new Date(d.getFullYear(), d.getMonth() + 1, 0); },
    'End of quarter': function(d) { return new Date(d.getFullYear(), Math.floor(d.getMonth() / 3) * 3 + 3, 0); },
    '30 days':        function(d) { return new Date(d.getFullYear(), d.getMonth(), d.getDate() + 29); },
    '60 days':        function(d) { return new Date(d.getFullYear(), d.getMonth(), d.getDate() + 59); },
    '90 days':        function(d) { return new Date(d.getFullYear(), d.getMonth(), d.getDate() + 89); }
  };
  document.querySelectorAll('.duration-preset').forEach(function(btn) {
    btn.addEventListener('click', function() {
      if (!validFrom.value) validFrom.value = fmtDate(new Date());
      validUntil.value = fmtDate(PRESETS[btn.dataset.preset](parseDate(validFrom.value)));
    });
  });

  // ── Init ────────────────────────────────────────────────────────────────
  visibleRows().forEach(updateRowTotal);
  updateGrandTotal();

  if (window.$) {
    $('.select2-customer').select2({ placeholder: '— Select customer —', allowClear: true, width: '100%', theme: 'bootstrap-5' })
      .on('change', onCustomerChange);
    $('.select2-location').select2({ placeholder: '— Select location —', allowClear: true, width: '100%', theme: 'bootstrap-5' });
  }
})();
</script>
