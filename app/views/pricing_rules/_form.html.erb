<%= form_with model: rule, local: true do |f| %>
  <% if rule.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% rule.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="card shadow-sm mb-3">
    <div class="card-header fw-semibold">Rule Details</div>
    <div class="card-body row g-3">

      <div class="col-12">
        <%= f.label :name, class: 'form-label' %>
        <%= f.text_field :name, class: 'form-control', placeholder: 'e.g. Acme DEF Contract' %>
      </div>

      <div class="col-md-6">
        <%= f.label :customer_id, "Customer", class: 'form-label' %>
        <%= f.select :customer_id,
              @customers.map { |c| [c.name, c.id] },
              { include_blank: '— All customers —' },
              class: 'form-select select2-customers' %>
        <div class="form-text">Leave blank to apply to all customers.</div>
      </div>

      <div class="col-md-6">
        <label class="form-label">Products <span class="text-danger">*</span></label>
        <select name="pricing_rule[product_ids][]" multiple class="form-select select2-products" style="height:auto;">
          <% @products.each do |p| %>
            <option value="<%= p.id %>"
              <%= 'selected' if rule.products.map(&:id).include?(p.id) %>>
              <%= p.name %>
            </option>
          <% end %>
        </select>
        <div class="form-text">Select one or more products this rule applies to.</div>
      </div>

    </div>
  </div>

  <div class="card shadow-sm mb-3">
    <div class="card-header fw-semibold">Pricing</div>
    <div class="card-body row g-3">

      <div class="col-md-6">
        <%= f.label :pricing_basis, "Pricing Basis", class: 'form-label' %>
        <%= f.select :pricing_basis,
              [['Standard Cost (cost/unit on product)', 'standard_cost'],
               ['Inventory Cost (cost/unit on product)', 'inventory_cost'],
               ['Standard Calculated (BOM sum)', 'standard_calculated']],
              { include_blank: '— Select —' },
              class: 'form-select' %>
      </div>

      <div class="col-md-6">
        <%= f.label :pricing_method, "Pricing Method", class: 'form-label' %>
        <%= f.select :pricing_method,
              [['Markup %', 'markup'], ['Margin %', 'margin'], ['Flat $ / unit', 'flat']],
              { include_blank: '— Select —' },
              class: 'form-select', id: 'pricing-method-select' %>
      </div>

      <div class="col-md-4">
        <label class="form-label" for="pricing_rule_value">
          Value <span id="value-label" class="text-muted small"></span>
        </label>
        <div class="input-group">
          <span class="input-group-text" id="value-prefix" style="display:none;">$</span>
          <%= f.number_field :value, step: 0.0001, min: 0, class: 'form-control', placeholder: '0.00' %>
          <span class="input-group-text" id="value-suffix">%</span>
        </div>
      </div>

    </div>
  </div>

  <div class="card shadow-sm mb-3" id="pricing-preview-card">
    <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
      Live Preview
      <span class="text-muted small fw-normal">See what this rule would produce at different cost points</span>
    </div>
    <div class="card-body">
      <div class="row g-3 align-items-start">
        <div class="col-md-4">
          <label class="form-label" for="preview-sample-cost">Sample Basis Cost</label>
          <div class="input-group">
            <span class="input-group-text">$</span>
            <input type="number" id="preview-sample-cost" class="form-control" value="2.00" step="0.01" min="0" placeholder="2.00">
            <span class="input-group-text">/ unit</span>
          </div>
          <div class="form-text" id="preview-basis-note">Enter an estimated cost to preview sell prices.</div>
        </div>
        <div class="col-md-8">
          <label class="form-label">&nbsp;</label>
          <div id="preview-result" class="p-3 rounded border" style="background:#f8f9fa; min-height:60px;">
            <span class="text-muted small">Select a pricing basis, method, and value above to see the preview.</span>
          </div>
        </div>
      </div>

      <div class="mt-3" id="preview-table-wrap" style="display:none;">
        <div class="text-muted small fw-semibold mb-1">Example outcomes at different cost points:</div>
        <table class="table table-sm table-bordered mb-0" style="font-size:0.85rem;">
          <thead class="table-light">
            <tr>
              <th>Basis Cost</th>
              <th>Sell Price</th>
              <th>Profit / unit</th>
              <th>Effective Margin</th>
              <th>Effective Markup</th>
            </tr>
          </thead>
          <tbody id="preview-table-body"></tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="card shadow-sm mb-3">
    <div class="card-header fw-semibold">Dates</div>
    <div class="card-body row g-3">
      <div class="col-md-6">
        <%= f.label :effective_date, "Effective Date", class: 'form-label' %>
        <%= f.date_field :effective_date, class: 'form-control' %>
        <div class="form-text">Leave blank to apply immediately.</div>
      </div>
      <div class="col-md-6">
        <%= f.label :expiration_date, "Expiration Date", class: 'form-label' %>
        <%= f.date_field :expiration_date, class: 'form-control' %>
        <div class="form-text">Leave blank for no expiration.</div>
      </div>
    </div>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit rule.persisted? ? 'Update Rule' : 'Create Rule', class: 'btn btn-success' %>
    <%= link_to 'Cancel', pricing_rules_path, class: 'btn btn-secondary' %>
  </div>
<% end %>

<script>
(function() {
  var methodSelect  = document.getElementById('pricing-method-select');
  var basisSelect   = document.getElementById('pricing_rule_pricing_basis');
  var valueInput    = document.getElementById('pricing_rule_value');
  var sampleInput   = document.getElementById('preview-sample-cost');
  var prefix        = document.getElementById('value-prefix');
  var suffix        = document.getElementById('value-suffix');
  var valueLabel    = document.getElementById('value-label');
  var resultEl      = document.getElementById('preview-result');
  var basisNoteEl   = document.getElementById('preview-basis-note');
  var tableWrap     = document.getElementById('preview-table-wrap');
  var tableBody     = document.getElementById('preview-table-body');

  var BASIS_LABELS = {
    standard_cost:       'Standard Cost',
    inventory_cost:      'Inventory Cost',
    standard_calculated: 'BOM Cost (estimated)'
  };

  function fmt(n, decimals) {
    return n.toFixed(decimals !== undefined ? decimals : 4);
  }

  function calcSell(cost, method, value) {
    if (method === 'markup') return cost * (1 + value / 100);
    if (method === 'margin') return value >= 100 ? null : cost / (1 - value / 100);
    if (method === 'flat')   return value;
    return null;
  }

  function updateValueUI() {
    var method = methodSelect.value;
    if (method === 'flat') {
      prefix.style.display = '';
      suffix.style.display = 'none';
      valueLabel.textContent = '(sell price per unit)';
    } else {
      prefix.style.display = 'none';
      suffix.style.display = '';
      valueLabel.textContent = method === 'markup' ? '(markup over basis)' : '(gross margin)';
    }
  }

  function updatePreview() {
    var basis      = basisSelect.value;
    var method     = methodSelect.value;
    var value      = parseFloat(valueInput.value);
    var sampleCost = parseFloat(sampleInput.value);

    if (basis === 'standard_calculated') {
      basisNoteEl.textContent = 'BOM cost is calculated from the product\'s bill of materials. Enter an estimated BOM cost to preview.';
    } else {
      basisNoteEl.textContent = 'This will use the product\'s ' + (BASIS_LABELS[basis] || basis) + ' field as the basis.';
    }

    if (!basis || !method || isNaN(value) || isNaN(sampleCost) || sampleCost <= 0) {
      resultEl.innerHTML = '<span class="text-muted small">Fill in all pricing fields and a sample cost to see the preview.</span>';
      tableWrap.style.display = 'none';
      return;
    }

    if (method === 'margin' && value >= 100) {
      resultEl.innerHTML = '<span class="text-danger small"><strong>Invalid:</strong> Margin cannot be 100% or more.</span>';
      tableWrap.style.display = 'none';
      return;
    }

    var sell = calcSell(sampleCost, method, value);
    if (sell === null || sell <= 0) {
      resultEl.innerHTML = '<span class="text-danger small">Cannot calculate a valid sell price with these inputs.</span>';
      tableWrap.style.display = 'none';
      return;
    }

    var profit     = sell - sampleCost;
    var effMargin  = (profit / sell) * 100;
    var effMarkup  = (profit / sampleCost) * 100;

    var formula;
    if (method === 'markup')      formula = '$' + fmt(sampleCost, 2) + ' &times; (1 + ' + fmt(value, 2) + '%)';
    else if (method === 'margin') formula = '$' + fmt(sampleCost, 2) + ' &divide; (1 &minus; ' + fmt(value, 2) + '%)';
    else                          formula = 'Flat rate (basis cost ignored)';

    var profitColor = profit >= 0 ? 'text-success' : 'text-danger';
    resultEl.innerHTML =
      '<div class="d-flex flex-wrap align-items-center gap-4">' +
        '<div>' +
          '<div class="text-muted small mb-1">' + formula + '</div>' +
          '<div class="fs-3 fw-bold text-success">$' + fmt(sell, 4) + '</div>' +
          '<div class="text-muted small">sell price / unit</div>' +
        '</div>' +
        '<div class="vr d-none d-md-block"></div>' +
        '<div class="small">' +
          '<div class="' + profitColor + '"><strong>Profit:</strong> $' + fmt(profit, 4) + ' / unit</div>' +
          '<div><strong>Effective margin:</strong> ' + fmt(effMargin, 2) + '%</div>' +
          '<div><strong>Effective markup:</strong> ' + fmt(effMarkup, 2) + '%</div>' +
        '</div>' +
      '</div>';

    // Build comparison table at multiples of the sample cost
    var multipliers = [0.5, 0.75, 1.0, 1.25, 1.5, 2.0];
    var rows = '';
    multipliers.forEach(function(m) {
      var c = sampleCost * m;
      var s = calcSell(c, method, value);
      if (s === null) return;
      var p  = s - c;
      var mg = (p / s) * 100;
      var mk = (p / c) * 100;
      var highlight = m === 1.0 ? ' class="table-primary fw-semibold"' : '';
      rows +=
        '<tr' + highlight + '>' +
          '<td>$' + fmt(c, 2) + '</td>' +
          '<td>$' + fmt(s, 4) + '</td>' +
          '<td' + (p < 0 ? ' class="text-danger"' : '') + '>$' + fmt(p, 4) + '</td>' +
          '<td>' + fmt(mg, 2) + '%</td>' +
          '<td>' + fmt(mk, 2) + '%</td>' +
        '</tr>';
    });
    tableBody.innerHTML = rows;
    tableWrap.style.display = rows ? '' : 'none';
  }

  methodSelect.addEventListener('change', function() { updateValueUI(); updatePreview(); });
  basisSelect.addEventListener('change', updatePreview);
  valueInput.addEventListener('input', updatePreview);
  sampleInput.addEventListener('input', updatePreview);

  updateValueUI();
  updatePreview();

  if (window.$) {
    $('.select2-customers').select2({ placeholder: '— All customers —', allowClear: true, width: '100%' });
    $('.select2-products').select2({ placeholder: 'Select products…', width: '100%' });
  }
})();
</script>
