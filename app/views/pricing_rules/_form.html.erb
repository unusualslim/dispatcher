<%= form_with model: rule, local: true do |f| %>
  <% if rule.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% rule.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="card shadow-sm mb-3">
    <div class="card-header fw-semibold">Rule Details</div>
    <div class="card-body row g-3">

      <div class="col-12">
        <%= f.label :name, class: 'form-label' %>
        <%= f.text_field :name, class: 'form-control', placeholder: 'e.g. Acme DEF Contract' %>
      </div>

      <div class="col-md-6">
        <%= f.label :customer_id, "Customer", class: 'form-label' %>
        <%= f.select :customer_id,
              @customers.map { |c| [c.name, c.id] },
              { include_blank: '— All customers —' },
              class: 'form-select select2-customers' %>
        <div class="form-text">Leave blank to apply to all customers.</div>
      </div>

      <div class="col-md-6">
        <label class="form-label">Products <span class="text-danger">*</span></label>
        <select name="pricing_rule[product_ids][]" multiple class="form-select select2-products" style="height:auto;">
          <% @products.each do |p| %>
            <option value="<%= p.id %>"
              data-standard-cost="<%= p.standard_cost %>"
              <%= 'selected' if rule.products.map(&:id).include?(p.id) %>>
              <%= p.name %>
            </option>
          <% end %>
        </select>
        <div class="form-text">Select one or more products this rule applies to.</div>
      </div>

    </div>
  </div>

  <div class="card shadow-sm mb-3">
    <div class="card-header fw-semibold">Pricing</div>
    <div class="card-body row g-3">

      <div class="col-md-6">
        <%= f.label :pricing_basis, "Pricing Basis", class: 'form-label' %>
        <%= f.select :pricing_basis,
              [['Standard Cost (cost/unit on product)', 'standard_cost'],
               ['Inventory Cost (cost/unit on product)', 'inventory_cost'],
               ['Standard Calculated (BOM sum)', 'standard_calculated']],
              { include_blank: '— Select —' },
              class: 'form-select' %>
      </div>

      <div class="col-md-6">
        <%= f.label :pricing_method, "Pricing Method", class: 'form-label' %>
        <%= f.select :pricing_method,
              [['Markup %', 'markup'], ['Margin %', 'margin'], ['Flat $ / unit', 'flat']],
              { include_blank: '— Select —' },
              class: 'form-select', id: 'pricing-method-select' %>
      </div>

      <div class="col-md-4">
        <label class="form-label" for="pricing_rule_value">
          Value <span id="value-label" class="text-muted small"></span>
        </label>
        <div class="input-group">
          <span class="input-group-text" id="value-prefix" style="display:none;">$</span>
          <%= f.number_field :value, step: 0.0001, min: 0, class: 'form-control', placeholder: '0.00' %>
          <span class="input-group-text" id="value-suffix">%</span>
        </div>
      </div>

    </div>
  </div>

  <div class="card shadow-sm mb-3" id="pricing-preview-card">
    <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
      Live Preview
      <span class="text-muted small fw-normal">Based on standard costs for selected products</span>
    </div>
    <div class="card-body">
      <div id="preview-notice" class="text-muted small">
        Select products and fill in the pricing fields above to see the preview.
      </div>
      <div id="preview-table-wrap" style="display:none;">
        <table class="table table-sm table-bordered mb-0" style="font-size:0.85rem;">
          <thead class="table-light">
            <tr>
              <th>Product</th>
              <th>Standard Cost</th>
              <th>Formula</th>
              <th>Sell Price</th>
              <th>Profit / unit</th>
              <th>Margin</th>
              <th>Markup</th>
            </tr>
          </thead>
          <tbody id="preview-table-body"></tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="card shadow-sm mb-3">
    <div class="card-header fw-semibold">Dates</div>
    <div class="card-body row g-3">
      <div class="col-md-6">
        <%= f.label :effective_date, "Effective Date", class: 'form-label' %>
        <%= f.date_field :effective_date, class: 'form-control' %>
        <div class="form-text">Leave blank to apply immediately.</div>
      </div>
      <div class="col-md-6">
        <%= f.label :expiration_date, "Expiration Date", class: 'form-label' %>
        <%= f.date_field :expiration_date, class: 'form-control' %>
        <div class="form-text">Leave blank for no expiration.</div>
      </div>
    </div>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit rule.persisted? ? 'Update Rule' : 'Create Rule', class: 'btn btn-success' %>
    <%= link_to 'Cancel', pricing_rules_path, class: 'btn btn-secondary' %>
  </div>
<% end %>

<script>
(function() {
  var methodSelect  = document.getElementById('pricing-method-select');
  var basisSelect   = document.getElementById('pricing_rule_pricing_basis');
  var valueInput    = document.getElementById('pricing_rule_value');
  var prefix        = document.getElementById('value-prefix');
  var suffix        = document.getElementById('value-suffix');
  var valueLabel    = document.getElementById('value-label');
  var notice        = document.getElementById('preview-notice');
  var tableWrap     = document.getElementById('preview-table-wrap');
  var tableBody     = document.getElementById('preview-table-body');
  var productSelect = document.querySelector('.select2-products');

  function fmt(n, decimals) {
    return n.toFixed(decimals !== undefined ? decimals : 4);
  }

  function calcSell(cost, method, value) {
    if (method === 'markup') return cost * (1 + value / 100);
    if (method === 'margin') return value >= 100 ? null : cost / (1 - value / 100);
    if (method === 'flat')   return value;
    return null;
  }

  function updateValueUI() {
    var method = methodSelect.value;
    if (method === 'flat') {
      prefix.style.display = '';
      suffix.style.display = 'none';
      valueLabel.textContent = '(sell price per unit)';
    } else {
      prefix.style.display = 'none';
      suffix.style.display = '';
      valueLabel.textContent = method === 'markup' ? '(markup over basis)' : '(gross margin)';
    }
  }

  function selectedProducts() {
    var selected = [];
    Array.from(productSelect.options).forEach(function(opt) {
      if (opt.selected) {
        selected.push({ name: opt.text, standardCost: opt.dataset.standardCost });
      }
    });
    return selected;
  }

  function updatePreview() {
    var basis    = basisSelect.value;
    var method   = methodSelect.value;
    var value    = parseFloat(valueInput.value);
    var products = selectedProducts();

    var ready = basis && method && !isNaN(value) && products.length > 0;

    if (!ready) {
      notice.style.display = '';
      notice.textContent   = 'Select products and fill in the pricing fields above to see the preview.';
      tableWrap.style.display = 'none';
      return;
    }

    if (method === 'margin' && value >= 100) {
      notice.style.display = '';
      notice.innerHTML     = '<span class="text-danger">Invalid: margin cannot be 100% or more.</span>';
      tableWrap.style.display = 'none';
      return;
    }

    var rows = '';
    products.forEach(function(p) {
      var cost = parseFloat(p.standardCost);
      var costCell, formula, sellCell, profitCell, marginCell, markupCell;

      if (isNaN(cost) || cost <= 0) {
        if (method === 'flat') {
          // flat price doesn't need a basis cost
          cost = 0;
        } else {
          costCell   = '<td class="text-muted fst-italic">no standard cost set</td>';
          rows += '<tr><td>' + p.name + '</td>' + costCell + '<td colspan="5" class="text-muted fst-italic">—</td></tr>';
          return;
        }
      }

      var sell = calcSell(cost, method, value);
      if (sell === null) {
        rows += '<tr><td>' + p.name + '</td><td>$' + fmt(cost, 4) + '</td><td colspan="5" class="text-danger">Cannot calculate</td></tr>';
        return;
      }

      if (method === 'markup')      formula = '$' + fmt(cost, 4) + ' &times; (1 + ' + fmt(value, 2) + '%)';
      else if (method === 'margin') formula = '$' + fmt(cost, 4) + ' &divide; (1 &minus; ' + fmt(value, 2) + '%)';
      else                          formula = 'Flat: $' + fmt(value, 4);

      var profit = sell - cost;
      var margin = cost > 0 ? (profit / sell) * 100 : null;
      var markup = cost > 0 ? (profit / cost) * 100  : null;

      rows +=
        '<tr>' +
          '<td>' + p.name + '</td>' +
          '<td>' + (cost > 0 ? '$' + fmt(cost, 4) : '<span class="text-muted">—</span>') + '</td>' +
          '<td class="text-muted">' + formula + '</td>' +
          '<td class="fw-semibold text-success">$' + fmt(sell, 4) + '</td>' +
          '<td' + (profit < 0 ? ' class="text-danger"' : '') + '>$' + fmt(profit, 4) + '</td>' +
          '<td>' + (margin !== null ? fmt(margin, 2) + '%' : '—') + '</td>' +
          '<td>' + (markup !== null ? fmt(markup, 2) + '%' : '—') + '</td>' +
        '</tr>';
    });

    if (rows) {
      notice.style.display = 'none';
      tableBody.innerHTML  = rows;
      tableWrap.style.display = '';
    } else {
      notice.style.display = '';
      notice.textContent   = 'No products with standard costs selected.';
      tableWrap.style.display = 'none';
    }
  }

  methodSelect.addEventListener('change', function() { updateValueUI(); updatePreview(); });
  basisSelect.addEventListener('change', updatePreview);
  valueInput.addEventListener('input', updatePreview);
  productSelect.addEventListener('change', updatePreview);

  updateValueUI();
  updatePreview();

  if (window.$) {
    $('.select2-customers').select2({ placeholder: '— All customers —', allowClear: true, width: '100%' });
    $('.select2-products').select2({ placeholder: 'Select products…', width: '100%' })
      .on('change', updatePreview);
  }
})();
</script>
