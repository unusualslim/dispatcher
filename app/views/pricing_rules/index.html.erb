<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="mb-0">Pricing Rules</h1>
  <%= link_to 'New Rule', new_pricing_rule_path, class: 'btn btn-primary btn-sm' %>
</div>

<% if notice.present? %>
  <div class="alert alert-success"><%= notice %></div>
<% end %>

<% if @rules.empty? %>
  <div class="text-center text-muted py-5">No pricing rules yet. <%= link_to 'Create one', new_pricing_rule_path %>.</div>
<% else %>
  <div class="card shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Name</th>
            <th>Customer</th>
            <th>Products</th>
            <th>Basis</th>
            <th>Method</th>
            <th>Value</th>
            <th>Effective</th>
            <th>Expires</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @rules.each do |rule| %>
            <tr class="rule-main-row" data-rule-id="<%= rule.id %>" style="cursor:pointer;">
              <td class="fw-semibold">
                <div class="d-flex align-items-center gap-2">
                  <button class="btn btn-link p-0 rule-expand-btn" data-rule-id="<%= rule.id %>" style="color:#6c757d;line-height:1;" title="Expand">
                    <i class="bi bi-chevron-right" style="font-size:.75rem;transition:transform .2s;"></i>
                  </button>
                  <%= rule.name %>
                </div>
              </td>
              <td><%= rule.customer&.name || '<span class="text-muted fst-italic">All customers</span>'.html_safe %></td>
              <td>
                <% rule.products.each do |p| %>
                  <span class="badge bg-secondary me-1"><%= p.name %></span>
                <% end %>
              </td>
              <td class="small text-muted"><%= rule.pricing_basis_label %></td>
              <td class="small text-muted"><%= rule.pricing_method_label %></td>
              <td>
                <% if rule.pricing_method == 'flat' %>
                  <%= number_to_currency(rule.value) %>
                <% else %>
                  <%= number_with_precision(rule.value, precision: 2, strip_insignificant_zeros: true) %>%
                <% end %>
              </td>
              <td class="small"><%= rule.effective_date&.strftime('%b %-d, %Y') || '—' %></td>
              <td class="small"><%= rule.expiration_date&.strftime('%b %-d, %Y') || '—' %></td>
              <td>
                <div class="d-flex gap-1">
                  <%= link_to 'Edit', edit_pricing_rule_path(rule), class: 'btn btn-warning btn-sm' %>
                  <%= button_to 'Delete', pricing_rule_path(rule), method: :delete,
                        data: { confirm: "Delete \"#{rule.name}\"?" },
                        class: 'btn btn-danger btn-sm',
                        form: { style: 'display:inline' } %>
                </div>
              </td>
            </tr>
            <tr class="rule-detail-row d-none" id="rule-detail-<%= rule.id %>">
              <td colspan="9" class="p-0">
                <div class="border-top border-bottom bg-light px-4 py-3" style="font-size:.85rem;">
                  <% if rule.products.empty? %>
                    <span class="text-muted fst-italic">No products in this rule.</span>
                  <% else %>
                    <table class="table table-sm mb-0" style="font-size:.82rem;">
                      <thead class="table-light">
                        <tr>
                          <th>Product</th>
                          <th>Pricing Basis</th>
                          <th>Calculated Cost</th>
                          <th>Pricing Method</th>
                          <th>Price</th>
                          <th>Profit / unit</th>
                          <th>Margin</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% rule.products.each do |product| %>
                          <% cost  = rule.basis_cost(product) %>
                          <% price = rule.calculated_price(product) %>
                          <% profit = price - cost if price && cost.present? && cost > 0 %>
                          <% margin = (profit / price * 100) if profit && price > 0 %>
                          <% missing = rule.pricing_basis == 'standard_calculated' ? product.bom_components_missing_standard_cost : [] %>
                          <tr>
                            <td><%= link_to product.name, product_path(product), class: 'text-decoration-none' %></td>
                            <td class="text-muted"><%= rule.pricing_basis_label %></td>
                            <td>
                              <% if cost.present? && cost > 0 %>
                                <%= number_to_currency(cost, precision: 4) %>
                              <% elsif missing.any? %>
                                <span class="text-warning-emphasis">
                                  <i class="bi bi-exclamation-triangle me-1"></i>Missing standard cost:
                                  <% missing.each_with_index do |component, i| %><%= ', ' if i > 0 %><%= link_to component.name, product_path(component) %><% end %>
                                </span>
                              <% elsif rule.pricing_basis == 'standard_calculated' %>
                                <span class="text-muted fst-italic">No BOM</span>
                              <% elsif rule.pricing_basis == 'inventory_cost' %>
                                <span class="text-muted fst-italic">No inventory cost</span>
                              <% else %>
                                <span class="text-muted fst-italic">No standard cost</span>
                              <% end %>
                            </td>
                            <td class="text-muted">
                              <%= rule.pricing_method_label %>
                              <% if rule.pricing_method == 'flat' %>
                                (<%= number_to_currency(rule.value, precision: 4) %>)
                              <% else %>
                                (<%= number_with_precision(rule.value, precision: 2, strip_insignificant_zeros: true) %>%)
                              <% end %>
                            </td>
                            <td class="fw-semibold">
                              <% if price %>
                                <span class="text-success"><%= number_to_currency(price, precision: 4) %></span>
                              <% else %>
                                <span class="text-muted">—</span>
                              <% end %>
                            </td>
                            <td class="<%= 'text-danger' if profit&.negative? %>">
                              <%= profit ? number_to_currency(profit, precision: 4) : '—' %>
                            </td>
                            <td class="<%= 'text-danger' if margin&.negative? %>">
                              <%= margin ? "#{number_with_precision(margin, precision: 2)}%" : '—' %>
                            </td>
                          </tr>
                        <% end %>
                      </tbody>
                    </table>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <script>
    (function() {
      function toggleRule(id) {
        var detailRow = document.getElementById('rule-detail-' + id);
        if (!detailRow) return;
        var icon = document.querySelector('.rule-expand-btn[data-rule-id="' + id + '"] i');
        var isOpen = !detailRow.classList.contains('d-none');
        detailRow.classList.toggle('d-none', isOpen);
        if (icon) icon.style.transform = isOpen ? '' : 'rotate(90deg)';
      }

      document.querySelectorAll('.rule-main-row').forEach(function(row) {
        row.addEventListener('click', function(e) {
          if (e.target.closest('a, form') ||
              (e.target.closest('button') && !e.target.closest('.rule-expand-btn'))) return;
          toggleRule(row.dataset.ruleId);
        });
      });
    })();
  </script>
<% end %>
