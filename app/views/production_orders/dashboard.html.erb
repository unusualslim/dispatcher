<% content_for :title, "Production Dashboard" %>

<%# ── Header ── %>
<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="mb-0">Production Dashboard</h1>
  <div class="d-flex gap-2">
    <%= link_to "Kanban", kanban_production_orders_path, class: "btn btn-outline-secondary btn-sm" %>
    <%= link_to "All Orders", production_orders_path, class: "btn btn-outline-secondary btn-sm" %>
    <%= link_to "New Production Order", new_production_order_path, class: "btn btn-primary btn-sm" %>
  </div>
</div>

<%# ── Tabs ── %>
<ul class="nav nav-tabs mb-0" id="dashboardTabs" role="tablist">
  <li class="nav-item" role="presentation">
    <a class="nav-link <%= 'active' if @tab == 'production' %>"
       href="<%= dashboard_production_orders_path(tab: 'production') %>">
      Production
      <span class="badge rounded-pill ms-1 <%= @production_lines.any? ? 'bg-warning text-dark' : 'bg-secondary' %>">
        <%= @production_lines.size %>
      </span>
    </a>
  </li>
  <li class="nav-item" role="presentation">
    <a class="nav-link <%= 'active' if @tab == 'buy' %>"
       href="<%= dashboard_production_orders_path(tab: 'buy') %>">
      Buy
      <span class="badge rounded-pill ms-1 <%= @buy_lines.any? ? 'bg-danger' : 'bg-secondary' %>">
        <%= @buy_lines.size %>
      </span>
    </a>
  </li>
  <li class="nav-item" role="presentation">
    <a class="nav-link <%= 'active' if @tab == 'allocated' %>"
       href="<%= dashboard_production_orders_path(tab: 'allocated') %>">
      Allocated
      <span class="badge rounded-pill ms-1 bg-success">
        <%= @allocated_lines.size %>
      </span>
    </a>
  </li>
</ul>

<div class="card shadow-sm border-top-0 rounded-0 rounded-bottom">
  <div class="table-responsive">

    <%# ── PRODUCTION TAB ── %>
    <% if @tab == 'production' %>
      <table class="table table-sm table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Order #</th>
            <th>Customer</th>
            <th>Product</th>
            <th>UOM</th>
            <th class="text-end">Qty Needed</th>
            <th class="text-end">In Stock</th>
            <th class="text-end">Shortfall</th>
            <th>Due</th>
            <th>Salesperson</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% if @production_lines.any? %>
            <% @production_lines.each do |cop| %>
              <% order   = cop.customer_order %>
              <% product = cop.product %>
              <% in_stock  = product&.current_stock.to_f %>
              <% needed    = cop.quantity.to_f %>
              <% shortfall = [needed - in_stock, 0].max %>
              <% overdue   = order.required_delivery_date && order.required_delivery_date < Date.today %>
              <tr>
                <td class="text-nowrap">
                  <%= link_to "##{order.id}", customer_order_path(order), class: "fw-semibold text-decoration-none" %>
                  <% if order.external_order_no.present? %>
                    <div class="text-muted small"><%= order.external_order_no %></div>
                  <% end %>
                </td>
                <td class="small"><%= order.customer&.name || "—" %></td>
                <td class="small fw-semibold"><%= product&.name || cop.product_name %></td>
                <td class="small text-muted"><%= product&.unit_of_measurement %></td>
                <td class="text-end small"><%= number_with_delimiter(needed) %></td>
                <td class="text-end small"><%= number_with_delimiter(in_stock) %></td>
                <td class="text-end small fw-semibold <%= shortfall > 0 ? 'text-danger' : 'text-success' %>">
                  <%= shortfall > 0 ? number_with_delimiter(shortfall) : "—" %>
                </td>
                <td class="text-nowrap small">
                  <% if order.required_delivery_date %>
                    <span class="<%= overdue ? 'text-danger fw-semibold' : '' %>">
                      <%= order.required_delivery_date.strftime("%b %-d") %>
                    </span>
                  <% else %>—<% end %>
                </td>
                <td class="small text-muted"><%= order.salesperson %></td>
                <td class="text-nowrap">
                  <%= link_to "Make It",
                        new_production_order_path(
                          product_id:  product&.id,
                          item:        product&.name || cop.product_name,
                          qty_to_make: shortfall > 0 ? shortfall.ceil : needed.ceil,
                          due_date:    order.required_delivery_date
                        ),
                        class: "btn btn-sm btn-warning" %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr><td colspan="10" class="text-center text-muted py-4">No open production lines.</td></tr>
          <% end %>
        </tbody>
      </table>

    <%# ── BUY TAB ── %>
    <% elsif @tab == 'buy' %>
      <%= form_with url: bulk_close_customer_orders_path, method: :post, data: { turbo: false } do |f| %>
        <%= f.hidden_field :tab, value: 'buy' %>
        <div class="d-flex align-items-center gap-2 px-3 py-2 border-bottom bg-light">
          <input type="checkbox" id="buy_select_all" class="form-check-input mt-0">
          <label for="buy_select_all" class="form-check-label small text-muted mb-0">Select all</label>
          <button type="submit" class="btn btn-sm btn-outline-danger ms-2"
                  onclick="return confirm('Mark selected orders as Delivered?')">
            Close Selected
          </button>
        </div>
        <table class="table table-sm table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th></th>
              <th>Order #</th>
              <th>Customer</th>
              <th>Product</th>
              <th>UOM</th>
              <th class="text-end">Qty Needed</th>
              <th class="text-end">In Stock</th>
              <th class="text-end">Shortfall</th>
              <th>Due</th>
              <th>Salesperson</th>
              <th>Preferred Vendor</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% if @buy_lines.any? %>
              <% @buy_lines.each do |cop| %>
                <% order    = cop.customer_order %>
                <% product  = cop.product %>
                <% in_stock  = product&.current_stock.to_f %>
                <% needed    = cop.quantity.to_f %>
                <% shortfall = [needed - in_stock, 0].max %>
                <% overdue   = order.required_delivery_date && order.required_delivery_date < Date.today %>
                <% vendor    = product&.vendors&.first %>
                <tr>
                  <td><input type="checkbox" name="order_ids[]" value="<%= order.id %>" class="form-check-input buy-row-check mt-0"></td>
                  <td class="text-nowrap">
                    <%= link_to "##{order.id}", customer_order_path(order), class: "fw-semibold text-decoration-none" %>
                    <% if order.external_order_no.present? %>
                      <div class="text-muted small"><%= order.external_order_no %></div>
                    <% end %>
                  </td>
                  <td class="small"><%= order.customer&.name || "—" %></td>
                  <td class="small fw-semibold"><%= product&.name || cop.product_name %></td>
                  <td class="small text-muted"><%= product&.unit_of_measurement %></td>
                  <td class="text-end small"><%= number_with_delimiter(needed) %></td>
                  <td class="text-end small"><%= number_with_delimiter(in_stock) %></td>
                  <td class="text-end small fw-semibold text-danger"><%= number_with_delimiter(shortfall) %></td>
                  <td class="text-nowrap small">
                    <% if order.required_delivery_date %>
                      <span class="<%= overdue ? 'text-danger fw-semibold' : '' %>">
                        <%= order.required_delivery_date.strftime("%b %-d") %>
                      </span>
                    <% else %>—<% end %>
                  </td>
                  <td class="small text-muted"><%= order.salesperson %></td>
                  <td class="small"><%= vendor&.name || "—" %></td>
                  <td class="text-nowrap">
                    <% note = "Customer Order ##{order.id}" %>
                    <% note += " (#{order.external_order_no})" if order.external_order_no.present? %>
                    <% note += " — #{order.customer&.name}" if order.customer&.name.present? %>
                    <%= link_to "Create PO",
                          new_purchase_order_path(
                            vendor_id:              vendor&.id,
                            product_id:             product&.id,
                            quantity:               shortfall.ceil,
                            expected_delivery_date: order.required_delivery_date,
                            notes:                  note
                          ),
                          class: "btn btn-sm btn-outline-primary" %>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr><td colspan="12" class="text-center text-muted py-4">No open buy lines.</td></tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
      <script>
        document.getElementById('buy_select_all').addEventListener('change', function() {
          document.querySelectorAll('.buy-row-check').forEach(cb => cb.checked = this.checked);
        });
      </script>

    <%# ── ALLOCATED TAB ── %>
    <% elsif @tab == 'allocated' %>
      <%= form_with url: bulk_close_customer_orders_path, method: :post, data: { turbo: false } do |f| %>
        <%= f.hidden_field :tab, value: 'allocated' %>
        <div class="d-flex align-items-center gap-2 px-3 py-2 border-bottom bg-light">
          <input type="checkbox" id="alloc_select_all" class="form-check-input mt-0">
          <label for="alloc_select_all" class="form-check-label small text-muted mb-0">Select all</label>
          <button type="submit" class="btn btn-sm btn-outline-danger ms-2"
                  onclick="return confirm('Mark selected orders as Delivered?')">
            Close Selected
          </button>
        </div>
        <table class="table table-sm table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th></th>
              <th>Order #</th>
              <th>Customer</th>
              <th>Product</th>
              <th>UOM</th>
              <th class="text-end">Qty Ordered</th>
              <th class="text-end">In Stock</th>
              <th>Due</th>
              <th>Salesperson</th>
              <th>Dispatch</th>
            </tr>
          </thead>
          <tbody>
            <% if @allocated_lines.any? %>
              <% @allocated_lines.each do |cop| %>
                <% order   = cop.customer_order %>
                <% product = cop.product %>
                <% overdue = order.required_delivery_date && order.required_delivery_date < Date.today %>
                <% dispatch = order.dispatches.first %>
                <tr>
                  <td><input type="checkbox" name="order_ids[]" value="<%= order.id %>" class="form-check-input alloc-row-check mt-0"></td>
                  <td class="text-nowrap">
                    <%= link_to "##{order.id}", customer_order_path(order), class: "fw-semibold text-decoration-none" %>
                    <% if order.external_order_no.present? %>
                      <div class="text-muted small"><%= order.external_order_no %></div>
                    <% end %>
                  </td>
                  <td class="small"><%= order.customer&.name || "—" %></td>
                  <td class="small fw-semibold"><%= product&.name || cop.product_name %></td>
                  <td class="small text-muted"><%= product&.unit_of_measurement %></td>
                  <td class="text-end small"><%= number_with_delimiter(cop.quantity) %></td>
                  <td class="text-end small"><%= number_with_delimiter(product.current_stock) %></td>
                  <td class="text-nowrap small">
                    <% if order.required_delivery_date %>
                      <span class="<%= overdue ? 'text-danger fw-semibold' : '' %>">
                        <%= order.required_delivery_date.strftime("%b %-d") %>
                      </span>
                    <% else %>—<% end %>
                  </td>
                  <td class="small text-muted"><%= order.salesperson %></td>
                  <td>
                    <% if dispatch %>
                      <% d_color = { 'New' => 'secondary', 'sent_to_driver' => 'primary', 'complete' => 'success', 'billed' => 'warning' }.fetch(dispatch.dispatch_status.to_s, 'secondary') %>
                      <% d_label = { 'New' => 'New', 'sent_to_driver' => 'Sent to Driver', 'complete' => 'Complete', 'billed' => 'Billed' }.fetch(dispatch.dispatch_status.to_s, dispatch.dispatch_status.to_s) %>
                      <%= link_to d_label, dispatch_path(dispatch),
                            class: "badge bg-#{d_color} text-decoration-none" %>
                    <% else %>
                      <%= link_to "No Dispatch", new_dispatch_path(customer_order_id: order.id),
                            class: "badge bg-light text-dark border text-decoration-none" %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr><td colspan="10" class="text-center text-muted py-4">No allocated lines.</td></tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
      <script>
        document.getElementById('alloc_select_all').addEventListener('change', function() {
          document.querySelectorAll('.alloc-row-check').forEach(cb => cb.checked = this.checked);
        });
      </script>
    <% end %>

  </div>
</div>

<%# ── Bottom sections ── %>
<div class="row g-4 mt-2">

  <%# In Progress %>
  <div class="col-12 col-lg-6">
    <div class="card shadow-sm h-100">
      <div class="card-header d-flex justify-content-between align-items-center bg-primary text-white">
        <strong>In Progress</strong>
        <span class="badge bg-white text-primary"><%= @in_progress.size %></span>
      </div>
      <% if @in_progress.empty? %>
        <div class="card-body text-muted text-center py-4">No orders currently in progress.</div>
      <% else %>
        <div class="table-responsive">
          <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Order</th>
                <th>Product</th>
                <th class="text-end">Qty</th>
                <th>Due</th>
              </tr>
            </thead>
            <tbody>
              <% @in_progress.each do |po| %>
                <% overdue = po.due_date && po.due_date < Date.today %>
                <tr>
                  <td><%= link_to po.number, production_order_path(po), class: 'fw-semibold text-decoration-none' %></td>
                  <td class="small"><%= po.product&.name || po.item %></td>
                  <td class="text-end small"><%= number_with_delimiter(po.qty_to_make) %></td>
                  <td class="text-nowrap small">
                    <% if po.due_date %>
                      <span class="<%= overdue ? 'text-danger fw-semibold' : '' %>">
                        <%= po.due_date.strftime('%b %-d') %>
                        <%= " (#{(Date.today - po.due_date).to_i}d late)" if overdue %>
                      </span>
                    <% else %>—<% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  </div>

  <%# QC Holds %>
  <div class="col-12 col-lg-6">
    <div class="card shadow-sm h-100">
      <div class="card-header d-flex justify-content-between align-items-center bg-warning text-dark">
        <strong>QC Holds &amp; Rejections</strong>
        <span class="badge bg-dark"><%= @qc_holds.size %></span>
      </div>
      <% if @qc_holds.empty? %>
        <div class="card-body text-muted text-center py-4">No batches on hold or rejected.</div>
      <% else %>
        <div class="table-responsive">
          <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Order</th>
                <th>Product</th>
                <th>Batch</th>
                <th>Status</th>
                <th>Notes</th>
              </tr>
            </thead>
            <tbody>
              <% @qc_holds.each do |batch| %>
                <% po = batch.production_order %>
                <tr>
                  <td><%= link_to po.number, production_order_path(po), class: 'fw-semibold text-decoration-none' %></td>
                  <td class="small"><%= po.product&.name || po.item %></td>
                  <td class="small text-muted"><%= batch.batch_number.presence || "##{batch.id}" %></td>
                  <td>
                    <span class="badge bg-<%= batch.qc_status == 'rejected' ? 'danger' : 'warning text-dark' %>">
                      <%= batch.qc_status.humanize %>
                    </span>
                  </td>
                  <td class="small text-muted"><%= batch.qc_notes.presence || '—' %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  </div>

  <%# Low Stock Raw Materials %>
  <div class="col-12 col-lg-6">
    <div class="card shadow-sm h-100">
      <div class="card-header d-flex justify-content-between align-items-center bg-danger text-white">
        <strong>Low Stock Raw Materials</strong>
        <span class="badge bg-white text-danger"><%= @low_stock_materials.size %></span>
      </div>
      <% if @low_stock_materials.empty? %>
        <div class="card-body text-muted text-center py-4">All raw materials are adequately stocked.</div>
      <% else %>
        <div class="table-responsive">
          <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Material</th>
                <th class="text-end">In Stock</th>
                <th class="text-end">Reorder Point</th>
                <th class="text-end">Shortfall</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% @low_stock_materials.each do |product| %>
                <% shortfall = (product.reorder_point.to_f - product.current_stock.to_f).ceil %>
                <tr>
                  <td><%= link_to product.name, product_path(product), class: 'text-decoration-none small fw-semibold' %></td>
                  <td class="text-end small text-danger fw-semibold"><%= number_with_delimiter(product.current_stock) %></td>
                  <td class="text-end small text-muted"><%= number_with_delimiter(product.reorder_point) %></td>
                  <td class="text-end small"><%= number_with_delimiter(shortfall) %> <%= product.unit_of_measurement %></td>
                  <td class="text-end">
                    <%= link_to 'Create PO', new_purchase_order_path(product_id: product.id, quantity: shortfall),
                          class: 'btn btn-sm btn-outline-danger' %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  </div>

  <%# Recently Completed %>
  <div class="col-12 col-lg-6">
    <div class="card shadow-sm h-100">
      <div class="card-header bg-success text-white">
        <strong>Recently Completed (Last 30 Days)</strong>
      </div>
      <% if @recently_completed.empty? %>
        <div class="card-body text-muted text-center py-4">No orders completed in the last 30 days.</div>
      <% else %>
        <div class="table-responsive">
          <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Order</th>
                <th>Product</th>
                <th class="text-end">Qty Made</th>
                <th>Completed</th>
              </tr>
            </thead>
            <tbody>
              <% @recently_completed.each do |po| %>
                <tr>
                  <td><%= link_to po.number, production_order_path(po), class: 'fw-semibold text-decoration-none' %></td>
                  <td class="small"><%= po.product&.name || po.item %></td>
                  <td class="text-end small"><%= number_with_delimiter(po.total_qty_produced || po.qty_to_make) %></td>
                  <td class="text-nowrap small text-muted"><%= po.date_completed&.strftime('%b %-d') || '—' %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  </div>

</div>
