<%# GL Posting tab: the entry in force (frozen at posting) or a live preview, plus the order's history.
    Locals: production_order %>
<% entries = production_order.ledger_entries.includes(:ledger_lines, :approved_by, :reversal).newest_first.to_a %>
<% active = entries.find { |e| e.reversal_of_id.nil? && e.reversal.nil? } %>

<% if active %>
  <%= render 'ledger_entries/entry', entry: active %>
<% else %>
  <%= render 'gl_preview', journal: ProductionOrderJournal.new(production_order) %>
<% end %>

<% history = entries - [active] %>
<% if history.any? %>
  <div class="card shadow-sm mt-3">
    <div class="card-header fw-semibold">Entry history</div>
    <div class="card-body p-0">
      <% history.each do |entry| %>
        <div class="border-bottom p-2"><%= render 'ledger_entries/entry', entry: entry, compact: true %></div>
      <% end %>
    </div>
  </div>
<% end %>
