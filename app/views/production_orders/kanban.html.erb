<%# Production calendar: open production orders by production date, plus orders behind schedule and orders not
    scheduled yet. The header's warehouse selector narrows it to one plant. %>
<% span = (@end_date - @start_date).to_i + 1 %>
<% nav = ->(from) { kanban_production_orders_path(from: from, to: from + span - 1, search: @search_term, group: @group) } %>
<div class="container-fluid mt-4">
  <%= render layout: 'shared/page_header', locals: { title: 'Production Calendar',
        subtitle: "#{@start_date.strftime('%a %b %-d')} – #{@end_date.strftime('%a %b %-d')} · #{current_warehouse&.company_name || 'All warehouses'}" } do %>
    <div class="btn-group btn-group-sm">
      <%= link_to nav.(@start_date - span), class: 'btn btn-outline-secondary', title: 'Earlier' do %><i class="bi bi-chevron-left"></i><% end %>
      <%= link_to 'Today', kanban_production_orders_path(search: @search_term, group: @group), class: 'btn btn-outline-secondary' %>
      <%= link_to nav.(@start_date + span), class: 'btn btn-outline-secondary', title: 'Later' do %><i class="bi bi-chevron-right"></i><% end %>
    </div>
    <%= link_to 'Table', production_orders_path, class: 'btn btn-outline-secondary btn-sm' %>
    <% if can?(:production, :edit) %><%= link_to 'New', new_production_order_path, class: 'btn btn-primary btn-sm' %><% end %>
  <% end %>

  <% if notice.present? %><div class="alert alert-success py-2"><%= notice %></div><% end %>
  <% if alert.present? %><div class="alert alert-warning py-2"><%= alert %></div><% end %>

  <%= form_with url: kanban_production_orders_path, method: :get, class: 'd-flex flex-wrap gap-2 align-items-end mb-3' do %>
    <div><label class="form-label small mb-0" for="search">Search</label>
      <%= text_field_tag :search, @search_term, class: 'form-control form-control-sm', placeholder: 'Order #, item, customer' %></div>
    <div><label class="form-label small mb-0" for="group">Product group</label>
      <%= select_tag :group, options_for_select([['All', '']] + ReportingGroup.order(:name).pluck(:name), @group), class: 'form-select form-select-sm' %></div>
    <div><label class="form-label small mb-0" for="from">From</label>
      <%= date_field_tag :from, @start_date, class: 'form-control form-control-sm' %></div>
    <div><label class="form-label small mb-0" for="to">To</label>
      <%= date_field_tag :to, @end_date, class: 'form-control form-control-sm' %></div>
    <%= submit_tag 'Apply', class: 'btn btn-sm btn-primary', name: nil %>
    <%= link_to 'Reset', kanban_production_orders_path, class: 'btn btn-sm btn-outline-secondary' %>
    <span class="small text-muted ms-auto">
      <% { created: 'Created', in_progress: 'In progress', quality_check: 'Quality check', completed: 'Completed' }.each do |key, label| %>
        <span class="d-inline-block rounded-1 align-middle production-status-<%= key %>" style="width:.7rem;height:.7rem"></span> <%= label %>
      <% end %>
      · dot = materials
    </span>
  <% end %>

  <div class="production-board d-flex gap-2 pb-3">
    <% if @behind.any? %>
      <%= render 'kanban_column', title: 'Behind schedule', subtitle: 'Open, production date passed', orders: @behind, tone: 'danger' %>
    <% end %>
    <% (@start_date..@end_date).each do |date| %>
      <%= render 'kanban_column', title: date.strftime('%a %-m/%-d'), date: date, orders: @by_day[date] || [],
                                  tone: (date == Date.current ? 'primary' : nil), subtitle: (date == Date.current ? 'Today' : nil) %>
    <% end %>
    <%= render 'kanban_column', title: 'Unscheduled', subtitle: 'Open, no production date', orders: @unscheduled, tone: 'secondary' %>
  </div>
</div>

<style>
  .production-board { overflow-x: auto; align-items: flex-start; }
  .production-col { flex: 0 0 230px; background: var(--bs-tertiary-bg, #f8f9fa); border: 1px solid var(--bs-border-color); border-radius: 6px; }
  .production-card { border-left: 4px solid #6c757d; }
  .production-status-created { background: #6c757d; } .production-card.production-status-created { border-left-color: #6c757d; background: var(--bs-body-bg); }
  .production-status-in_progress { background: #ffc107; } .production-card.production-status-in_progress { border-left-color: #ffc107; background: var(--bs-body-bg); }
  .production-status-quality_check { background: #0d6efd; } .production-card.production-status-quality_check { border-left-color: #0d6efd; background: var(--bs-body-bg); }
  .production-status-completed { background: #198754; } .production-card.production-status-completed { border-left-color: #198754; background: var(--bs-body-bg); opacity: .75; }
</style>
