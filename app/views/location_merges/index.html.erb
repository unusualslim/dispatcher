<h1 class="mb-2">Merge Locations</h1>
<p class="text-muted">
  Likely duplicates: two of one customer's delivery locations at the same zip code (or the same city when one has
  no zip). The suggested keeper is the one linked to the customer's PDI ship-to, else the one with more orders.
  Confidence: the same street address is 90%, and 100% when the names also share a word (or the store number
  matches); without a street match it's name + place, at most 85%. Pairs at
  <%= LocationMerge::Suggestions::AUTO_SELECT %>% or more are ticked for you. Merging moves everything from the
  removed location to the kept one and deletes it, and can't be undone. Use "Review" to see one pair in detail, or
  merge any location from its own page.
</p>

<% if @pairs.empty? %>
  <div class="text-center text-muted py-5">No likely duplicates.</div>
<% else %>
  <% auto = @pairs.count { |p| p.score >= LocationMerge::Suggestions::AUTO_SELECT } %>
  <%= form_with url: bulk_location_merges_path, method: :post, local: true, id: "bulk-merge-form",
        data: { turbo_confirm: "Merge the selected locations? Each removed location is deleted. This can't be undone." } do %>
    <div class="d-flex gap-2 align-items-center flex-wrap mb-2">
      <button type="submit" class="btn btn-danger btn-sm" id="bulk-merge-btn">Merge selected (<span id="bulk-count">0</span>)</button>
      <button type="button" class="btn btn-outline-secondary btn-sm" data-select-min="<%= LocationMerge::Suggestions::AUTO_SELECT %>">Select <%= LocationMerge::Suggestions::AUTO_SELECT %>%+ (<%= auto %>)</button>
      <button type="button" class="btn btn-outline-secondary btn-sm" data-select-min="80">Select 80%+</button>
      <button type="button" class="btn btn-outline-secondary btn-sm" data-select-min="101">Clear</button>
      <span class="text-muted small"><%= pluralize(@pairs.size, 'suggested pair') %></span>
    </div>
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead class="table-light">
          <tr>
            <th style="width:32px;"></th>
            <th>Confidence</th>
            <th>Customer</th>
            <th>Keep</th>
            <th>Remove (merge into keep)</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @pairs.each do |pair| %>
            <tr>
              <td>
                <input type="checkbox" class="form-check-input pair-select" name="pairs[]" value="<%= pair.remove.id %>:<%= pair.keep.id %>"
                       data-score="<%= pair.score %>" <%= 'checked' if pair.score >= LocationMerge::Suggestions::AUTO_SELECT %>>
              </td>
              <td class="text-nowrap">
                <span class="badge <%= pair.score >= 95 ? 'bg-success' : pair.score >= 80 ? 'bg-info text-dark' : pair.score >= 60 ? 'bg-warning text-dark' : 'bg-secondary' %>"><%= pair.score %>%</span>
                <div class="small text-muted"><%= pair.reasons.join('; ') %></div>
              </td>
              <td class="small"><%= link_to pair.customer.name, customer_path(pair.customer), class: "text-decoration-none" %></td>
              <% [pair.keep, pair.remove].each do |location| %>
                <td>
                  <%= link_to location.company_name, location_path(location), class: "fw-semibold text-decoration-none" %>
                  <div class="small text-muted">
                    <%= [location.address, location.city, location.state, location.zip].compact_blank.join(', ').presence || 'no address' %>
                    · <%= pluralize(@order_counts[location.id].to_i, 'order') %>
                  </div>
                </td>
              <% end %>
              <td class="text-end text-nowrap">
                <%= link_to "Review", new_location_merge_path(source_id: pair.remove.id, target_id: pair.keep.id), class: "btn btn-outline-primary btn-sm" %>
                <%= link_to "Swap", new_location_merge_path(source_id: pair.keep.id, target_id: pair.remove.id), class: "btn btn-outline-secondary btn-sm" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <script>
    (function () {
      var boxes = document.querySelectorAll('.pair-select');
      var count = document.getElementById('bulk-count');
      function update() { count.textContent = document.querySelectorAll('.pair-select:checked').length; }
      boxes.forEach(function (b) { b.addEventListener('change', update); });
      document.querySelectorAll('[data-select-min]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var min = parseInt(btn.dataset.selectMin, 10);
          boxes.forEach(function (b) { b.checked = parseInt(b.dataset.score, 10) >= min; });
          update();
        });
      });
      update();
    })();
  </script>
<% end %>
