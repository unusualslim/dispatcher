<%# columns: [[key, header, shown by default], …] from order_list_columns; every header sorts (CustomerOrderListQuery::SORTS). %>
<% hidden = columns.reject { |_, _, shown| shown }.map(&:first) %>
<div class="table-responsive">
  <table class="table table-hover table-bordered table-sm align-middle small order-list-table">
    <thead class="table-light">
      <tr>
        <% columns.each do |key, label, _| %>
          <th data-col="<%= key %>" class="<%= 'd-none' if hidden.include?(key) %> <%= 'text-end' if %w[qty total].include?(key) %>">
            <%= sort_header label, key %>
          </th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% customer_orders.each do |order| %>
        <% cells = {
             'order' => link_to(order_list_number(order), customer_order_path(order), class: 'fw-semibold text-decoration-none text-nowrap'),
             'status' => tag.span(order.order_status, class: "badge #{order_status_badge_class(order.order_status)}"),
             'customer' => (order.customer ? link_to(order.customer.name, customer_path(order.customer), class: 'text-decoration-none') : ''),
             'ship_to' => safe_join([order.location&.company_name,
                                     (tag.div(order.location.city, class: 'text-muted') if order.location&.city.present?)].compact),
             'ship_from' => order_list_ship_from(order),
             'products' => safe_join([order_list_products(order),
                                      (tag.span('Freight only', class: 'badge bg-warning text-dark ms-1') if order.freight_only)].compact),
             'qty' => order_list_qty(order),
             'total' => order_list_total(order),
             'order_date' => (order.order_date || order.created_at)&.in_time_zone('Eastern Time (US & Canada)')&.strftime('%m/%d/%Y'),
             'delivery' => safe_join([order.required_delivery_date&.strftime('%m/%d/%Y'),
                                      (tag.span(order.delivery_time.strftime('%-l:%M %p'), class: 'text-muted ms-1') if order.delivery_time)].compact),
             'po' => order.customer_po_number,
             'invoice' => order.invoice_no,
             'invoice_date' => order.invoice_date&.strftime('%m/%d/%Y'),
             'salesperson' => order.salesperson,
             'carrier' => order.carrier,
             'driver' => order.pdi_driver,
             'dispatch' => safe_join(order.dispatches.map { |d| link_to("##{d.id}", dispatch_path(d), class: 'text-decoration-none') }, ', ')
           } %>
        <tr>
          <% columns.each do |key, _, _| %>
            <td data-col="<%= key %>" class="<%= 'd-none' if hidden.include?(key) %> <%= 'text-end text-nowrap' if %w[qty total].include?(key) %> <%= 'text-nowrap' if %w[order_date delivery invoice_date].include?(key) %>"><%= cells[key] %></td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
