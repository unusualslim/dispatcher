<%# Freight card: inputs the freight rules look at, the purchase (carrier) and sale (customer) charges, and payables. %>
<% order = @customer_order %>
<% charges = order.order_freight_charges.includes(:freight_rule, :carrier, :freight_class).ordered.to_a %>
<% origin = order.freight_origin %>
<% miles = order.freight_miles_or_estimate %>
<% carrier = order.freight_carrier_vendor %>
<div class="col-12" id="freight">
  <div class="card shadow-sm">
    <div class="card-header fw-semibold d-flex flex-wrap justify-content-between align-items-center gap-2">
      <span>
        Freight
        <% if order.freight_calculated_at %>
          <span class="text-muted small fw-normal ms-2">calculated <%= order.freight_calculated_at.strftime('%m/%d/%Y %l:%M %p') %></span>
        <% end %>
      </span>
      <div class="d-flex gap-2">
        <%= link_to 'Freight rules', freight_rules_path, class: 'btn btn-outline-secondary btn-sm' %>
        <%= button_to 'Calculate freight', calculate_customer_order_freight_path(order), method: :post,
                      class: 'btn btn-primary btn-sm', form: { data: { turbo: false } } %>
      </div>
    </div>
    <div class="card-body">
      <%= form_with model: order, url: customer_order_freight_path(order), method: :patch, local: true,
                    data: { turbo: false }, class: 'row g-2 align-items-end mb-3' do |f| %>
        <div class="col-md-3">
          <label class="form-label small mb-1">Origin</label>
          <%= f.collection_select :freight_origin_location_id, @freight_origins, :id, :company_name,
                                  { include_blank: origin ? "#{origin.company_name} (default)" : 'Not set' },
                                  class: 'form-select form-select-sm js-select2' %>
        </div>
        <div class="col-md-3">
          <label class="form-label small mb-1">Carrier</label>
          <%= f.collection_select :freight_carrier_id, @carriers, :id, :label,
                                  { include_blank: carrier ? "#{carrier.name} (from PDI)" : 'Not set' },
                                  class: 'form-select form-select-sm js-select2' %>
        </div>
        <div class="col-md-1">
          <label class="form-label small mb-1" title="Blank uses the GPS estimate">Miles</label>
          <%= f.number_field :freight_miles, class: 'form-control form-control-sm', step: 'any', min: 0,
                                             placeholder: miles ? "~#{miles.round}" : '' %>
        </div>
        <div class="col-md-1">
          <label class="form-label small mb-1">Extra stops</label>
          <%= f.number_field :freight_extra_stops, class: 'form-control form-control-sm', min: 0, step: 1 %>
        </div>
        <div class="col-md-1">
          <label class="form-label small mb-1">Pump offs</label>
          <%= f.number_field :freight_pump_offs, class: 'form-control form-control-sm', min: 0, step: 1 %>
        </div>
        <div class="col-md-2">
          <label class="form-label small mb-1">Customer sees freight</label>
          <%= f.select :freight_presentation, OrderFreight::PRESENTATIONS.invert, {}, class: 'form-select form-select-sm' %>
        </div>
        <div class="col-md-1 d-grid">
          <%= button_tag 'Save', type: 'submit', name: 'recalculate', value: '1', class: 'btn btn-outline-primary btn-sm',
                                 title: 'Save and recalculate' %>
        </div>
      <% end %>
      <% if order.freight_miles_source == :lane %>
        <div class="form-text mt-n2 mb-3">Miles: <%= miles.round %> standard lane miles from <%= origin&.company_name %>. Type miles to override.</div>
      <% elsif order.freight_miles_source == :gps %>
        <div class="form-text mt-n2 mb-3">Miles ≈ <%= miles.round %> estimated from GPS (straight line × <%= Freight::Distance::ROAD_FACTOR %>). <%= link_to 'Add a lane', location_path(order.location, tab: 'freight') %> or type the real miles.</div>
      <% end %>

      <% if charges.any?(&:dispatch_id) %>
        <div class="alert alert-info py-2 small">
          The carrier prices this load per dispatch: its cost here is this order's share by gallons, from
          <%= link_to "Dispatch ##{charges.find(&:dispatch_id).dispatch_id}", dispatch_path(charges.find(&:dispatch_id).dispatch_id, anchor: 'freight') %>.
        </div>
      <% end %>
      <div class="row g-4">
        <% { 'sale' => 'Charged to customer', 'purchase' => 'Carrier cost' }.each do |side, heading| %>
          <% side_charges = charges.select { |c| c.side == side } %>
          <div class="col-lg-6">
            <h6 class="text-uppercase small text-muted fw-semibold"><%= heading %></h6>
            <table class="table table-sm align-middle mb-0">
              <thead class="table-light">
                <tr><th>Charge</th><th>Basis</th><th class="text-end">Qty</th><th class="text-end">Rate</th><th class="text-end">Amount</th><th></th></tr>
              </thead>
              <tbody>
                <% side_charges.each do |charge| %>
                  <tr>
                    <td>
                      <%= charge.label %>
                      <div class="small text-muted">
                        <% if charge.freight_rule %>
                          <%= link_to charge.freight_rule.name, edit_freight_rule_path(charge.freight_rule), class: 'text-muted' %>
                        <% else %>Manual<% end %>
                        <% if charge.carrier %> · <%= charge.carrier.name %><% end %>
                      </div>
                    </td>
                    <td class="small"><%= charge.basis_label || '—' %></td>
                    <td class="text-end small"><%= charge.quantity ? number_with_precision(charge.quantity, precision: 2, strip_insignificant_zeros: true, delimiter: ',') : '—' %></td>
                    <td class="text-end small">
                      <% if charge.rate %>
                        <%= %w[percent markup].include?(charge.basis) ? "#{number_with_precision(charge.rate, precision: 2, strip_insignificant_zeros: true)}%" : number_with_precision(charge.rate, precision: 4, strip_insignificant_zeros: true) %>
                      <% else %>—<% end %>
                    </td>
                    <td class="text-end"><%= number_to_currency(charge.amount) %></td>
                    <td class="text-end">
                      <%= button_to '✕', customer_order_freight_charge_path(order, charge), method: :delete,
                                    class: 'btn btn-outline-danger btn-sm py-0', form: { data: { turbo: false } },
                                    title: charge.calculated? ? 'Remove (comes back on the next calculation)' : 'Remove' %>
                    </td>
                  </tr>
                <% end %>
                <% if side_charges.empty? %>
                  <tr><td colspan="6" class="text-muted small">None.</td></tr>
                <% end %>
              </tbody>
              <tfoot>
                <tr class="fw-semibold">
                  <td colspan="4" class="text-end">Total</td>
                  <td class="text-end"><%= number_to_currency(side_charges.sum(&:amount)) %></td>
                  <td></td>
                </tr>
              </tfoot>
            </table>
          </div>
        <% end %>
      </div>

      <% sale_total = charges.select { |c| c.side == 'sale' }.sum(&:amount) %>
      <% cost_total = charges.select { |c| c.side == 'purchase' }.sum(&:amount) %>
      <div class="d-flex flex-wrap gap-4 mt-3 p-2 bg-light rounded small">
        <div><span class="text-muted">Freight revenue</span> <strong><%= number_to_currency(sale_total) %></strong></div>
        <div><span class="text-muted">Carrier cost</span> <strong><%= number_to_currency(cost_total) %></strong></div>
        <div>
          <span class="text-muted">Freight margin</span>
          <strong class="<%= (sale_total - cost_total).negative? ? 'text-danger' : 'text-success' %>"><%= number_to_currency(sale_total - cost_total) %></strong>
          <% if sale_total.positive? %><span class="text-muted">(<%= number_to_percentage((sale_total - cost_total) / sale_total * 100, precision: 1) %>)</span><% end %>
        </div>
        <% if order.billed_freight_lines.any? %>
          <div title="Freight lines PDI put on this order; the calculated freight isn't added to the order total">
            <span class="text-muted">PDI billed freight</span> <strong><%= number_to_currency(order.billed_freight_total) %></strong>
            <% if sale_total.positive? %><span class="text-muted">(calculated is <%= number_to_currency(sale_total - order.billed_freight_total) %> vs PDI)</span><% end %>
          </div>
        <% end %>
        <% if order.freight_in_price? && sale_total.positive? %>
          <div><span class="text-muted">Rolled into price</span> <strong>+<%= number_to_currency(order.freight_per_unit, precision: 4) %>/unit</strong></div>
        <% end %>
      </div>

      <details class="mt-3">
        <summary class="small fw-semibold">Add a freight charge by hand (warehouse goods, a carrier quote)</summary>
        <%= form_with model: OrderFreightCharge.new, url: customer_order_freight_charges_path(order), local: true,
                      data: { turbo: false }, class: 'row g-2 align-items-end mt-1' do |f| %>
          <div class="col-md-2">
            <label class="form-label small mb-1">Side</label>
            <%= f.select :side, [['Carrier cost', 'purchase'], ['Charge customer', 'sale']], {}, class: 'form-select form-select-sm', id: 'manual_freight_side' %>
          </div>
          <div class="col-md-2">
            <label class="form-label small mb-1">Charge</label>
            <%= f.select :charge_type, FreightRule::CHARGE_TYPES.invert, {}, class: 'form-select form-select-sm' %>
          </div>
          <div class="col-md-2">
            <label class="form-label small mb-1">Description</label>
            <%= f.text_field :description, class: 'form-control form-control-sm', placeholder: 'e.g. LTL – 3 pallets' %>
          </div>
          <div class="col-md-3" data-freight-side="purchase">
            <label class="form-label small mb-1">Carrier</label>
            <%= f.collection_select :carrier_id, @carriers, :id, :label, { include_blank: '—', selected: order.freight_carrier_vendor_id },
                                    class: 'form-select form-select-sm js-select2' %>
          </div>
          <div class="col-md-1">
            <label class="form-label small mb-1">Amount</label>
            <%= f.number_field :amount, class: 'form-control form-control-sm', step: '0.01' %>
          </div>
          <div class="col-md-1" data-freight-side="sale" style="display: none;">
            <label class="form-label small mb-1" title="Instead of an amount: the carrier cost plus this markup">or cost +%</label>
            <%= f.number_field :markup_percent, class: 'form-control form-control-sm', step: 'any' %>
          </div>
          <div class="col-md-1 d-grid"><%= f.submit 'Add', class: 'btn btn-outline-primary btn-sm' %></div>
        <% end %>
      </details>

      <% payables = order.freight_payables.includes(:vendor).to_a %>
      <% if payables.any? %>
        <div class="mt-3 small">
          <span class="fw-semibold">Payables:</span>
          <% payables.each do |p| %>
            <span class="ms-2">
              <%= link_to p.vendor.name, freight_payables_path(status: 'all', vendor_id: p.vendor_id) %>
              <%= number_to_currency(p.balance) %>
              <span class="badge bg-<%= p.invoiced? ? 'success' : 'warning text-dark' %>"><%= p.status %></span>
              <% if p.intercompany? %><span class="badge bg-info-subtle text-info-emphasis">intercompany</span><% end %>
            </span>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
<%= render 'shared/select2_init' %>
<script>
  (function () {
    var side = document.getElementById('manual_freight_side');
    if (!side) return;
    function toggle() {
      document.querySelectorAll('[data-freight-side]').forEach(function (el) {
        el.style.display = el.dataset.freightSide === side.value ? '' : 'none';
      });
    }
    side.addEventListener('change', toggle);
    toggle();
  })();
</script>
