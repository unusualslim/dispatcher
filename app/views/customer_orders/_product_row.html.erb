<tr class="product-row">
  <td>
    <select name="customer_order[customer_order_products_attributes][<%= index %>][product_id]"
            class="form-select form-select-sm co-product-select">
      <option value="">— Select product —</option>
      <% Product.selectable(cop.product_id).order(:name).each do |p| %>
        <option value="<%= p.id %>" data-weight="<%= p.weight.to_f %>" <%= 'selected' if cop.product_id.to_s == p.id.to_s %>><%= p.name %></option>
      <% end %>
    </select>
  </td>
  <td>
    <input type="number" step="any" min="0"
           name="customer_order[customer_order_products_attributes][<%= index %>][quantity]"
           class="form-control form-control-sm product-qty-input"
           placeholder="0"
           value="<%= cop.quantity %>">
  </td>
  <% weight = cop.quantity.to_f * (cop.product&.weight&.to_f || 0) %>
  <td class="product-weight-display text-muted small align-middle">
    <%= weight > 0 ? "#{number_with_delimiter(weight.round(1))} lb" : "—" %>
  </td>
  <td>
    <div class="input-group input-group-sm">
      <span class="input-group-text">$</span>
      <input type="number" step="0.0001" min="0"
             name="customer_order[customer_order_products_attributes][<%= index %>][price]"
             class="form-control product-price-input"
             placeholder="0.00"
             value="<%= cop.price %>">
    </div>
    <% if cop.quote_product %>
      <div class="pricing-rule-hint text-muted small mt-1">
        Locked: <%= link_to cop.quote_product.quote.quote_number, quote_path(cop.quote_product.quote), target: '_blank' %>
      </div>
    <% elsif cop.pricing_rule %>
      <div class="pricing-rule-hint text-muted small mt-1">From: <%= cop.pricing_rule.name %></div>
    <% end %>
  </td>
  <td>
    <input type="hidden" name="customer_order[customer_order_products_attributes][<%= index %>][id]" value="<%= cop.id %>">
    <input type="hidden" name="customer_order[customer_order_products_attributes][<%= index %>][quote_product_id]" value="<%= cop.quote_product_id %>" class="price-source-quote">
    <input type="hidden" name="customer_order[customer_order_products_attributes][<%= index %>][pricing_rule_id]" value="<%= cop.pricing_rule_id %>" class="price-source-rule">
    <input type="hidden" name="customer_order[customer_order_products_attributes][<%= index %>][_destroy]" value="0" class="destroy-flag">
    <button type="button" class="btn btn-sm btn-outline-danger remove-product-row" title="Remove">
      &times;
    </button>
  </td>
</tr>
