<div class="container mt-4" style="max-width: 680px;">
  <h1>Preview: <%= FeedTank::FEEDS[@feed] %></h1>
  <p class="text-muted"><%= @upload[:file_name] %></p>
  <table class="table table-sm mt-3" style="max-width: 460px;">
    <tbody>
      <tr><td>Rows in the file</td><td class="text-end fw-semibold"><%= number_with_delimiter(@summary.rows) %></td></tr>
      <tr><td>Feed tanks in the file</td><td class="text-end"><%= number_with_delimiter(@summary.feed_tanks) %></td></tr>
      <tr><td>New feed tanks (to set up or ignore)</td><td class="text-end"><%= number_with_delimiter(@summary.new_feed_tanks) %></td></tr>
      <tr class="table-success"><td><strong>New readings</strong></td><td class="text-end fw-semibold"><%= number_with_delimiter(@summary.new_readings) %></td></tr>
      <tr><td>Already stored (skipped)</td><td class="text-end"><%= number_with_delimiter(@summary.duplicates) %></td></tr>
      <tr><td>Ignored tanks' rows (skipped)</td><td class="text-end"><%= number_with_delimiter(@summary.ignored) %></td></tr>
      <% if @summary.unreadable.positive? %>
        <tr class="table-warning"><td>No readable time or level (skipped)</td><td class="text-end"><%= number_with_delimiter(@summary.unreadable) %></td></tr>
      <% end %>
      <tr><td>Newest reading</td><td class="text-end"><%= reading_time(@summary.newest_read_at) %></td></tr>
    </tbody>
  </table>

  <%= form_with url: tank_feed_import_path, method: :post, data: { turbo: false } do |f| %>
    <div class="d-flex gap-2">
      <%= f.submit 'Confirm Import', class: 'btn btn-success', disabled: @summary.rows.zero? %>
      <%= link_to 'Cancel', new_tank_feed_import_path, class: 'btn btn-outline-secondary' %>
    </div>
  <% end %>
</div>
