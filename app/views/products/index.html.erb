<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Products</h1>
  <div class="d-flex gap-2 align-items-center">
    <button type="button" class="btn btn-success btn-sm d-none" id="create-po-selected">
      Create PO for Selected (<span id="selected-count">0</span>)
    </button>
    <%= link_to 'MRP Dashboard', mrp_path, class: 'btn btn-outline-primary btn-sm' %>
    <%= link_to 'New Product', new_product_path, class: 'btn btn-primary btn-sm' %>
  </div>
</div>

<%# Search + filters %>
<div class="card shadow-sm mb-3">
  <div class="card-body py-2">
    <%= form_with url: products_path, method: :get, local: true,
          data: { turbo_frame: "products-results" } do |f| %>
      <div class="d-flex gap-2 flex-wrap align-items-center">
        <div class="input-group" style="max-width: 280px;">
          <%= f.text_field :query, value: params[:query], placeholder: 'Search products…',
                class: 'form-control form-control-sm', id: 'product-search',
                autocomplete: 'off' %>
        </div>

        <% active_type = params[:type].presence || 'finished' %>
        <select name="type" class="form-select form-select-sm" style="max-width: 160px;" onchange="this.form.requestSubmit()">
          <option value="all"     <%= 'selected' if active_type == 'all' %>>All Types</option>
          <option value="finished" <%= 'selected' if active_type == 'finished' %>>Finished Goods</option>
          <option value="raw"      <%= 'selected' if active_type == 'raw' %>>Raw Materials</option>
        </select>

        <select name="category" class="form-select form-select-sm" style="max-width: 200px;" onchange="this.form.requestSubmit()">
          <option value="">All Categories</option>
          <% @categories.each do |cat| %>
            <option value="<%= cat %>" <%= 'selected' if params[:category] == cat %>><%= cat %></option>
          <% end %>
        </select>

        <select name="status" class="form-select form-select-sm" style="max-width: 160px;" onchange="this.form.requestSubmit()">
          <option value="">All Statuses</option>
          <option value="critical" <%= 'selected' if params[:status] == 'critical' %>>Critical</option>
          <option value="low"      <%= 'selected' if params[:status] == 'low' %>>Low</option>
          <option value="ok"       <%= 'selected' if params[:status] == 'ok' %>>OK</option>
        </select>

        <div class="form-check form-check-inline mb-0">
          <%= f.check_box :in_stock, { checked: params[:in_stock] == '1', class: 'form-check-input', onchange: 'this.form.requestSubmit()' }, '1', '0' %>
          <label class="form-check-label small" for="product_in_stock">In stock only</label>
        </div>

        <% if params[:query].present? || params[:type].present? || params[:category].present? || params[:status].present? || params[:sort].present? || params[:in_stock].present? %>
          <%= link_to 'Clear', products_path, class: 'btn btn-outline-danger btn-sm' %>
        <% end %>

        <%= f.hidden_field :sort, value: params[:sort] %>
      </div>
    <% end %>
  </div>
</div>

<%# helper for sortable column headers %>
<% sort_url = ->(col) {
  products_path(query: params[:query], type: params[:type], category: params[:category], status: params[:status], in_stock: params[:in_stock], sort: col)
} %>

<turbo-frame id="products-results" data-turbo-action="advance">
  <% if @products.empty? %>
    <div class="text-center text-muted py-5">No products match your filters.</div>
  <% else %>
    <div class="text-muted small mb-2"><%= @products.total_entries %> product<%= 's' unless @products.total_entries == 1 %> found</div>
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead class="table-light">
          <tr>
            <th style="width:32px">
              <input type="checkbox" class="form-check-input" id="select-all-products">
            </th>
            <th>ID</th>
            <th><%= link_to "Name", sort_url.call(params[:sort] == 'name_asc' ? 'name_desc' : 'name_asc'), class: 'text-decoration-none text-dark' %></th>
            <th><%= link_to "Category", sort_url.call(params[:sort] == 'category_asc' ? 'category_desc' : 'category_asc'), class: 'text-decoration-none text-dark' %></th>
            <th>Type</th>
            <th>Unit</th>
            <th><%= link_to current_warehouse ? "On Hand (#{current_warehouse.company_name})" : "On Hand", sort_url.call(params[:sort] == 'stock_asc' ? 'stock_desc' : 'stock_asc'), class: 'text-decoration-none text-dark' %></th>
            <th>On Order</th>
            <th>Committed</th>
            <th>Available</th>
            <th>Reorder Point</th>
            <th><%= link_to "Cost/Unit", sort_url.call('cost'), class: 'text-decoration-none text-dark' %></th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @products.each do |product| %>
            <% bom_lines = product.instance_variable_get(:@bom_lines) %>
            <tr class="product-main-row" data-product-id="<%= product.id %>" style="cursor:pointer;">
              <td>
                <input type="checkbox" class="form-check-input product-select" value="<%= product.id %>">
              </td>
              <td><code class="small"><%= product.id %></code></td>
              <td>
                <div class="d-flex align-items-center gap-2">
                  <button class="btn btn-link p-0 product-expand-btn" data-product-id="<%= product.id %>" style="color:#6c757d;line-height:1;" title="Expand">
                    <i class="bi bi-chevron-right" style="font-size:.75rem;transition:transform .2s;"></i>
                  </button>
                  <%= link_to product.name, product_path(product), class: "text-decoration-none fw-semibold", data: { turbo_frame: "_top" } %>
                </div>
              </td>
              <td><span class="badge bg-secondary"><%= product.category.presence || '—' %></span></td>
              <td>
                <% if product.is_raw_material? %>
                  <span class="badge bg-secondary">Raw Material</span>
                <% else %>
                  <span class="badge bg-info text-dark">Finished Good</span>
                <% end %>
              </td>
              <td class="text-muted"><%= product.unit_of_measurement %></td>
              <% wh_stock    = product.warehouse_on_hand.to_d %>
              <% wh_avail   = wh_stock + product.on_order_qty - product.committed_qty %>
              <% wh_status  = if product.reorder_point.nil?
                                 :unknown
                               elsif (wh_stock + product.on_order_qty) < product.committed_qty
                                 :critical
                               elsif wh_stock <= product.reorder_point
                                 :low
                               else
                                 :ok
                               end %>
              <td><%= number_with_precision(wh_stock, precision: 1) %></td>
              <td class="text-success"><%= number_with_precision(product.on_order_qty, precision: 1) %></td>
              <td class="text-warning"><%= number_with_precision(product.committed_qty, precision: 1) %></td>
              <td class="<%= wh_avail < 0 ? 'text-danger fw-bold' : '' %>">
                <%= number_with_precision(wh_avail, precision: 1) %>
              </td>
              <td><%= product.reorder_point ? number_with_precision(product.reorder_point, precision: 1) : '—' %></td>
              <td><%= product.cost_per_unit ? number_to_currency(product.cost_per_unit) : '—' %></td>
              <td>
                <% if wh_status == :critical %>
                  <span class="badge bg-danger">Critical</span>
                <% elsif wh_status == :low %>
                  <span class="badge bg-warning text-dark">Low</span>
                <% elsif wh_status == :ok %>
                  <span class="badge bg-success">OK</span>
                <% else %>
                  <span class="badge bg-light text-muted">—</span>
                <% end %>
              </td>
              <td>
                <div class="d-flex gap-1">
                  <%= link_to 'Edit', edit_product_path(product), class: 'btn btn-warning btn-sm', data: { turbo_frame: "_top" } %>
                  <%= link_to 'Adjust', new_inventory_adjustment_path(product_id: product.id), class: 'btn btn-outline-secondary btn-sm' %>
                  <%= button_to 'Delete', product_path(product),
                        method: :delete,
                        data: { confirm: 'Are you sure?' },
                        class: 'btn btn-danger btn-sm',
                        form: { style: 'display: inline;' } %>
                </div>
              </td>
            </tr>
            <tr class="product-detail-row d-none" id="detail-<%= product.id %>">
              <td colspan="14" class="p-0">
                <div class="border-top border-bottom bg-light px-4 py-3" style="font-size:.85rem;">
                  <div class="row g-3">
                    <div class="col-md-6">
                      <div class="fw-semibold mb-2"><i class="bi bi-diagram-3 me-1"></i>Bill of Materials</div>
                      <% if bom_lines.any? %>
                        <table class="table table-sm mb-0" style="font-size:.82rem;">
                          <thead class="table-light">
                            <tr><th>Component</th><th>Qty / Unit</th><th>UOM</th></tr>
                          </thead>
                          <tbody>
                            <% bom_lines.each do |line| %>
                              <tr>
                                <td><%= line.component_product&.name || line.component_product_id %></td>
                                <td><%= number_with_precision(line.quantity_per_unit, precision: 4, strip_insignificant_zeros: true) %></td>
                                <td class="text-muted"><%= line.uom.presence || '—' %></td>
                              </tr>
                            <% end %>
                          </tbody>
                        </table>
                      <% else %>
                        <span class="text-muted fst-italic">No BOM defined</span>
                      <% end %>
                    </div>
                    <div class="col-md-3">
                      <div class="fw-semibold mb-2"><i class="bi bi-info-circle me-1"></i>Details</div>
                      <div class="text-muted">Safety Stock: <strong><%= product.safety_stock.present? ? number_with_precision(product.safety_stock, precision: 1) : '—' %></strong></div>
                      <div class="text-muted">Max Stock: <strong><%= product.max_stock.present? ? number_with_precision(product.max_stock, precision: 1) : '—' %></strong></div>
                      <div class="text-muted">PDI Code: <strong><%= product.pdi_package_code.presence || '—' %></strong></div>
                      <div class="text-muted">PDI Tank ID: <strong><%= product.pdi_tank_id.presence || '—' %></strong></div>
                    </div>
                    <div class="col-md-3 d-flex align-items-start gap-2 pt-4">
                      <%= link_to 'View', product_path(product), class: 'btn btn-outline-primary btn-sm', data: { turbo_frame: '_top' } %>
                      <%= link_to 'Edit', edit_product_path(product), class: 'btn btn-warning btn-sm', data: { turbo_frame: '_top' } %>
                    </div>
                  </div>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if @products.total_pages > 1 %>
      <nav class="d-flex justify-content-center mt-3">
        <%= will_paginate @products,
              renderer: BootstrapPaginationRenderer,
              params: { query: params[:query], type: params[:type], category: params[:category],
                        status: params[:status], sort: params[:sort] } %>
      </nav>
    <% end %>
  <% end %>
</turbo-frame>

<script>
  (function() {
    // Search debounce
    var input = document.getElementById('product-search');
    if (input) {
      var timer;
      input.addEventListener('input', function() {
        clearTimeout(timer);
        timer = setTimeout(function() { input.closest('form').requestSubmit(); }, 300);
      });
    }

    // Multi-select PO creation — persists across turbo-frame re-renders
    const selectedIds = new Set();

    function updateButton() {
      const btn      = document.getElementById('create-po-selected');
      const countEl  = document.getElementById('selected-count');
      if (!btn) return;
      countEl.textContent = selectedIds.size;
      btn.classList.toggle('d-none', selectedIds.size === 0);
    }

    function bindCheckboxes() {
      const selectAll = document.getElementById('select-all-products');
      const checkboxes = document.querySelectorAll('.product-select');

      // Restore checked state after frame re-render
      checkboxes.forEach(cb => { cb.checked = selectedIds.has(cb.value); });
      if (selectAll) selectAll.checked = checkboxes.length > 0 && Array.from(checkboxes).every(cb => cb.checked);

      selectAll?.addEventListener('change', function() {
        checkboxes.forEach(cb => {
          cb.checked = this.checked;
          this.checked ? selectedIds.add(cb.value) : selectedIds.delete(cb.value);
        });
        updateButton();
      });

      checkboxes.forEach(cb => cb.addEventListener('change', function() {
        this.checked ? selectedIds.add(this.value) : selectedIds.delete(this.value);
        if (selectAll) selectAll.checked = Array.from(checkboxes).every(c => c.checked);
        updateButton();
      }));
    }

    // Initial bind
    bindCheckboxes();

    document.getElementById('create-po-selected')?.addEventListener('click', function() {
      const params = Array.from(selectedIds).map(id => `product_ids[]=${id}`).join('&');
      window.location.href = '<%= new_purchase_order_path %>?' + params;
    });

    // Expandable product rows — delegated so it survives Turbo frame re-renders
    function toggleProduct(id) {
      const detailRow = document.getElementById('detail-' + id);
      if (!detailRow) return;
      const btn = document.querySelector('.product-expand-btn[data-product-id="' + id + '"]');
      const icon = btn?.querySelector('i');
      const isOpen = !detailRow.classList.contains('d-none');
      detailRow.classList.toggle('d-none', isOpen);
      if (icon) icon.style.transform = isOpen ? '' : 'rotate(90deg)';
    }

    document.addEventListener('click', function(e) {
      const expandBtn = e.target.closest('.product-expand-btn');
      if (expandBtn) {
        e.stopPropagation();
        toggleProduct(expandBtn.dataset.productId);
        return;
      }
      const mainRow = e.target.closest('.product-main-row');
      if (mainRow && !e.target.closest('a, button, input')) {
        toggleProduct(mainRow.dataset.productId);
      }
    });

    document.addEventListener('turbo:frame-render', function(e) {
      if (e.target.id === 'products-results') { bindCheckboxes(); updateButton(); }
    });
  })();
</script>
