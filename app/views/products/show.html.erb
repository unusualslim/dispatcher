<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h1 class="mb-0"><%= @product.name %></h1>
      <div class="text-muted small">Product ID: <%= @product.id %></div>
      <div class="text-muted small">Last updated: <%= @product.updated_at.strftime("%B %-d, %Y at %-I:%M %p") %></div>
    </div>
    <%= link_to "Back", products_path, class: "btn btn-outline-secondary btn-sm" %>
  </div>

  <%# MRP inventory card %>
  <div class="card shadow-sm mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
      <span class="fw-semibold">Inventory & MRP</span>
      <% if @product.is_raw_material? %>
        <span class="badge bg-secondary">Raw Material</span>
      <% else %>
        <span class="badge bg-info text-dark">Finished Good</span>
      <% end %>
    </div>
    <div class="card-body">
      <div class="row g-3 text-center">
        <div class="col-3">
          <div class="text-muted small">Current Stock</div>
          <div class="fs-5 fw-bold"><%= number_with_precision(@product.current_stock, precision: 1) %> <%= @product.unit_of_measurement %></div>
        </div>
        <div class="col-3">
          <div class="text-muted small">Available</div>
          <div class="fs-5 fw-bold"><%= number_with_precision(@product.available_stock, precision: 1) %></div>
        </div>
        <div class="col-3">
          <div class="text-muted small">Reorder Point</div>
          <div class="fs-5 fw-bold"><%= @product.reorder_point ? number_with_precision(@product.reorder_point, precision: 1) : '—' %></div>
        </div>
        <div class="col-3">
          <div class="text-muted small">Safety Stock</div>
          <div class="fs-5 fw-bold"><%= number_with_precision(@product.safety_stock, precision: 1) %></div>
        </div>
        <div class="col-3">
          <div class="text-muted small">Max Stock</div>
          <div class="fs-5 fw-bold"><%= @product.max_stock ? number_with_precision(@product.max_stock, precision: 1) : '—' %></div>
        </div>
      </div>
      <% status = @product.stock_status %>
      <% if status != :unknown %>
        <div class="mt-3 text-center">
          <% if status == :critical %>
            <span class="badge bg-danger fs-6">CRITICAL — Below Safety Stock</span>
          <% elsif status == :low %>
            <span class="badge bg-warning text-dark fs-6">LOW — At or Below Reorder Point</span>
          <% else %>
            <span class="badge bg-success fs-6">Stock OK</span>
          <% end %>
        </div>
      <% end %>
      <div class="mt-3 d-flex gap-2 justify-content-end">
        <%= link_to 'Edit Settings', edit_product_path(@product), class: 'btn btn-sm btn-outline-secondary' %>
        <%= link_to 'Adjust Stock', new_inventory_adjustment_path(product_id: @product.id), class: 'btn btn-sm btn-outline-warning' %>
        <%= link_to 'Create Purchase Order', new_purchase_order_path(product_id: @product.id), class: 'btn btn-sm btn-outline-primary' %>
      </div>
    </div>
  </div>

  <%# Standard Cost %>
  <div class="card shadow-sm mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
      <span class="fw-semibold">Standard Cost</span>
      <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#standardCostModal">
        Update Standard Cost
      </button>
    </div>
    <div class="card-body">
      <div class="mb-3">
        <span class="text-muted small">Current:</span>
        <span class="fs-5 fw-bold ms-2">
          <% if @product.standard_cost.present? %>
            $<%= number_with_precision(@product.standard_cost, precision: 4) %>
          <% else %>
            <span class="text-muted fst-italic">Not set</span>
          <% end %>
        </span>
      </div>
      <% if @standard_cost_histories.any? %>
        <table class="table table-sm mb-0">
          <thead class="table-light">
            <tr><th>Amount</th><th>Effective Date</th><th>Set By</th><th>Recorded</th></tr>
          </thead>
          <tbody>
            <% @standard_cost_histories.each do |h| %>
              <tr>
                <td class="fw-semibold">$<%= number_with_precision(h.amount, precision: 4) %></td>
                <td><%= h.effective_date.strftime("%B %-d, %Y") %></td>
                <td class="text-muted small">
                  <%= h.created_by&.full_name || '—' %>
                  <% if h.notes.present? %><div class="text-warning-emphasis"><%= h.notes %></div><% end %>
                </td>
                <td class="text-muted small"><%= h.created_at.strftime("%b %-d, %Y") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="text-muted fst-italic mb-0 small">No history yet.</p>
      <% end %>
    </div>
  </div>

  <%# Standard Cost Modal %>
  <div class="modal fade" id="standardCostModal" tabindex="-1" aria-labelledby="standardCostModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-sm">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="standardCostModalLabel">Update Standard Cost</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <%= form_with url: product_standard_cost_histories_path(@product), method: :post, local: true do |f| %>
          <div class="modal-body">
            <div class="mb-3">
              <label class="form-label fw-semibold">New Standard Cost ($)</label>
              <input type="number" name="standard_cost_history[amount]" step="0.0001" min="0"
                     class="form-control" placeholder="0.0000" required>
            </div>
            <div class="mb-2">
              <label class="form-label fw-semibold">Effective Date</label>
              <input type="date" name="standard_cost_history[effective_date]"
                     class="form-control" value="<%= Date.today %>" required>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <%= f.submit "Save", class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%# Vendors %>
  <div class="card shadow-sm mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
      <span class="fw-semibold">Vendors</span>
      <%= link_to 'Edit', edit_product_path(@product), class: 'btn btn-sm btn-outline-secondary' %>
    </div>
    <div class="card-body">
      <% if @product_vendors.empty? %>
        <p class="text-muted mb-0 fst-italic">No vendors assigned. <%= link_to 'Assign vendors →', edit_product_path(@product) %></p>
      <% else %>
        <div class="d-flex flex-column gap-2">
          <% @product_vendors.each_with_index do |pv, i| %>
            <div class="d-flex align-items-center gap-2">
              <% if i == 0 %>
                <span class="badge bg-primary">Primary</span>
              <% else %>
                <span class="badge bg-secondary">Backup <%= i %></span>
              <% end %>
              <%= link_to pv.vendor.name, vendor_path(pv.vendor), class: 'fw-semibold text-decoration-none' %>
              <% if pv.vendor.lead_time_days.present? %>
                <span class="text-muted small">· <%= pv.vendor.lead_time_days %> day lead time</span>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <%# Open Purchase Orders %>
  <% if @open_purchase_orders.any? %>
    <div class="card shadow-sm mb-3">
      <div class="card-header fw-semibold">Open Purchase Orders</div>
      <div class="table-responsive">
        <table class="table table-sm mb-0">
          <thead class="table-light">
            <tr><th>#</th><th>Vendor</th><th>Qty</th><th>Status</th><th>Expected</th><th></th></tr>
          </thead>
          <tbody>
            <% @open_purchase_orders.each do |po| %>
              <% line_qty = po.line_items.find { |li| li.product_id == @product.id }&.quantity %>
              <tr>
                <td><%= link_to "##{po.id}", purchase_order_path(po), class: 'fw-semibold text-decoration-none' %></td>
                <td><%= po.vendor.name %></td>
                <td><%= line_qty ? "#{number_with_precision(line_qty, precision: 1)} #{@product.unit_of_measurement}" : '—' %></td>
                <td><span class="badge bg-secondary"><%= po.status.humanize %></span></td>
                <td><%= po.expected_delivery_date&.strftime("%b %-d, %Y") || '—' %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <%# Recent Inventory Transactions %>
  <div class="card shadow-sm mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
      <span class="fw-semibold">Recent Inventory Activity</span>
      <%= link_to 'Full History →', inventory_transactions_path(product_id: @product.id), class: 'btn btn-sm btn-outline-secondary' %>
    </div>
    <% if @recent_transactions.empty? %>
      <div class="card-body text-muted fst-italic" style="font-size:.9rem;">No transactions recorded yet.</div>
    <% else %>
      <div class="table-responsive">
        <table class="table table-sm mb-0">
          <thead class="table-light">
            <tr><th>Date</th><th>Direction</th><th>Qty</th><th>Notes</th><th>By</th></tr>
          </thead>
          <tbody>
            <% @recent_transactions.each do |tx| %>
              <tr>
                <td class="text-muted" style="font-size:.85rem;"><%= tx.created_at.strftime("%b %-d, %Y") %></td>
                <td>
                  <% if tx.direction == 'in' %>
                    <span class="badge bg-success">IN</span>
                  <% else %>
                    <span class="badge bg-danger">OUT</span>
                  <% end %>
                </td>
                <td><%= number_with_precision(tx.quantity, precision: 1) %></td>
                <td class="text-muted" style="font-size:.85rem;"><%= tx.notes.presence || '—' %></td>
                <td class="text-muted" style="font-size:.85rem;"><%= tx.created_by&.full_name || '—' %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>

  <div class="card shadow-sm">
    <div class="card-body">
      <h5 class="mb-3">Components (BOM)</h5>

      <% saved_components = @product.product_components.select(&:persisted?) %>
      <% saved_cost_lines = @product.product_cost_lines.select(&:persisted?) %>
      <% if saved_components.any? || saved_cost_lines.any? %>
        <div class="mb-4">
          <div class="fw-semibold mb-2">Standard Cost Rollup</div>
          <%= render 'bom_cost_rollup', components: saved_components, cost_lines: saved_cost_lines,
                                        repack_fee: @product.pdi_repack_fee %>
        </div>
      <% end %>

      <%= form_with model: @product, local: true do |f| %>
        <% if @product.errors.any? %>
          <div class="alert alert-danger">
            <strong><%= pluralize(@product.errors.count, "error") %> prevented saving:</strong>
            <ul class="mb-0">
              <% @product.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div id="bom-rows" class="d-flex flex-column gap-2">
          <%= f.fields_for :product_components do |pc| %>
            <div class="d-flex gap-2 align-items-center" data-bom-row="1">
              <%= pc.hidden_field :id if pc.object&.persisted? %>

              <% component = pc.object&.component_product %>
              <div style="flex: 2; min-width: 280px;">
                <%= pc.select :component_product_id,
                      options_for_select(component ? [["#{component.name} (#{component.id})", component.id]] : [], component&.id),
                      { include_blank: true },
                      class: "form-select bom-product-select" %>
              </div>

              <%= pc.number_field :quantity_per_unit,
                    step: 0.0001,
                    class: "form-control",
                    placeholder: "Qty / unit" %>

              <%= pc.text_field :uom,
                    class: "form-control",
                    placeholder: "UOM (e.g. GAL)" %>

              <div class="form-check ms-1">
                <%= pc.check_box :_destroy, class: "form-check-input" %>
                <%= pc.label :_destroy, "Remove", class: "form-check-label small" %>
              </div>
            </div>
          <% end %>
        </div>

        <button type="button" class="btn btn-sm btn-outline-secondary mt-3" id="add-bom-row">
          + Add Component
        </button>

        <hr class="my-4">
        <h6 class="mb-1">Non-Inventory Costs</h6>
        <p class="small text-muted mb-2">
          Costs absorbed into each unit of this product that aren't inventory items. Each line works out to
          <strong>Qty × Unit Cost ÷ Per</strong> per unit, and its reporting group decides the GL account.
        </p>
        <ul class="small text-muted mb-3">
          <li><strong>Pallet</strong>: Qty 1 × Unit Cost $13.40 ÷ Per 80 (cases on a pallet) = $0.1675 per case</li>
          <li><strong>Tape</strong>: Qty 30 (inches per case) × Unit Cost $21.09 (a roll) ÷ Per 35,984 (inches on a roll) = $0.0176</li>
          <li><strong>Labor</strong> (Labor group): Qty 1 (hour) ÷ Per 134 (cases one worker fills per hour). Unit Cost comes from the
            labor rate, <%= number_to_currency(AppSetting.labor_rate) %>/hr<%= link_to ' (change)', edit_costing_settings_path if admin? %>.</li>
        </ul>

        <div class="d-flex gap-2 align-items-end small text-muted fw-semibold mb-1" aria-hidden="true">
          <div style="flex: 1; min-width: 160px;">Description</div>
          <div style="width: 150px;">Reporting Group</div>
          <div style="width: 110px;" title="How many of the item one unit uses (e.g. 30 inches of tape, 1 hour of labor)">Qty</div>
          <div style="width: 120px;" title="Price of the item as bought (a pallet, a roll)">Unit Cost</div>
          <div style="width: 110px;" title="How many units that cost covers (cases per pallet, inches per roll, cases per worker-hour)">Per</div>
          <div style="width: 90px;" class="text-end">Cost / unit</div>
          <div style="width: 80px;"></div>
        </div>

        <div id="cost-line-rows" class="d-flex flex-column gap-2">
          <%= f.fields_for :product_cost_lines do |cl| %>
            <div class="d-flex gap-2 align-items-center" data-cost-line-row="1">
              <%= cl.hidden_field :id if cl.object&.persisted? %>
              <%= cl.text_field :description, class: "form-control", style: "flex: 1; min-width: 160px;", placeholder: "e.g. Pallet", "aria-label": "Description" %>
              <%= cl.collection_select :reporting_group_id, ReportingGroup.non_inventory.ordered, :id, :name, {}, class: "form-select", style: "width: 150px;", "aria-label": "Reporting group" %>
              <%= cl.number_field :quantity, step: "any", class: "form-control", style: "width: 110px;", placeholder: "Qty", "aria-label": "Qty" %>
              <%= cl.number_field :unit_cost, step: "any", class: "form-control", style: "width: 120px;", placeholder: "Unit cost", "aria-label": "Unit cost" %>
              <%= cl.number_field :per_quantity, step: "any", class: "form-control", style: "width: 110px;", placeholder: "Per", "aria-label": "Per" %>
              <div style="width: 90px;" class="text-end small" data-cost-per-unit></div>
              <div class="form-check ms-1" style="width: 80px;">
                <%= cl.check_box :_destroy, class: "form-check-input" %>
                <%= cl.label :_destroy, "Remove", class: "form-check-label small" %>
              </div>
            </div>
          <% end %>
        </div>

        <button type="button" class="btn btn-sm btn-outline-secondary mt-3" id="add-cost-line-row">
          + Add Cost
        </button>

        <div class="mt-3" style="max-width: 260px;">
          <%= f.label :pdi_repack_fee, "PDI Repack Fee (per unit)", class: "form-label small mb-1" %>
          <%= f.number_field :pdi_repack_fee, step: "any", class: "form-control" %>
          <div class="form-text">What PDI capitalizes per unit on repack; cleared by the GL export.</div>
        </div>

        <div class="mt-3">
          <%= f.submit "Save BOM & Costs", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
  window.costLineGroups = <%= ReportingGroup.non_inventory.ordered.map { |g| { id: g.id, name: g.name, labor: g.labor? } }.to_json.html_safe %>;
  window.laborRate = <%= AppSetting.labor_rate.to_f %>;
</script>

<script>
// Searchable component picker backed by /products/search (name or part number).
function initProductSearch(select) {
  if (!window.jQuery || !jQuery.fn.select2) return;
  var $select = jQuery(select);
  if ($select.data("select2")) return;
  $select.select2({
    theme: "bootstrap-5",
    placeholder: "Search components...",
    allowClear: true,
    width: "100%",
    ajax: {
      url: "<%= search_products_path %>",
      dataType: "json",
      delay: 200,
      data: function (params) { return { q: params.term || "" }; },
      processResults: function (data) { return { results: data }; }
    }
  });
}

document.addEventListener("turbo:load", function () {
  var container = document.getElementById("bom-rows");
  var addBtn    = document.getElementById("add-bom-row");
  if (!container || !addBtn) return;
  container.querySelectorAll(".bom-product-select").forEach(initProductSearch);
  if (addBtn.dataset.bound) return;
  addBtn.dataset.bound = "1";

  function nextIndex() {
    var max = -1;
    container.querySelectorAll('input, select').forEach(function (el) {
      var m = el.name && el.name.match(/\[product_components_attributes\]\[(\d+)\]/);
      if (m) max = Math.max(max, parseInt(m[1], 10));
    });
    return max + 1;
  }

  addBtn.addEventListener("click", function () {
    var idx  = nextIndex();
    var base = 'product[product_components_attributes][' + idx + ']';
    var html = '<div class="d-flex gap-2 align-items-center" data-bom-row="1">' +
      '<div style="flex: 2; min-width: 280px;">' +
        '<select class="form-select bom-product-select" name="' + base + '[component_product_id]"><option value=""></option></select>' +
      '</div>' +
      '<input class="form-control" type="number" step="0.0001" placeholder="Qty / unit" name="' + base + '[quantity_per_unit]" />' +
      '<input class="form-control" type="text" placeholder="UOM (e.g. GAL)" name="' + base + '[uom]" />' +
      '<div class="form-check ms-1">' +
        '<input class="form-check-input" type="checkbox" name="' + base + '[_destroy]" />' +
        '<label class="form-check-label small">Remove</label>' +
      '</div>' +
    '</div>';

    container.insertAdjacentHTML("beforeend", html);
    initProductSearch(container.lastElementChild.querySelector(".bom-product-select"));
  });
});

// Turbo cache safety: snapshot the plain selects, not the Select2 widgets.
document.addEventListener("turbo:before-cache", function () {
  if (!window.jQuery || !jQuery.fn.select2) return;
  jQuery(".bom-product-select").each(function () {
    if (jQuery(this).data("select2")) jQuery(this).select2("destroy");
  });
});

document.addEventListener("turbo:load", function () {
  var container = document.getElementById("cost-line-rows");
  var addBtn    = document.getElementById("add-cost-line-row");
  if (!container || !addBtn || addBtn.dataset.bound) return;
  addBtn.dataset.bound = "1";

  addBtn.addEventListener("click", function () {
    var max = -1;
    container.querySelectorAll('input, select').forEach(function (el) {
      var m = el.name && el.name.match(/\[product_cost_lines_attributes\]\[(\d+)\]/);
      if (m) max = Math.max(max, parseInt(m[1], 10));
    });
    var base = 'product[product_cost_lines_attributes][' + (max + 1) + ']';
    var groups = window.costLineGroups.map(function (g) {
      var opt = document.createElement('option');
      opt.value = g.id;
      opt.textContent = g.name;
      return opt.outerHTML;
    }).join('');
    var html = '<div class="d-flex gap-2 align-items-center" data-cost-line-row="1">' +
      '<input class="form-control" style="flex: 1; min-width: 160px;" type="text" placeholder="e.g. Pallet" aria-label="Description" name="' + base + '[description]" />' +
      '<select class="form-select" style="width: 150px;" aria-label="Reporting group" name="' + base + '[reporting_group_id]">' + groups + '</select>' +
      '<input class="form-control" style="width: 110px;" type="number" step="any" placeholder="Qty" aria-label="Qty" value="1" name="' + base + '[quantity]" />' +
      '<input class="form-control" style="width: 120px;" type="number" step="any" placeholder="Unit cost" aria-label="Unit cost" name="' + base + '[unit_cost]" />' +
      '<input class="form-control" style="width: 110px;" type="number" step="any" placeholder="Per" aria-label="Per" value="1" name="' + base + '[per_quantity]" />' +
      '<div style="width: 90px;" class="text-end small" data-cost-per-unit></div>' +
      '<div class="form-check ms-1" style="width: 80px;">' +
        '<input class="form-check-input" type="checkbox" value="1" name="' + base + '[_destroy]" />' +
        '<label class="form-check-label small">Remove</label>' +
      '</div>' +
    '</div>';
    container.insertAdjacentHTML("beforeend", html);
    refreshCostLine(container.lastElementChild);
  });
});

// Live Cost / unit for each line; Labor-group lines take their unit cost from the labor rate.
function refreshCostLine(row) {
  var field = function (attr) { return row.querySelector('[name$="[' + attr + ']"]'); };
  var group = window.costLineGroups.find(function (g) { return String(g.id) === field('reporting_group_id').value; });
  var labor = group && group.labor;
  var unitCost = field('unit_cost');
  unitCost.disabled = !!labor;
  unitCost.placeholder = labor ? '$' + window.laborRate.toFixed(2) + '/hr' : 'Unit cost';
  if (labor) unitCost.value = '';

  var qty = parseFloat(field('quantity').value), per = parseFloat(field('per_quantity').value);
  var cost = labor ? window.laborRate : parseFloat(unitCost.value);
  var out = row.querySelector('[data-cost-per-unit]');
  out.textContent = (qty > 0 && per > 0 && cost >= 0) ? '$' + (qty * cost / per).toFixed(4) : '';
}

document.addEventListener("turbo:load", function () {
  var container = document.getElementById("cost-line-rows");
  if (!container) return;
  container.querySelectorAll('[data-cost-line-row]').forEach(refreshCostLine);
  if (container.dataset.calcBound) return;
  container.dataset.calcBound = "1";
  ['input', 'change'].forEach(function (evt) {
    container.addEventListener(evt, function (e) {
      var row = e.target.closest('[data-cost-line-row]');
      if (row) refreshCostLine(row);
    });
  });
});
</script>