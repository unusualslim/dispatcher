<% sections = PdiMasterDataImportService::SECTIONS %>
<% groups = [
     [:create, 'New', 'success'], [:link, 'Linked to existing', 'primary'], [:update, 'Updated', 'info'],
     [:skip, 'Skipped', 'secondary'], [:error, 'Errors', 'danger']
   ] %>
<% row_limit = 500 %>

<div class="container-fluid px-4 mt-4">
  <div class="d-flex justify-content-between align-items-start mb-3">
    <div>
      <h1 class="mb-1">Preview PDI Master Data</h1>
      <p class="text-muted mb-0">Nothing has been saved yet. Review each section, then confirm.</p>
    </div>
    <%= link_to 'Cancel', new_pdi_master_data_import_path, class: 'btn btn-outline-secondary' %>
  </div>

  <div class="table-responsive mb-4">
    <table class="table table-sm table-bordered align-middle mb-0" style="max-width: 900px;">
      <thead class="table-light">
        <tr>
          <th></th>
          <% groups.each do |_, title, _| %><th class="text-end"><%= title %></th><% end %>
          <th class="text-end">Unchanged</th>
        </tr>
      </thead>
      <tbody>
        <% sections.each do |section, title| %>
          <tr>
            <th><%= title %></th>
            <% groups.each do |action, _, color| %>
              <% n = @result.count(section, action) %>
              <td class="text-end <%= "text-#{color} fw-semibold" if n.positive? %>"><%= n %></td>
            <% end %>
            <td class="text-end text-muted"><%= @result.count(section, :unchanged) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% sections.each do |section, title| %>
    <% groups.each do |action, group_title, color| %>
      <% rows = @result.for(section, action) %>
      <% next if rows.empty? %>
      <details class="card shadow-sm mb-3" <%= 'open' if action == :error %>>
        <summary class="card-header fw-semibold">
          <span class="badge bg-<%= color %> me-1"><%= rows.size %></span> <%= title %>: <%= group_title %>
        </summary>
        <div class="table-responsive" style="max-height: 480px;">
          <table class="table table-sm table-hover mb-0 small">
            <thead class="table-light">
              <tr><th>PDI ID</th><th>Name</th><th>Details</th></tr>
            </thead>
            <tbody>
              <% rows.first(row_limit).each do |row| %>
                <tr>
                  <td class="font-monospace text-nowrap"><%= row.key %></td>
                  <td><%= row.label %></td>
                  <td>
                    <% if row.note.present? %><span class="text-muted me-2"><%= row.note %></span><% end %>
                    <% row.changes.except(:pdi_customer_id, :pdi_terminal_id).each do |field, value| %>
                      <span class="badge bg-light text-dark border me-1"><%= field.to_s.humanize %>: <%= value %></span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
          <% if rows.size > row_limit %>
            <p class="small text-muted px-3 py-2 mb-0">Showing the first <%= row_limit %> of <%= rows.size %>.</p>
          <% end %>
        </div>
      </details>
    <% end %>
  <% end %>

  <%= form_with url: pdi_master_data_import_path, method: :post, data: { turbo: false } do |f| %>
    <div class="d-flex gap-2 mt-3 mb-5">
      <%= f.submit 'Confirm Import', class: 'btn btn-success btn-lg', data: { disable_with: 'Importing…' } %>
      <%= link_to 'Cancel', new_pdi_master_data_import_path, class: 'btn btn-outline-secondary btn-lg' %>
    </div>
  <% end %>
</div>
