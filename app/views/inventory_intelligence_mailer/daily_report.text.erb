Hi <%= @user.first_name %>,

Daily Inventory Intelligence Report — <%= @report.generated_at.strftime('%B %d, %Y') %>

STOCK OVERVIEW
  Total Products: <%= @report.stock_summary.total_products %>
  Critical: <%= @report.stock_summary.critical_count %> | Low: <%= @report.stock_summary.low_count %> | OK: <%= @report.stock_summary.ok_count %>
  Stock Value: <%= number_to_currency(@report.stock_summary.total_stock_value) %> | On Order: <%= number_to_currency(@report.stock_summary.total_on_order_value) %>

<% if @report.recommendations.any? %>
ACTION ITEMS
<% @report.recommendations.each do |rec| %>
  [<%= rec.priority.to_s.upcase %>] <%= rec.message %>
<% end %>
<% end %>

<% if @report.critical_items.any? %>
CRITICAL ITEMS
<% @report.critical_items.each do |item| %>
  <%= item.product.name %>: <%= item.current_stock %> on hand, <%= item.available %> available, <%= item.days_of_supply ? "#{item.days_of_supply} days supply" : 'N/A' %>
<% end %>
<% end %>

<% if @report.supply_pipeline.any? %>
INCOMING SUPPLY
<% @report.supply_pipeline.each do |s| %>
  PO #<%= s.purchase_order.display_number %> — <%= s.vendor&.name %> — <%= s.product&.name %> x<%= s.quantity %> — <%= s.expected_delivery_date&.strftime('%b %d') || 'No ETA' %>
<% end %>
<% end %>

This is an automated report from FPS Team.
