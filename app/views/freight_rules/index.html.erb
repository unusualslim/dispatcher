<%= render 'freight_rules/tabs', active: @tab %>

<% if @tab == 'lanes' %>
  <div class="row g-4">
    <div class="col-lg-7">
      <div class="card shadow-sm">
        <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
          Lanes (<%= @lanes.total_entries %>)
          <%= form_with url: freight_rules_path, method: :get, local: true do %>
            <%= hidden_field_tag :tab, 'lanes' %>
            <%= select_tag :origin_id, options_from_collection_for_select(@lane_origins, :id, :company_name, params[:origin_id]),
                           include_blank: 'All origins', class: 'form-select form-select-sm', onchange: 'this.form.submit()' %>
          <% end %>
        </div>
        <div class="table-responsive">
          <table class="table table-sm align-middle mb-0">
            <thead class="table-light"><tr><th>Origin</th><th>Destination</th><th class="text-end" style="width: 140px;">Standard miles</th><th></th></tr></thead>
            <tbody>
              <% @lanes.each do |lane| %>
                <tr>
                  <td><%= lane.origin_location.company_name %></td>
                  <td><%= link_to lane.destination_location.company_name, location_path(lane.destination_location, tab: 'freight') %></td>
                  <td class="text-end"><%= number_with_precision(lane.standard_miles, precision: 1, strip_insignificant_zeros: true) %></td>
                  <td class="text-end"><%= button_to '✕', freight_lane_path(lane), method: :delete, class: 'btn btn-outline-danger btn-sm py-0' %></td>
                </tr>
              <% end %>
              <% if @lanes.empty? %>
                <tr><td colspan="4" class="text-muted p-3">No lanes yet. Paste them on the right, or add them on a location's Freight tab.</td></tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
      <div class="mt-2"><%= will_paginate @lanes, renderer: BootstrapPaginationRenderer, params: { tab: 'lanes' } %></div>
    </div>
    <div class="col-lg-5">
      <div class="card shadow-sm">
        <div class="card-header fw-semibold">Paste lanes</div>
        <div class="card-body">
          <%= form_with url: import_freight_lanes_path, method: :post, local: true do %>
            <p class="small text-muted mb-2">
              One row per line, comma or tab separated: <code>origin, destination, miles</code>, using location IDs or
              exact names. New lanes are added and existing ones updated.
            </p>
            <%= text_area_tag :rows, nil, class: 'form-control font-monospace small mb-2', rows: 10 %>
            <%= submit_tag 'Import lanes', class: 'btn btn-outline-primary btn-sm' %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% elsif @tab == 'tables' %>
  <div class="card shadow-sm">
    <div class="table-responsive">
      <table class="table table-sm table-hover align-middle mb-0">
        <thead class="table-light">
          <tr><th>Table</th><th>Lookup</th><th class="text-end">Rates</th><th class="text-end">Rules using it</th><th>Notes</th></tr>
        </thead>
        <tbody>
          <% @tables.each do |table| %>
            <tr>
              <td><%= link_to table.name, freight_table_path(table), class: 'fw-semibold' %></td>
              <td><%= table.lookup_label %></td>
              <td class="text-end"><%= table.rates.size %></td>
              <td class="text-end"><%= @rule_counts[table.id].to_i %></td>
              <td class="small text-muted"><%= truncate(table.notes, length: 80) %></td>
            </tr>
          <% end %>
          <% if @tables.empty? %>
            <tr><td colspan="5" class="text-muted p-3">No freight tables yet. <%= link_to 'Add one', new_freight_table_path %>.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% else %>
  <div class="d-flex justify-content-end mb-2">
    <%= form_with url: freight_rules_path, method: :get, local: true do %>
      <label class="form-check-label small">
        <%= check_box_tag :show_inactive, '1', params[:show_inactive].present?, class: 'form-check-input', onchange: 'this.form.submit()' %>
        Show inactive
      </label>
    <% end %>
  </div>
  <% FreightRule::SIDES.each do |side, side_label| %>
    <% rules = @rules.select { |r| r.side == side } %>
    <div class="card shadow-sm mb-4">
      <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
        <%= side_label %>
        <%= link_to '+ Add', new_freight_rule_path(side: side), class: 'btn btn-outline-primary btn-sm' %>
      </div>
      <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
          <thead class="table-light">
            <tr><th>Rule</th><th>Charge</th><th>Applies to</th><th>Basis</th><th>Table</th><th>Effective</th><th></th></tr>
          </thead>
          <tbody>
            <% rules.each do |rule| %>
              <tr class="<%= 'text-muted' unless rule.active? %>">
                <td class="fw-semibold"><%= rule.name %><%= ' (inactive)' unless rule.active? %></td>
                <td><%= rule.charge_label %></td>
                <td class="small"><%= rule.selector_summary %></td>
                <td class="small">
                  <%= rule.basis_label %>
                  <% if rule.markup? %><span class="text-muted">(+<%= number_with_precision(rule.markup_percent, precision: 2, strip_insignificant_zeros: true) %>%)</span><% end %>
                  <% if rule.minimum_amount %><div class="text-muted">min <%= number_to_currency(rule.minimum_amount) %></div><% end %>
                  <% if rule.per_dispatch? %><div><span class="badge bg-info-subtle text-info-emphasis">Per dispatch, farthest stop</span></div><% end %>
                </td>
                <td class="small"><%= rule.freight_table ? link_to(rule.freight_table.name, freight_table_path(rule.freight_table)) : '—' %></td>
                <td class="small text-nowrap">
                  <%= rule.effective_from.strftime('%m/%d/%Y') %><%= " – #{rule.effective_to.strftime('%m/%d/%Y')}" if rule.effective_to %>
                </td>
                <td class="text-end text-nowrap">
                  <%= link_to 'Edit', edit_freight_rule_path(rule), class: 'btn btn-outline-secondary btn-sm' %>
                </td>
              </tr>
            <% end %>
            <% if rules.empty? %>
              <tr><td colspan="7" class="text-muted p-3">No <%= side %> rules.</td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
<% end %>
