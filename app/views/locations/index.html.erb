<script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.10.2/dist/umd/popper.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.min.js"></script>

<div class="content">
  <div class="mb-3" style="padding-top: 25px;">
    <%= form_with(url: locations_path, method: :get, local: true, class: "d-flex") do %>
      <%= text_field_tag :query, params[:query], placeholder: "Search locations...", class: "form-control me-2" %>
      <%= submit_tag "Search", class: "btn btn-primary" %>
      <%= link_to "Clear", locations_path, class: "btn btn-secondary ms-2" %>
    <% end %>
  </div>

  <p style="color: green"><%= notice %></p>
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Locations</h1>
    <div class="d-flex gap-2 align-items-center flex-wrap">
      <button type="button" class="btn btn-outline-secondary btn-sm d-none" id="export-selected-btn"
              data-export-url="<%= export_csv_locations_path %>">
        Export Selected (<span id="csv-selected-count">0</span>)
      </button>
      <%= link_to "Export All", export_csv_locations_path, class: "btn btn-outline-secondary btn-sm" %>
      <%= link_to "Import CSV", import_csv_locations_path, class: "btn btn-outline-primary btn-sm" %>
      <%= link_to "New Location", new_location_path, class: "btn btn-primary btn-sm" %>
    </div>
  </div>

  <!-- Origin Locations Section -->
  <div class="location-section card mb-4">
    <div class="card-header bg-light" style="font-weight: 600;">
      Origin Locations
    </div>
    <div class="card-body">
      <table class="table table-hover table-bordered align-middle">
        <thead class="table-light">
          <tr>
            <th style="width:32px;"><input type="checkbox" class="form-check-input location-select-all"></th>
            <th>Name</th>
            <th>Address</th>
            <th>City</th>
            <th>State</th>
            <th>Zip</th>
            <th>Phone</th>
            <th>Category</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% @locations.where(location_category_id: LocationCategory.find_by(name: 'Origin').id).each do |location| %>
            <tr class="<%= 'table-danger' if location.disabled? %>">
              <td onclick="event.stopPropagation();"><input type="checkbox" class="form-check-input bulk-row-select" value="<%= location.id %>"></td>
              <td style="cursor:pointer;" onclick="window.location='/locations/<%= location.id %>';"><%= location.company_name %></td>
              <td><%= location.address %></td>
              <td><%= location.city %></td>
              <td><%= location.state %></td>
              <td><%= location.zip %></td>
              <td><%= location.phone_number %></td>
              <td><%= LocationCategory.find(location.location_category_id).name %></td>
              <td><%= location.disabled? ? "Disabled" : "Enabled" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Destination & Prospective Locations Section -->
  <div class="location-section card">
    <div class="card-header bg-light" style="font-weight: 600;">
      Destination & Prospective Locations
    </div>
    <div class="card-body">
      <table class="table table-hover table-bordered align-middle">
        <thead class="table-light">
          <tr>
            <th style="width:32px;"><input type="checkbox" class="form-check-input location-select-all"></th>
            <th>Name</th>
            <th>Address</th>
            <th>City</th>
            <th>State</th>
            <th>Zip</th>
            <th>Phone</th>
            <th>Category</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% @locations.where(location_category_id: LocationCategory.where(name: ['Destination', 'Prospective']).pluck(:id)).each do |location| %>
            <tr class="<%= 'table-danger' if location.disabled? %>">
              <td onclick="event.stopPropagation();"><input type="checkbox" class="form-check-input bulk-row-select" value="<%= location.id %>"></td>
              <td style="cursor:pointer;" onclick="window.location='/locations/<%= location.id %>';"><%= location.company_name %></td>
              <td><%= location.address %></td>
              <td><%= location.city %></td>
              <td><%= location.state %></td>
              <td><%= location.zip %></td>
              <td><%= location.phone_number %></td>
              <td><%= LocationCategory.find(location.location_category_id).name %></td>
              <td><%= location.disabled? ? "Disabled" : "Enabled" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%= render 'shared/bulk_select_js' %>
<script>
// Wire each table's select-all header to the shared bulk toolbar
document.addEventListener('turbo:load', function() {
  document.querySelectorAll('.location-select-all').forEach(function(hdr) {
    hdr.addEventListener('change', function() {
      var table = hdr.closest('table');
      table.querySelectorAll('.bulk-row-select').forEach(function(cb) { cb.checked = hdr.checked; });
      var first = table.querySelector('.bulk-row-select');
      if (first) first.dispatchEvent(new Event('change', { bubbles: true }));
    });
  });
});
</script>