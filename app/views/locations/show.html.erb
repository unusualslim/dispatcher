<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<div class="content">
  <p style="color: green"><%= notice %></p>

  <%= render layout: 'shared/page_header',
             locals: { title: @location.company_name, subtitle: @location.full_address.strip.presence,
                       previous_path: (location_path(@previous_id) if @previous_id),
                       next_path: (location_path(@next_id) if @next_id) } do %>
    <%= link_to 'Edit', edit_location_path(@location), class: 'btn btn-warning btn-sm' %>
    <% if admin? %>
      <%= link_to 'Merge into…', new_location_merge_path(source_id: @location.id, return_to: 'location'),
                  class: 'btn btn-outline-secondary btn-sm' %>
    <% end %>
    <% if @location.disabled? %>
      <%= button_to 'Enable', toggle_status_location_path(@location), method: :patch, class: 'btn btn-outline-success btn-sm',
                    form: { data: { turbo_confirm: 'Enable this location?' } } %>
    <% else %>
      <%= button_to 'Disable', toggle_status_location_path(@location), method: :patch, class: 'btn btn-outline-warning btn-sm',
                    form: { data: { turbo_confirm: 'Disable this location?' } } %>
    <% end %>
    <%= link_to 'Back', locations_path, class: 'btn btn-outline-secondary btn-sm', data: { turbo: false } %>
    <%= button_to 'Delete', @location, method: :delete, class: 'btn btn-outline-danger btn-sm',
                  form: { data: { turbo: false }, onsubmit: "return confirm('Delete this location?')" } %>
  <% end %>

  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <div class="row">
        <div class="col-md-6">
          <p><strong>ID:</strong> <%= @location.id %></p>
          <p><strong>PDI Site Number:</strong> <%= @location.pdi_site_code.presence || "N/A" %></p>
          <p><strong>City:</strong> <%= @location.city.presence || "N/A" %></p>
          <p><strong>Address:</strong> <%= @location.address.presence || "N/A" %></p>
          <p><strong>State:</strong> <%= @location.state.presence || "N/A" %></p>
          <p><strong>Phone:</strong> <%= @location.phone_number.presence || "N/A" %></p>
          <p><strong>Category:</strong> <%= @location.location_category_id.presence || "N/A" %></p>
          <p><strong>Marker Color:</strong> <%= @location.marker_color.presence || "N/A" %></p>
          <p><strong>Latitude:</strong> <%= @location.latitude.presence || "N/A" %></p>
          <p><strong>Longitude:</strong> <%= @location.longitude.presence || "N/A" %></p>
        </div>

        <div class="col-md-6">
          <% if @location.latitude.present? && @location.longitude.present? %>
            <div
              id="location-map"
              style="height: 320px; width: 100%; border: 1px solid #ccc; border-radius: 8px;"
              data-lat="<%= @location.latitude %>"
              data-lng="<%= @location.longitude %>"
              data-name="<%= @location.company_name %>">
            </div>
          <% else %>
            <div class="alert alert-secondary mb-0">
              No map available because latitude or longitude is missing.
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <ul class="nav nav-tabs mb-3">
    <% { 'orders' => 'Customer Orders', 'products' => 'Products', 'customers' => 'Customers', 'freight' => 'Freight' }.each do |tab, label| %>
      <li class="nav-item">
        <%= link_to location_path(@location, tab: tab), class: "nav-link #{'active' if @tab == tab}" do %>
          <%= label %> <span class="badge rounded-pill bg-secondary ms-1"><%= @counts[tab] %></span>
        <% end %>
      </li>
    <% end %>
  </ul>

  <% if @tab == 'orders' %>
    <% if @orders.any? %>
      <table class="table table-striped">
        <thead>
          <tr>
            <th>Order ID</th>
            <th>Product</th>
            <th>Quantity</th>
            <th>Status</th>
            <th>Delivery Date</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @orders.each do |order| %>
            <% lines = order.customer_order_products %>
            <tr>
              <td><%= link_to order.id, customer_order_path(order) %></td>
              <td>
                <% if lines.any? %>
                  <%= lines.first.product&.name || lines.first.product_name %>
                  <% if lines.size > 1 %>
                    + <%= lines.size - 1 %> more
                  <% end %>
                <% else %>
                  No Products
                <% end %>
              </td>
              <td><%= lines.filter_map(&:quantity).presence&.sum || "Not Set" %></td>
              <td>
                <span class="badge bg-<%= order.order_status == 'New' ? 'success' : 'secondary' %>">
                  <%= order.order_status %>
                </span>
              </td>
              <td><%= order.required_delivery_date || "Not Set" %></td>
              <td>
                <%= link_to 'View', customer_order_path(order), class: 'btn btn-primary btn-sm' %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <%= will_paginate @orders, renderer: BootstrapPaginationRenderer, params: { tab: 'orders' } %>
    <% else %>
      <p class="text-muted">No customer orders associated with this location.</p>
    <% end %>

  <% elsif @tab == 'freight' %>
    <%= render 'freight_tab' %>

  <% elsif @tab == 'products' %>
    <% if @location_products.any? %>
      <table class="table table-striped">
        <thead>
          <tr>
            <th>Name</th>
            <th>Max Capacity</th>
            <th>Upper Cutoff</th>
            <th>Lower Cutoff</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @location_products.each do |location_product| %>
            <tr>
              <td><%= location_product.product&.name || location_product.product_id %></td>

              <td>
                <% if location_product.max_capacity.present? %>
                  <%= location_product.max_capacity %> gal
                <% else %>
                  N/A
                <% end %>
              </td>

              <td>
                <% if location_product.uleage_90.present? && location_product.max_capacity.present? %>
                  <%= (location_product.uleage_90.to_f / 100) * location_product.max_capacity %> gal
                  <strong>(<%= location_product.uleage_90 %>%)</strong>
                <% else %>
                  N/A
                <% end %>
              </td>

              <td>
                <% if location_product.cutoff.present? && location_product.max_capacity.present? %>
                  <%= (location_product.cutoff.to_f / 100) * location_product.max_capacity %> gal
                  <strong>(<%= location_product.cutoff %>%)</strong>
                <% else %>
                  N/A
                <% end %>
              </td>

              <td>
                <div class="btn-group" role="group">
                  <%= link_to 'Edit', edit_location_location_product_path(@location, location_product), class: 'btn btn-primary btn-sm', style: 'width:60px; margin-right:10px;' %>
                  <%= button_to 'Delete', location_location_product_path(@location, location_product), method: :delete, data: { confirm: 'Are you sure?' }, class: 'btn btn-danger btn-sm' %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <%= will_paginate @location_products, renderer: BootstrapPaginationRenderer, params: { tab: 'products' } %>
    <% else %>
      <p class="text-muted">No products at this location.</p>
    <% end %>
    <%= link_to 'Add Product', new_location_location_product_path(@location), class: 'btn btn-success' %>

  <% else %>
    <% if @customers.any? %>
      <div class="row">
        <% @customers.each do |customer| %>
          <div class="col-md-6">
            <div class="card mb-3">
              <div class="card-body">
                <h5 class="card-title">
                  <%= link_to customer.name, customer_path(customer), class: "text-decoration-none" %>
                </h5>
                <p class="card-text">
                  <strong>Email:</strong> <%= customer.email.presence || "No email provided" %><br>
                  <strong>Phone:</strong> <%= customer.phone.presence || "No phone provided" %>
                </p>
                <p class="text-muted">
                  <strong>Preferred Contact Method:</strong> <%= customer.preferred_contact_method %>
                </p>
                <%= link_to 'View Customer', customer_path(customer), class: 'btn btn-primary btn-sm' %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
      <%= will_paginate @customers, renderer: BootstrapPaginationRenderer, params: { tab: 'customers' } %>
    <% else %>
      <p class="text-muted">No customers associated with this location.</p>
    <% end %>
  <% end %>

</div>

<script>
  document.addEventListener("turbo:load", function () {
    const mapEl = document.getElementById("location-map");
    if (!mapEl) return;

    if (mapEl.dataset.loaded === "true") return;

    const lat = parseFloat(mapEl.dataset.lat);
    const lng = parseFloat(mapEl.dataset.lng);
    const name = mapEl.dataset.name || "Location";

    if (isNaN(lat) || isNaN(lng)) return;

    const map = L.map("location-map").setView([lat, lng], 13);

    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      attribution: "&copy; OpenStreetMap contributors",
      maxZoom: 19
    }).addTo(map);

    L.marker([lat, lng]).addTo(map)
      .bindPopup(name)
      .openPopup();

    mapEl.dataset.loaded = "true";

    setTimeout(function () {
      map.invalidateSize();
    }, 100);
  });
</script>