<header class="topbar d-flex align-items-center justify-content-between px-4" data-turbo="false">
  <!-- Mobile hamburger -->
  <button class="sidebar-toggle-btn d-lg-none me-3" id="sidebarToggle" type="button">
    <i class="bi bi-list fs-4"></i>
  </button>

  <div class="flex-grow-1"></div>

  <!-- Warehouse selector -->
  <% if user_signed_in? && !driver? %>
    <% warehouses = Location.where(location_category_id: 1).order(:company_name) %>
    <div class="dropdown me-2">
      <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
        <i class="bi bi-building me-1"></i>
        <%= current_warehouse&.company_name || "All Warehouses" %>
      </button>
      <ul class="dropdown-menu dropdown-menu-end">
        <li>
          <%= link_to set_warehouse_path(id: ''), class: "dropdown-item #{'fw-bold' if current_warehouse.nil?}" do %>
            <i class="bi bi-globe2 me-1"></i> All Warehouses
          <% end %>
        </li>
        <li><hr class="dropdown-divider"></li>
        <% warehouses.each do |w| %>
          <li>
            <%= link_to set_warehouse_path(id: w.id), class: "dropdown-item #{'fw-bold' if current_warehouse&.id == w.id}" do %>
              <i class="bi bi-building me-1"></i> <%= w.company_name %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Quick actions -->
  <div class="d-flex align-items-center gap-2">
    <% if user_signed_in? %>
      <% unless driver? %>
        <%= link_to "New Order", new_customer_order_path, class: "btn btn-success btn-sm" %>
        <%= link_to "New Dispatch", new_dispatch_path, class: "btn btn-primary btn-sm" %>
      <% end %>
    <% else %>
      <%= link_to 'Sign In', new_user_session_path, class: 'btn btn-outline-light btn-sm' %>
    <% end %>
  </div>
</header>
