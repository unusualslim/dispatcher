<% current = controller_name %>

<%# ── Active-section detection ──────────────────────────────────────────── %>
<% dispatch_active      = %w[customer_orders quotes dispatches calendar dispatch_messages].include?(current) ||
                          (current == 'locations' && action_name == 'map') %>
<% manufacturing_active = %w[production_orders warehouse work_orders jobs].include?(current) %>
<% inventory_active    = %w[mrp purchasing_report products purchase_orders
                             inventory_adjustments inventory_transactions].include?(current) %>
<% imports_active      = %w[customer_order_imports inventory_imports warehouse_transaction_imports
                             bom_imports min_max_imports vendor_freight_term_imports].include?(current) ||
                         (current == 'customer_order_products' && request.path == product_code_links_path) %>
<% masterdata_active   = %w[customers vendors users things].include?(current) ||
                         (current == 'locations' && action_name != 'map') %>
<% system_active       = %w[automated_processes docs announcements].include?(current) %>

<nav id="sidebar" class="sidebar d-flex flex-column">
  <!-- Brand -->
  <div class="sidebar-brand">
    <%= link_to dispatches_path do %>
      <span class="sidebar-brand-text">LoadNTrucks</span>
    <% end %>
    <button class="sidebar-close-btn d-lg-none" id="sidebarClose" type="button">
      <i class="bi bi-x-lg"></i>
    </button>
  </div>

  <div class="sidebar-body flex-grow-1">
    <% if user_signed_in? %>

      <% if driver? %>

        <!-- DRIVER NAV -->
        <div class="sidebar-section-label">My Dispatches</div>
        <ul class="sidebar-nav">
          <li class="<%= 'active' if current == 'dispatches' && action_name == 'index' %>">
            <%= link_to dispatches_path do %>
              <i class="bi bi-truck"></i> My Dispatches
            <% end %>
          </li>
        </ul>

      <% else %>

        <div id="sidebarAccordion">

        <!-- FAVORITES -->
        <% favorites = current_user.user_favorites %>
        <% if favorites.any? %>
          <% favorites_active = favorites.any? { |f| f.path == request.path } %>
          <%= render 'layouts/sidebar_section',
                label:  'Favorites',
                icon:   'bi-star-fill',
                id:     'favoritesCollapse',
                active: favorites_active do %>
            <% favorites.each do |fav| %>
              <li class="favorites-sidebar-item d-flex align-items-center justify-content-between pe-2" data-id="<%= fav.id %>">
                <%= link_to fav.path, class: "flex-grow-1 #{'active' if request.path == fav.path}" do %>
                  <%= fav.label %>
                <% end %>
                <button class="favorites-sidebar-remove" data-id="<%= fav.id %>" title="Remove" onclick="removeFavorite(<%= fav.id %>)">×</button>
              </li>
            <% end %>
          <% end %>
        <% end %>

        <!-- DISPATCH -->
        <%= render 'layouts/sidebar_section',
              label:     'Dispatch',
              icon:      'bi-truck',
              id:        'dispatchCollapse',
              active:    dispatch_active do %>
          <li class="<%= 'active' if current == 'customer_orders' && action_name == 'dashboard' %>">
            <%= link_to dashboard_customer_orders_path do %>
              <i class="bi bi-speedometer2"></i> Order Dashboard
            <% end %>
          </li>
          <li class="<%= 'active' if current == 'customer_orders' && action_name != 'dashboard' %>">
            <%= link_to customer_orders_path do %>
              <i class="bi bi-cart3"></i> All Orders
            <% end %>
          </li>
          <li class="<%= 'active' if current == 'quotes' %>">
            <%= link_to quotes_path do %>
              <i class="bi bi-file-earmark-text"></i> Quotes
            <% end %>
          </li>
          <li class="<%= 'active' if action_name == 'view_dispatches' %>">
            <%= link_to view_dispatches_path do %>
              <i class="bi bi-table"></i> Dispatches
            <% end %>
          </li>
          <li class="<%= 'active' if current == 'dispatches' && action_name == 'kanban' %>">
            <%= link_to kanban_dispatches_path do %>
              <i class="bi bi-kanban"></i> Dispatch Kanban
            <% end %>
          </li>
          <li class="<%= 'active' if current == 'calendar' %>">
            <%= link_to calendar_path do %>
              <i class="bi bi-calendar3"></i> Calendar
            <% end %>
          </li>
          <li class="<%= 'active' if current == 'locations' && action_name == 'map' %>">
            <%= link_to locations_map_path do %>
              <i class="bi bi-map"></i> Map
            <% end %>
          </li>
          <li class="<%= 'active' if current == 'dispatch_messages' %>">
            <%= link_to dispatch_messages_path do %>
              <i class="bi bi-chat-dots"></i> Messages
            <% end %>
          </li>
        <% end %>

        <!-- MANUFACTURING -->
        <%= render 'layouts/sidebar_section',
              label:  'Manufacturing',
              icon:   'bi-gear',
              id:     'manufacturingCollapse',
              active: manufacturing_active do %>
          <li class="<%= 'active' if current == 'production_orders' && action_name == 'dashboard' %>">
            <%= link_to dashboard_production_orders_path do %>
              <i class="bi bi-speedometer2"></i> Production Dashboard
            <% end %>
          </li>
          <li class="<%= 'active' if current == 'production_orders' && action_name == 'kanban' %>">
            <%= link_to kanban_production_orders_path do %>
              <i class="bi bi-layout-three-columns"></i> Kanban
            <% end %>
          </li>
          <li class="<%= 'active' if current == 'production_orders' && action_name == 'index' %>">
            <%= link_to production_orders_path do %>
              <i class="bi bi-table"></i> All Orders
            <% end %>
          </li>
          <li class="<%= 'active' if current == 'jobs' %>">
            <%= link_to line_path do %>
              <i class="bi bi-stopwatch"></i> Line Production
            <% end %>
          </li>
          <li class="<%= 'active' if current == 'warehouse' %>">
            <%= link_to warehouse_kanban_path do %>
              <i class="bi bi-tv"></i> Warehouse Board
            <% end %>
          </li>
          <li class="<%= 'active' if current == 'work_orders' %>">
            <%= link_to work_orders_path do %>
              <i class="bi bi-wrench-adjustable"></i> Work Orders
            <% end %>
          </li>
        <% end %>

        <!-- INVENTORY & MRP -->
        <%= render 'layouts/sidebar_section',
              label:  'Inventory & MRP',
              icon:   'bi-box-seam',
              id:     'inventoryCollapse',
              active: inventory_active do %>
          <li class="<%= 'active' if current == 'mrp' %>">
            <%= link_to mrp_path do %>
              <i class="bi bi-graph-up-arrow"></i> MRP Dashboard
            <% end %>
          </li>
          <li class="<%= 'active' if current == 'purchasing_report' %>">
            <%= link_to purchasing_report_path do %>
              <i class="bi bi-cart-check"></i> Purchasing
            <% end %>
          </li>
          <li class="<%= 'active' if current == 'products' %>">
            <%= link_to products_path do %>
              <i class="bi bi-box-seam"></i> Products
            <% end %>
          </li>
          <li class="<%= 'active' if current == 'purchase_orders' %>">
            <%= link_to purchase_orders_path do %>
              <i class="bi bi-bag-check"></i> Purchase Orders
            <% end %>
          </li>
          <li class="<%= 'active' if current == 'inventory_adjustments' %>">
            <%= link_to new_inventory_adjustment_path do %>
              <i class="bi bi-sliders"></i> Adjust Inventory
            <% end %>
          </li>
          <li class="<%= 'active' if current == 'inventory_transactions' %>">
            <%= link_to inventory_transactions_path do %>
              <i class="bi bi-clock-history"></i> Inventory History
            <% end %>
          </li>
        <% end %>

        <!-- IMPORTS -->
        <%= render 'layouts/sidebar_section',
              label:  'Imports',
              icon:   'bi-file-earmark-arrow-up',
              id:     'importsCollapse',
              active: imports_active do %>
          <li class="<%= 'active' if current == 'customer_order_imports' %>">
            <%= link_to new_customer_order_import_path do %>
              <i class="bi bi-file-earmark-arrow-up"></i> Customer Orders
            <% end %>
          </li>
          <li class="<%= 'active' if request.path == product_code_links_path %>">
            <%= link_to product_code_links_path do %>
              <i class="bi bi-link-45deg"></i> Link ODOR Products
            <% end %>
          </li>
          <li class="<%= 'active' if current == 'inventory_imports' %>">
            <%= link_to new_inventory_import_path do %>
              <i class="bi bi-upload"></i> PDI Inventory
            <% end %>
          </li>
          <li class="<%= 'active' if current == 'warehouse_transaction_imports' %>">
            <%= link_to new_warehouse_transaction_import_path do %>
              <i class="bi bi-clock-history"></i> Tx History
            <% end %>
          </li>
          <li class="<%= 'active' if current == 'bom_imports' %>">
            <%= link_to new_bom_import_path do %>
              <i class="bi bi-diagram-3"></i> BOM
            <% end %>
          </li>
          <li class="<%= 'active' if current == 'min_max_imports' %>">
            <%= link_to new_min_max_import_path do %>
              <i class="bi bi-sliders2"></i> Min/Max
            <% end %>
          </li>
          <li class="<%= 'active' if current == 'vendor_freight_term_imports' %>">
            <%= link_to new_vendor_freight_term_import_path do %>
              <i class="bi bi-building"></i> Vendor Freight Terms
            <% end %>
          </li>
        <% end %>

        <!-- MASTER DATA -->
        <%= render 'layouts/sidebar_section',
              label:  'Master Data',
              icon:   'bi-database',
              id:     'masterDataCollapse',
              active: masterdata_active do %>
          <li class="<%= 'active' if current == 'customers' %>">
            <%= link_to customers_path do %>
              <i class="bi bi-people"></i> Customers
            <% end %>
          </li>
          <li class="<%= 'active' if current == 'locations' && action_name != 'map' %>">
            <%= link_to locations_path do %>
              <i class="bi bi-geo-alt"></i> Locations
            <% end %>
          </li>
          <li class="<%= 'active' if current == 'vendors' %>">
            <%= link_to vendors_path do %>
              <i class="bi bi-building"></i> Vendors
            <% end %>
          </li>
          <li class="<%= 'active' if current == 'users' %>">
            <%= link_to users_path do %>
              <i class="bi bi-person-badge"></i> Users
            <% end %>
          </li>
          <li class="<%= 'active' if current == 'things' %>">
            <%= link_to things_path do %>
              <i class="bi bi-tools"></i> Assets
            <% end %>
          </li>
        <% end %>

        <!-- SYSTEM -->
        <%= render 'layouts/sidebar_section',
              label:  'System',
              icon:   'bi-gear-wide-connected',
              id:     'systemCollapse',
              active: system_active do %>
          <li class="<%= 'active' if current == 'automated_processes' %>">
            <%= link_to automated_processes_path do %>
              <i class="bi bi-arrow-repeat"></i> Automated Processes
            <% end %>
          </li>
          <li class="<%= 'active' if current == 'docs' %>">
            <%= link_to docs_path do %>
              <i class="bi bi-journal-text"></i> Help & Guides
            <% end %>
          </li>
          <li class="<%= 'active' if current == 'announcements' %>">
            <%= link_to announcements_path do %>
              <i class="bi bi-megaphone"></i> Announcements
            <% end %>
          </li>
        <% end %>

        </div><%# /sidebarAccordion %>

      <% end %>

    <% end %>
  </div>

  <!-- Bottom: Profile & Logout -->
  <% if user_signed_in? %>
    <div class="sidebar-footer">
      <%= link_to edit_user_registration_path, class: "sidebar-footer-link" do %>
        <i class="bi bi-person-circle"></i>
        <span><%= current_user.first_name.presence || current_user.email %></span>
      <% end %>
      <%= link_to destroy_user_session_path, class: "sidebar-footer-link text-danger" do %>
        <i class="bi bi-box-arrow-left"></i>
        <span>Logout</span>
      <% end %>
    </div>
  <% end %>
</nav>

<!-- Mobile overlay -->
<div id="sidebarOverlay" class="sidebar-overlay d-none"></div>

