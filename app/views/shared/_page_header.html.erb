<%# Standard show-page header: title on the left, Previous / Next and the page's actions (the block) on the right.
    Locals: title, subtitle (optional), previous_path / next_path (optional). %>
<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
  <div>
    <h1 class="mb-0"><%= title %></h1>
    <% if local_assigns[:subtitle].present? %>
      <div class="text-muted small"><%= subtitle %></div>
    <% end %>
  </div>
  <div class="d-flex flex-wrap align-items-center gap-2">
    <% if local_assigns.key?(:previous_path) || local_assigns.key?(:next_path) %>
      <div class="btn-group btn-group-sm" role="group" aria-label="Previous and next">
        <% if local_assigns[:previous_path] %>
          <%= link_to previous_path, class: 'btn btn-outline-secondary', title: 'Previous' do %><i class="bi bi-chevron-left"></i> Previous<% end %>
        <% else %>
          <span class="btn btn-outline-secondary disabled" aria-disabled="true"><i class="bi bi-chevron-left"></i> Previous</span>
        <% end %>
        <% if local_assigns[:next_path] %>
          <%= link_to next_path, class: 'btn btn-outline-secondary', title: 'Next' do %>Next <i class="bi bi-chevron-right"></i><% end %>
        <% else %>
          <span class="btn btn-outline-secondary disabled" aria-disabled="true">Next <i class="bi bi-chevron-right"></i></span>
        <% end %>
      </div>
    <% end %>
    <%= yield %>
  </div>
</div>
