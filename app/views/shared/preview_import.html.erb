<div class="container mt-4" style="max-width: 960px;">
  <h1>Preview Import — <%= @resource_name %></h1>

  <% if @not_found.any? %>
    <div class="alert alert-warning">
      <strong><%= @not_found.count %> ID<%= 's' if @not_found.count != 1 %> not found</strong> and will be skipped:
      <span class="font-monospace"><%= @not_found.join(', ') %></span>
    </div>
  <% end %>

  <% if @changes.empty? %>
    <div class="alert alert-info">
      No changes detected — the uploaded file matches the current data.
    </div>
    <%= link_to "Back", @back_url, class: "btn btn-secondary" %>

  <% else %>
    <p class="text-muted">
      <strong><%= @changes.count %> record<%= 's' if @changes.count != 1 %></strong> will be updated
      <% if @no_change > 0 %>(<%= @no_change %> already match — no change)<% end %>.
    </p>

    <div class="table-responsive mb-4">
      <table class="table table-sm table-bordered align-middle">
        <thead class="table-light">
          <tr>
            <th>Record</th>
            <th>Field</th>
            <th>Current</th>
            <th>New Value</th>
          </tr>
        </thead>
        <tbody>
          <% @changes.each do |change| %>
            <% change[:diffs].each_with_index do |diff, i| %>
              <tr>
                <% if i == 0 %>
                  <td rowspan="<%= change[:diffs].count %>" class="fw-semibold text-nowrap">
                    <%= change[:record].try(:name) || change[:record].try(:company_name) || change[:record].id %>
                  </td>
                <% end %>
                <td class="text-muted small text-nowrap"><%= diff[:col][:header] %></td>
                <td class="text-muted small"><%= diff[:old].presence || '—' %></td>
                <td class="text-success fw-semibold small"><%= diff[:new] %></td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= form_with url: @confirm_url, method: :post, data: { turbo: false } do |f| %>
      <div class="d-flex gap-2">
        <%= f.submit "Apply #{@changes.count} Update#{'s' if @changes.count != 1}", class: "btn btn-success" %>
        <%= link_to "Cancel", @back_url, class: "btn btn-secondary" %>
      </div>
    <% end %>
  <% end %>
</div>
