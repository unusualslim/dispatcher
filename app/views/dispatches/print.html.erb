<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Dispatch #<%= @dispatch.id %> Order</title>
  <style>
    :root { --ink: #1c1917; --muted: #57534e; --rule: #d6d3d1; --accent: #f26722; }
    * { box-sizing: border-box; }
    body { font: 12px/1.4 -apple-system, "Segoe UI", Roboto, Arial, sans-serif; color: var(--ink); background: #e7e5e4;
           margin: 0; padding: 16px; }
    .toolbar { display: flex; justify-content: flex-end; align-items: center; gap: 12px; max-width: 11in; margin: 0 auto 12px;
               font-size: 13px; }
    .toolbar button { font: inherit; padding: 6px 14px; border: 1px solid var(--rule); background: #fff; border-radius: 4px; cursor: pointer; }
    .empty { max-width: 11in; margin: 0 auto; background: #fff; padding: 24px; font-size: 14px; }
    /* One letter-landscape sheet per order: two identical halves with a cut line between them. */
    .sheet { width: 11in; height: 8.5in; margin: 0 auto 16px; background: #fff; display: grid;
             grid-template-columns: 1fr 1fr; padding: 0.35in 0; overflow: hidden; }
    .copy { padding: 0 0.35in; overflow: hidden; display: flex; flex-direction: column; }
    .copy + .copy { border-left: 1px dashed #a8a29e; }
    header { display: flex; justify-content: space-between; align-items: flex-end; border-bottom: 2.5px solid var(--accent);
             padding-bottom: 5px; margin-bottom: 8px; }
    header h1 { font-size: 18px; margin: 0; }
    header .company { text-align: right; color: var(--muted); font-size: 9.5px; }
    header .company strong { color: var(--ink); font-size: 11px; display: block; }
    .copy-label { font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--accent); }
    dl { display: grid; grid-template-columns: max-content 1fr max-content 1fr; gap: 2px 10px; margin: 0 0 8px; }
    dt { font-weight: 600; } dd { margin: 0; }
    .boxes { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 8px; }
    .box { border: 1px solid var(--rule); border-radius: 3px; padding: 5px 7px; }
    .box h2 { font-size: 9px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin: 0 0 2px; }
    .box .name { font-weight: 700; }
    .box .note { color: var(--muted); margin-top: 3px; white-space: pre-line; }
    table { width: 100%; border-collapse: collapse; margin-bottom: 8px; }
    th { text-align: left; font-size: 9px; text-transform: uppercase; letter-spacing: .04em; color: var(--muted);
         border-bottom: 1.5px solid var(--ink); padding: 3px 4px; }
    td { border-bottom: 1px solid var(--rule); padding: 3px 4px; vertical-align: top; }
    .num { text-align: right; white-space: nowrap; }
    /* Blank line for the driver to write the quantity actually delivered. */
    /* Product rows are tall with text on the bottom so the driver has room to write on the line. */
    tbody td { padding-top: 22px; vertical-align: bottom; }
    td.fill { width: 1in; padding: 22px 10px 4px 8px; }
    td.fill span { display: block; border-bottom: 1px solid var(--ink); }
    tfoot td { font-weight: 700; border-bottom: none; }
    .notes { border: 1px solid var(--rule); border-radius: 3px; padding: 5px 7px; margin-bottom: 8px; white-space: pre-line; }
    .notes h2 { font-size: 9px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin: 0 0 2px; white-space: normal; }
    .sign { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: auto; padding-top: 28px; }
    .sign div { border-top: 1px solid var(--ink); padding-top: 2px; font-size: 9px; color: var(--muted); }
    body.hide-prices .price { display: none; }
    @page { size: letter landscape; margin: 0; }
    @media print {
      body { background: #fff; padding: 0; }
      .toolbar { display: none; }
      .sheet { margin: 0; break-after: page; }
      .sheet:last-child { break-after: auto; }
    }
  </style>
</head>
<body class="hide-prices">
  <div class="toolbar">
    <label><input type="checkbox" id="hide-prices" checked> Hide prices</label>
    <button type="button" onclick="window.print()">Print</button>
  </div>

  <% if @customer_orders.empty? %>
    <div class="empty">No customer orders are assigned to Dispatch #<%= @dispatch.id %>.</div>
  <% end %>

  <% @customer_orders.each do |order| %>
    <div class="sheet">
      <% ['Driver Copy', 'Dispatch Copy'].each do |label| %>
        <%= render 'print_copy', order: order, label: label %>
      <% end %>
    </div>
  <% end %>

  <script>
    document.getElementById('hide-prices').addEventListener('change', function () {
      document.body.classList.toggle('hide-prices', this.checked);
    });
  </script>
</body>
</html>
