<%= form_with model: tank do |f| %>
  <% if tank.errors.any? %>
    <div class="alert alert-danger"><%= tank.errors.full_messages.to_sentence %></div>
  <% end %>
  <% if local_assigns[:feed_tank] %>
    <%= hidden_field_tag :feed_tank_id, feed_tank.id %>
    <%= hidden_field_tag :return_to, 'feeds' %>
    <div class="alert alert-light border small">
      From <strong><%= feed_tank.label %></strong>: <%= feed_tank_summary(feed_tank).presence || feed_tank.external_id %>.
      Its readings will count toward this tank.
    </div>
  <% end %>
  <div class="row g-3">
    <div class="col-md-6">
      <%= f.label :location_id, 'Location', class: 'form-label' %>
      <%= f.select :location_id, (tank.location ? [[tank.location.picker_label, tank.location_id]] : []), { include_blank: true },
                   class: 'form-select tank-location-select', required: true %>
      <div class="form-text">Customer site, warehouse or plant. Type to search.</div>
    </div>
    <div class="col-md-6">
      <%= f.label :name, 'Tank', class: 'form-label' %>
      <%= f.text_field :name, class: 'form-control', required: true, placeholder: 'e.g. DEF 1' %>
    </div>
    <div class="col-md-6">
      <%= f.label :product_id, 'Product', class: 'form-label' %>
      <%= f.collection_select :product_id, Product.selectable(tank.product_id).order(:name), :id, :name, { include_blank: true }, class: 'form-select' %>
    </div>
    <div class="col-md-6">
      <%= f.label :ownership, 'Ownership', class: 'form-label' %>
      <%= f.select :ownership, Tank::OWNERSHIPS.invert, {}, class: 'form-select' %>
      <div class="form-text">"Ours" = the product in it is FPS inventory (e.g. 0002 Bulk DEF).</div>
    </div>
    <div class="col-md-4">
      <%= f.label :capacity_gallons, 'Capacity (gal)', class: 'form-label' %>
      <%= f.number_field :capacity_gallons, value: plain_number(tank.capacity_gallons), class: 'form-control', step: 'any', min: 0 %>
    </div>
    <div class="col-md-4">
      <%= f.label :fill_limit_gallons, 'Fill limit (gal)', class: 'form-label' %>
      <%= f.number_field :fill_limit_gallons, value: plain_number(tank.fill_limit_gallons), class: 'form-control', step: 'any', min: 0 %>
      <div class="form-text">Blank = 90% of capacity.</div>
    </div>
    <div class="col-md-4">
      <%= f.label :bottom_gallons, 'Bottom (gal)', class: 'form-label' %>
      <%= f.number_field :bottom_gallons, value: plain_number(tank.bottom_gallons), class: 'form-control', step: 'any', min: 0 %>
      <div class="form-text">Treated as empty. Blank = 10% of the fill limit.</div>
    </div>
    <div class="col-12">
      <%= f.label :notes, class: 'form-label' %>
      <%= f.text_area :notes, rows: 2, class: 'form-control' %>
    </div>
    <div class="col-12 form-check ms-1">
      <%= f.check_box :active, class: 'form-check-input' %>
      <%= f.label :active, class: 'form-check-label' %>
    </div>
  </div>
  <div class="mt-3 d-flex gap-2">
    <%= f.submit 'Save Tank', class: 'btn btn-primary' %>
    <%= link_to 'Cancel', tank.persisted? ? tank : tanks_path, class: 'btn btn-outline-secondary' %>
  </div>
<% end %>

<script>
  $(function() {
    $('.tank-location-select').select2({
      theme: 'bootstrap-5', width: '100%', placeholder: 'Search locations', minimumInputLength: 1,
      ajax: { url: '<%= locations_tanks_path %>', dataType: 'json', delay: 200, data: function(p) { return { q: p.term }; } }
    });
  });
</script>
