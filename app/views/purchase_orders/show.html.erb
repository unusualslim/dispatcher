<div class="container mt-4" style="max-width: 800px;">
  <%= render layout: 'shared/page_header',
             locals: { title: "Purchase Order #{@purchase_order.display_number}",
                       previous_path: (purchase_order_path(@previous_id) if @previous_id),
                       next_path: (purchase_order_path(@next_id) if @next_id) } do %>
    <% if %w[draft pending_approval].include?(@purchase_order.status) %>
      <%= link_to 'Edit', edit_purchase_order_path(@purchase_order), class: 'btn btn-outline-secondary btn-sm' %>
    <% end %>
    <% if @purchase_order.status == 'draft' %>
      <%= button_to 'Approve', approve_purchase_order_path(@purchase_order),
            method: :patch, class: 'btn btn-success btn-sm',
            form: { data: { turbo_confirm: 'Approve this purchase order?' } } %>
    <% end %>
    <% if @purchase_order.status == 'approved' %>
      <%= button_to 'Submit to PDI', submit_purchase_order_path(@purchase_order),
            method: :patch, class: 'btn btn-info btn-sm',
            form: { data: { turbo_confirm: 'Submit this PO? A PDI import file will be sent to the FTP server.' } } %>
    <% end %>
    <% if @purchase_order.status == 'submitted' %>
      <%= button_to 'Mark Received', receive_purchase_order_path(@purchase_order),
            method: :patch, class: 'btn btn-primary btn-sm',
            form: { data: { turbo_confirm: 'Confirm physical receipt of this order?' } } %>
    <% end %>
    <% if @purchase_order.status == 'received' && !@purchase_order.posted? && !@purchase_order.postable? %>
      <span class="text-muted small align-self-center">No warehouse (dropship): not posted to inventory</span>
    <% end %>
    <% if @purchase_order.postable? %>
      <%= button_to 'Post to Inventory', post_to_inventory_purchase_order_path(@purchase_order),
            method: :patch, class: 'btn btn-success btn-sm',
            form: { data: { turbo_confirm: 'Post this PO to inventory? This will update stock levels for all matched products.' } } %>
    <% end %>
    <% if admin? && !@purchase_order.voided? %>
      <button class="btn btn-outline-dark btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#po-void-form">Void</button>
    <% end %>
    <%= link_to 'All POs', purchase_orders_path, class: 'btn btn-outline-secondary btn-sm' %>
  <% end %>

  <% if admin? && !@purchase_order.voided? %>
    <div class="collapse mb-3" id="po-void-form">
      <div class="card border-dark">
        <div class="card-body">
          <div class="fw-semibold mb-1">Void purchase order <%= @purchase_order.display_number %></div>
          <p class="small text-muted mb-2">
            Reverses anything it posted to inventory and takes it out of active purchasing. It stays for history but
            can't be changed.
            <% if @purchase_order.submitted_at.present? || %w[submitted received].include?(@purchase_order.status) %>
              <strong class="text-danger">It was already sent to PDI; void it in PDI as well.</strong>
            <% end %>
          </p>
          <%= form_with url: void_purchase_order_path(@purchase_order), method: :post, local: true, class: "d-flex gap-2 flex-wrap" do %>
            <%= text_field_tag :void_reason, nil, class: "form-control form-control-sm", style: "max-width: 420px;",
                                                  placeholder: "Reason (required)", required: true %>
            <%= submit_tag "Void PO", class: "btn btn-dark btn-sm",
                                      data: { turbo_confirm: "Void #{@purchase_order.display_number}? This can't be undone." } %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <div class="card shadow-sm mb-3">
    <div class="card-body">
      <dl class="row mb-0">
        <dt class="col-4">Status</dt>
        <dd class="col-8">
          <% bg = { 'draft' => 'secondary', 'pending_approval' => 'warning', 'approved' => 'primary',
                    'submitted' => 'info', 'received' => 'success', 'cancelled' => 'danger',
                    'voided' => 'dark' }
             color = bg[@purchase_order.status] || 'secondary' %>
          <span class="badge bg-<%= color %>"><%= @purchase_order.status.humanize %></span>
          <% if @purchase_order.posted? %>
            <span class="badge bg-success ms-1">Inventory Posted</span>
          <% end %>
        </dd>

        <dt class="col-4">Vendor</dt>
        <dd class="col-8"><%= @purchase_order.vendor.name %></dd>

        <dt class="col-4">Total Cost</dt>
        <dd class="col-8">
          <%= number_to_currency(@purchase_order.total_cost) %>
          <% if @purchase_order.freight_amount.to_f > 0 || @purchase_order.other_charges.to_f > 0 %>
            <span class="text-muted small ms-1">(subtotal <%= number_to_currency(@purchase_order.subtotal) %>)</span>
          <% end %>
        </dd>

        <dt class="col-4">Trigger</dt>
        <dd class="col-8"><%= @purchase_order.trigger_type&.humanize || '—' %></dd>

        <% if @purchase_order.trigger_reason.present? %>
          <dt class="col-4">Reason</dt>
          <dd class="col-8 text-muted small"><%= @purchase_order.trigger_reason %></dd>
        <% end %>

        <dt class="col-4">Expected Delivery</dt>
        <dd class="col-8"><%= @purchase_order.expected_delivery_date&.strftime('%B %d, %Y') || '—' %></dd>

        <% if @purchase_order.freight_terms.present? || @purchase_order.freight_amount.present? %>
          <dt class="col-4">Freight Terms</dt>
          <dd class="col-8">
            <% code = @purchase_order.freight_terms.presence %>
            <% label = VendorFreightTerm::TERMS.to_h[code] %>
            <%= label || code || '—' %>
          </dd>
          <dt class="col-4">Freight Amount</dt>
          <dd class="col-8"><%= @purchase_order.freight_amount.to_f > 0 ? number_to_currency(@purchase_order.freight_amount) : '—' %></dd>
        <% end %>
        <% if @purchase_order.other_charges.to_f > 0 %>
          <dt class="col-4">Other Charges</dt>
          <dd class="col-8">
            <%= number_to_currency(@purchase_order.other_charges) %>
            <% if @purchase_order.other_charges_description.present? %>
              <span class="text-muted small">— <%= @purchase_order.other_charges_description %></span>
            <% end %>
          </dd>
        <% end %>

        <% if @purchase_order.pdi_reference.present? %>
          <dt class="col-4">PDI Reference</dt>
          <dd class="col-8 font-monospace"><%= @purchase_order.pdi_reference %></dd>
        <% end %>

        <% if @purchase_order.approved_by.present? %>
          <dt class="col-4">Approved By</dt>
          <dd class="col-8"><%= @purchase_order.approved_by.full_name %></dd>
        <% end %>

        <% if @purchase_order.received_at.present? %>
          <dt class="col-4">Received At</dt>
          <dd class="col-8"><%= @purchase_order.received_at.strftime('%B %d, %Y') %></dd>
        <% end %>

        <% if @purchase_order.posted_at.present? %>
          <dt class="col-4">Posted to Inventory</dt>
          <dd class="col-8"><%= @purchase_order.posted_at.strftime('%B %d, %Y %H:%M') %></dd>
        <% end %>

        <% if @purchase_order.notes.present? %>
          <dt class="col-4">Notes</dt>
          <dd class="col-8"><%= @purchase_order.notes %></dd>
        <% end %>
      </dl>
    </div>
  </div>

  <h5 class="mb-2">Line Items</h5>
  <table class="table table-sm table-bordered mb-4">
    <thead class="table-light">
      <tr>
        <th>Product</th>
        <th>Package</th>
        <th class="text-end">Quantity</th>
        <th class="text-end">Unit Cost</th>
        <th class="text-end">Total</th>
      </tr>
    </thead>
    <tbody>
      <% @purchase_order.line_items.each do |line| %>
        <tr>
          <td>
            <% if line.product %>
              <%= link_to line.product.name, product_path(line.product) %>
            <% else %>
              <span class="text-muted"><%= line.display_name %></span>
            <% end %>
          </td>
          <td><%= line.package_code.presence || '—' %></td>
          <td class="text-end"><%= number_with_precision(line.quantity, precision: 2, strip_insignificant_zeros: true) %></td>
          <td class="text-end"><%= line.unit_cost ? number_to_currency(line.unit_cost) : '—' %></td>
          <td class="text-end"><%= line.total_cost ? number_to_currency(line.total_cost) : '—' %></td>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <% if @purchase_order.freight_amount.to_f > 0 || @purchase_order.other_charges.to_f > 0 %>
        <tr class="text-muted small">
          <td colspan="4" class="text-end">Subtotal</td>
          <td class="text-end"><%= number_to_currency(@purchase_order.subtotal) %></td>
        </tr>
        <% if @purchase_order.freight_amount.to_f > 0 %>
          <tr class="text-muted small">
            <td colspan="4" class="text-end">Freight (<%= VendorFreightTerm::TERMS.to_h[@purchase_order.freight_terms] || @purchase_order.freight_terms || 'see terms' %>)</td>
            <td class="text-end"><%= number_to_currency(@purchase_order.freight_amount) %></td>
          </tr>
        <% end %>
        <% if @purchase_order.other_charges.to_f > 0 %>
          <tr class="text-muted small">
            <td colspan="4" class="text-end"><%= @purchase_order.other_charges_description.presence || 'Other Charges' %></td>
            <td class="text-end"><%= number_to_currency(@purchase_order.other_charges) %></td>
          </tr>
        <% end %>
      <% end %>
      <tr class="fw-semibold">
        <td colspan="4" class="text-end">Total</td>
        <td class="text-end"><%= number_to_currency(@purchase_order.total_cost) %></td>
      </tr>
    </tfoot>
  </table>

  <% if @purchase_order.inventory_transactions.any? %>
    <h5 class="mb-2">Inventory History</h5>
    <table class="table table-sm table-bordered mb-4">
      <thead class="table-light">
        <tr>
          <th>Date</th>
          <th>Product</th>
          <th>Direction</th>
          <th class="text-end">Quantity</th>
          <th>Reference</th>
          <th>Notes</th>
          <th>By</th>
        </tr>
      </thead>
      <tbody>
        <% @purchase_order.inventory_transactions.includes(:product, :created_by).order(:created_at).each do |txn| %>
          <tr>
            <td class="text-nowrap"><%= txn.created_at.strftime('%m/%d/%Y %H:%M') %></td>
            <td><%= link_to txn.product.name, product_path(txn.product) %></td>
            <td>
              <span class="badge bg-<%= txn.direction == 'in' ? 'success' : 'danger' %>">
                <%= txn.direction == 'in' ? 'In' : 'Out' %>
              </span>
            </td>
            <td class="text-end"><%= number_with_precision(txn.quantity, precision: 3, strip_insignificant_zeros: true) %></td>
            <td class="text-muted small"><%= txn.reference_number.presence || '—' %></td>
            <td class="text-muted small"><%= txn.notes.presence || '—' %></td>
            <td class="text-muted small"><%= txn.created_by&.full_name || '—' %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <% if @purchase_order.voided? %>
    <div class="alert alert-dark">
      <strong>Voided</strong> <%= @purchase_order.voided_at.strftime("%m/%d/%Y %I:%M %p") %>
      by <%= @purchase_order.voided_by&.full_name.presence || 'an admin' %>: <%= @purchase_order.void_reason %>
      <div class="small">Anything it posted to inventory was reversed. The purchase order is read-only.</div>
    </div>
  <% end %>

</div>
