<div class="container mt-4" style="max-width: 700px;">
  <h1>New Purchase Order</h1>

  <%= form_with model: @purchase_order, local: true do |f| %>
    <% if @purchase_order.errors.any? %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% @purchase_order.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="card shadow-sm mb-3">
      <div class="card-header fw-semibold">Order Details</div>
      <div class="card-body row g-3">
        <div class="col-12">
          <%= f.label :vendor_id, "Vendor", class: 'form-label' %>
          <%= f.collection_select :vendor_id, @vendors, :id, :name,
                { include_blank: 'Select vendor...' },
                class: 'form-select', id: 'po_vendor_id' %>
        </div>
        <div class="col-6">
          <%= f.label :expected_delivery_date, class: 'form-label' %>
          <%= f.date_field :expected_delivery_date, class: 'form-control' %>
        </div>
        <div class="col-6">
          <%= f.label :trigger_type, class: 'form-label' %>
          <%= f.select :trigger_type,
                PurchaseOrder::TRIGGER_TYPES.map { |t| [t.humanize, t] },
                { selected: 'manual' }, class: 'form-select' %>
        </div>
        <div class="col-6">
          <%= f.label :freight_terms, class: 'form-label' %>
          <select name="purchase_order[freight_terms]" id="po_freight_terms" class="form-select">
            <option value="">— Select vendor first —</option>
          </select>
        </div>
        <div class="col-6">
          <%= f.label :freight_amount, "Freight Amount ($)", class: 'form-label' %>
          <%= f.number_field :freight_amount, class: 'form-control', step: '0.01', min: 0, placeholder: '0.00' %>
        </div>
        <div class="col-8">
          <%= f.label :other_charges_description, "Other Charges", class: 'form-label' %>
          <%= f.text_field :other_charges_description, class: 'form-control', placeholder: 'e.g. Handling fee, fuel surcharge' %>
        </div>
        <div class="col-4">
          <%= f.label :other_charges, "Amount ($)", class: 'form-label' %>
          <%= f.number_field :other_charges, class: 'form-control', step: '0.01', min: 0, placeholder: '0.00' %>
        </div>
        <div class="col-12">
          <%= f.label :notes, class: 'form-label' %>
          <%= f.text_area :notes, class: 'form-control', rows: 2 %>
        </div>
      </div>
    </div>

    <div class="card shadow-sm mb-3">
      <div class="card-header fw-semibold">Line Items</div>
      <div class="card-body p-0">
        <table class="table table-sm mb-0" id="line-items-table">
          <thead class="table-light">
            <tr>
              <th>Product</th>
              <th style="width:80px">Package</th>
              <th style="width:100px">Qty</th>
              <th style="width:120px">Unit Cost</th>
              <th style="width:40px"></th>
            </tr>
          </thead>
          <tbody id="line-items-body">
            <%= f.fields_for :line_items do |li| %>
              <%= render 'line_item_fields', f: li %>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="card-footer">
        <button type="button" class="btn btn-outline-secondary btn-sm" id="add-line-item">+ Add Line Item</button>
      </div>
    </div>

    <div class="d-flex gap-2">
      <%= f.submit 'Create Purchase Order', class: 'btn btn-success' %>
      <%= link_to 'Cancel', purchase_orders_path, class: 'btn btn-secondary' %>
    </div>
  <% end %>
</div>

<%# Hidden template for JS cloning %>
<template id="line-item-template">
  <tr class="line-item-row">
    <td>
      <select name="purchase_order[line_items_attributes][NEW_INDEX][product_id]" class="form-select form-select-sm">
        <option value="">Select product...</option>
        <% @products.each do |p| %>
          <option value="<%= p.id %>"><%= p.name %></option>
        <% end %>
      </select>
    </td>
    <td><input type="text" name="purchase_order[line_items_attributes][NEW_INDEX][package_code]" class="form-control form-control-sm" placeholder="EA"></td>
    <td><input type="number" name="purchase_order[line_items_attributes][NEW_INDEX][quantity]" step="0.001" class="form-control form-control-sm" placeholder="0"></td>
    <td><input type="number" name="purchase_order[line_items_attributes][NEW_INDEX][unit_cost]" step="0.0001" class="form-control form-control-sm" placeholder="0.00"></td>
    <td><button type="button" class="btn btn-outline-danger btn-sm remove-line-item">✕</button></td>
  </tr>
</template>

<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<script>
  const vendorFreightTerms = <%= raw @vendors.each_with_object({}) { |v, h| h[v.id.to_s] = v.freight_term_names }.to_json %>;
  const freightTermLabels  = <%= raw VendorFreightTerm::TERMS.to_h.to_json %>;
  const currentFreightTerm = <%= raw @purchase_order.freight_terms.to_s.to_json %>;

  function rebuildFreightTerms(vendorId) {
    const sel = document.getElementById('po_freight_terms');
    const codes = vendorFreightTerms[String(vendorId)] || [];
    if (codes.length === 0) {
      sel.innerHTML = '<option value="">— No terms assigned to vendor —</option>';
      return;
    }
    sel.innerHTML = '<option value="">— None —</option>';
    codes.forEach(function(code) {
      const opt = document.createElement('option');
      opt.value = code;
      opt.textContent = freightTermLabels[code] || code;
      if (code === currentFreightTerm) opt.selected = true;
      sel.appendChild(opt);
    });
  }

  $(function() {
    $('#po_vendor_id').select2({ placeholder: 'Select vendor...', width: '100%' });
    $('#po_vendor_id').on('change', function() { rebuildFreightTerms($(this).val()); });
    rebuildFreightTerms($('#po_vendor_id').val());
  });

  let lineItemIndex = <%= @purchase_order.line_items.size %>;

  document.getElementById('add-line-item').addEventListener('click', function() {
    const template = document.getElementById('line-item-template');
    const clone = template.content.cloneNode(true);
    clone.querySelectorAll('[name]').forEach(el => {
      el.name = el.name.replace('NEW_INDEX', lineItemIndex);
    });
    document.getElementById('line-items-body').appendChild(clone);
    lineItemIndex++;
  });

  document.getElementById('line-items-body').addEventListener('click', function(e) {
    if (e.target.classList.contains('remove-line-item')) {
      e.target.closest('tr').remove();
    }
  });
</script>
