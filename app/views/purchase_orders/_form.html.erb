<%# New / edit purchase order. Expense POs (parts and supplies charged to GL expense accounts) get their own lines. %>
<% expense = @purchase_order.expense? %>
<%= form_with model: @purchase_order, local: true do |f| %>
  <%= f.hidden_field :po_type if @purchase_order.new_record? %>
  <% if @purchase_order.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% @purchase_order.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if expense %>
    <div class="alert alert-light border small">
      <i class="bi bi-info-circle"></i>
      An expense PO is for parts and supplies that don't go into inventory. It isn't sent to PDI or posted to
      stock. Print it for the vendor, and AP keys the bill into PDI against each line's GL account.
    </div>
  <% end %>

  <div class="card shadow-sm mb-3">
    <div class="card-header fw-semibold">Order Details</div>
    <div class="card-body row g-3">
      <div class="<%= expense ? 'col-md-6' : 'col-12' %>">
        <%= f.label :location_id, (expense ? 'Ship To' : 'Receiving Warehouse'), class: 'form-label' %>
        <%= f.collection_select :location_id, (expense ? @sites : @warehouses), :id, :company_name,
              { include_blank: (expense ? 'Select location...' : 'Select warehouse...') },
              class: 'form-select' %>
        <% if expense %><div class="form-text">Lines without a site use this one.</div><% end %>
      </div>
      <div class="<%= expense ? 'col-md-6' : 'col-12' %>">
        <%= f.label :vendor_id, "Vendor", class: 'form-label' %>
        <%= f.collection_select :vendor_id, @vendors, :id, :label,
              { include_blank: 'Select vendor...' },
              class: 'form-select', id: 'po_vendor_id' %>
      </div>
      <div class="col-6">
        <%= f.label :expected_delivery_date, class: 'form-label' %>
        <%= f.date_field :expected_delivery_date, class: 'form-control' %>
      </div>
      <div class="col-6">
        <%= f.label :trigger_type, class: 'form-label' %>
        <%= f.select :trigger_type,
              PurchaseOrder::TRIGGER_TYPES.map { |t| [t.humanize, t] },
              { selected: @purchase_order.trigger_type || 'manual' }, class: 'form-select' %>
      </div>
      <div class="col-6">
        <%= f.label :freight_terms, class: 'form-label' %>
        <select name="purchase_order[freight_terms]" id="po_freight_terms" class="form-select">
          <option value="">— Select vendor first —</option>
        </select>
      </div>
      <div class="col-6">
        <%= f.label :freight_amount, (expense ? 'Shipping ($)' : 'Freight Amount ($)'), class: 'form-label' %>
        <%= f.number_field :freight_amount, class: 'form-control', step: '0.01', min: 0, placeholder: '0.00' %>
      </div>
      <div class="col-8">
        <%= f.label :other_charges_description, "Other Charges", class: 'form-label' %>
        <%= f.text_field :other_charges_description, class: 'form-control', placeholder: 'e.g. Handling fee, fuel surcharge' %>
      </div>
      <div class="col-4">
        <%= f.label :other_charges, "Amount ($)", class: 'form-label' %>
        <%= f.number_field :other_charges, class: 'form-control', step: '0.01', min: 0, placeholder: '0.00' %>
      </div>
      <div class="col-12">
        <%= f.label :notes, class: 'form-label' %>
        <%= f.text_area :notes, class: 'form-control', rows: 2 %>
        <% if expense %><div class="form-text">Notes print on the vendor copy.</div><% end %>
      </div>
    </div>
  </div>

  <% line_partial = expense ? 'expense_line_item_fields' : 'line_item_fields' %>
  <div class="card shadow-sm mb-3">
    <div class="card-header fw-semibold">Line Items</div>
    <div class="card-body p-0 table-responsive">
      <table class="table table-sm mb-0" id="line-items-table">
        <thead class="table-light">
          <% if expense %>
            <tr>
              <th style="min-width:220px">Description</th>
              <th style="width:130px">Vendor Part #</th>
              <th style="min-width:170px">Equipment</th>
              <th style="min-width:200px">GL Account</th>
              <th style="min-width:170px">Site</th>
              <th style="width:90px">Qty</th>
              <th style="width:70px">Unit</th>
              <th style="width:110px">Unit Cost</th>
              <th style="width:40px"></th>
            </tr>
          <% else %>
            <tr>
              <th>Product</th>
              <th style="width:80px">Package</th>
              <th style="width:100px">Qty</th>
              <th style="width:120px">Unit Cost</th>
              <th style="width:40px"></th>
            </tr>
          <% end %>
        </thead>
        <tbody id="line-items-body">
          <%= f.fields_for :line_items, include_id: false do |li| %>
            <%= render line_partial, f: li %>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="card-footer d-flex justify-content-between align-items-center">
      <button type="button" class="btn btn-outline-secondary btn-sm" id="add-line-item">+ Add Line Item</button>
      <% if expense && @expense_accounts.empty? %>
        <span class="small text-muted">
          No GL expense accounts yet<%= can?(:accounting, :edit) ? '' : ': ask accounting to add them' %>
          <% if can?(:accounting, :edit) %>— <%= link_to 'add them', expense_accounts_path %><% end %>.
        </span>
      <% elsif expense && @equipment.empty? && admin? %>
        <span class="small text-muted">Add machines on <%= link_to 'Equipment & Assets', things_path %> (category Equipment).</span>
      <% end %>
    </div>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit submit_label, class: 'btn btn-success' %>
    <%= link_to 'Cancel', cancel_path, class: 'btn btn-secondary' %>
  </div>

  <%# A blank line to clone for "+ Add Line Item" (NEW_INDEX is replaced with a unique index). %>
  <template id="line-item-template">
    <%= f.fields_for :line_items, PurchaseOrderLineItem.new, child_index: "NEW_INDEX", include_id: false do |li| %>
      <%= render line_partial, f: li %>
    <% end %>
  </template>
<% end %>

<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<script>
  (function() {
    const vendorFreightTerms = <%= raw @vendors.each_with_object({}) { |v, h| h[v.id.to_s] = v.freight_term_names }.to_json %>;
    const freightTermLabels  = <%= raw VendorFreightTerm::TERMS.to_h.to_json %>;
    const currentFreightTerm = <%= raw @purchase_order.freight_terms.to_s.to_json %>;

    function rebuildFreightTerms(vendorId) {
      const sel = document.getElementById('po_freight_terms');
      const codes = vendorFreightTerms[String(vendorId)] || [];
      if (codes.length === 0) {
        sel.innerHTML = '<option value="">— No terms assigned to vendor —</option>';
        return;
      }
      sel.innerHTML = '<option value="">— None —</option>';
      codes.forEach(function(code) {
        const opt = document.createElement('option');
        opt.value = code;
        opt.textContent = freightTermLabels[code] || code;
        if (code === currentFreightTerm) opt.selected = true;
        sel.appendChild(opt);
      });
    }

    function init() {
      var $v = $('#po_vendor_id');
      if (!$v.length) return;
      if ($v.hasClass('select2-hidden-accessible')) $v.select2('destroy');
      $v.select2({ placeholder: 'Select vendor...', width: '100%' });
      $v.on('change', function() { rebuildFreightTerms($(this).val()); });
      rebuildFreightTerms($v.val());
    }
    document.addEventListener('turbo:load', init, { once: true });
    if (document.readyState !== 'loading' && window.Turbo === undefined) init();

    let lineItemIndex = Date.now();
    const body = document.getElementById('line-items-body');

    document.getElementById('add-line-item').addEventListener('click', function() {
      const html = document.getElementById('line-item-template').innerHTML.replace(/NEW_INDEX/g, lineItemIndex++);
      body.insertAdjacentHTML('beforeend', html);
    });

    // Removing a saved line marks it for deletion; a new one just goes.
    body.addEventListener('click', function(e) {
      if (!e.target.classList.contains('remove-line-item')) return;
      const row = e.target.closest('tr');
      const destroy = row.querySelector('input[name$="[_destroy]"]');
      if (destroy && row.querySelector('input[name$="[id]"]')) {
        destroy.value = '1';
        row.style.display = 'none';
      } else {
        row.remove();
      }
    });

    // Expense lines: picking equipment fills in its site when the site is blank.
    body.addEventListener('change', function(e) {
      if (!e.target.matches('select[name$="[equipment_id]"]')) return;
      const site = e.target.selectedOptions[0] && e.target.selectedOptions[0].dataset.siteId;
      const siteSelect = e.target.closest('tr').querySelector('select[name$="[location_id]"]');
      if (site && siteSelect && !siteSelect.value) siteSelect.value = site;
    });
  })();
</script>
