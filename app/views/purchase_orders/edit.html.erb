<div class="container mt-4" style="max-width: <%= @purchase_order.expense? ? 1200 : 700 %>px;">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Edit <%= 'Expense ' if @purchase_order.expense? %>Purchase Order <%= @purchase_order.display_number %></h1>
    <%= link_to 'Cancel', purchase_order_path(@purchase_order), class: 'btn btn-outline-secondary btn-sm' %>
  </div>
  <%= render 'form', submit_label: 'Save Changes', cancel_path: purchase_order_path(@purchase_order) %>
</div>
