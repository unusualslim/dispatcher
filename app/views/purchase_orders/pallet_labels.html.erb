<!DOCTYPE html>
<%
  po = @purchase_order
  company = AppSetting.company['name'].presence || 'Five Points Service, Inc.'
  received_on = po.received_at&.to_date || Time.zone.today
  lines = po.line_items.includes(:product).sort_by(&:id)
  shown = lines.first(7)
  qty = ->(n) { number_with_precision(n, precision: 3, strip_insignificant_zeros: true, delimiter: ',') }
  po_url = purchase_order_url(po)
%>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Pallet Labels · PO <%= po.display_number %></title>
  <%= javascript_include_tag 'qr_codes', defer: true %>
  <style>
    * { box-sizing: border-box; }
    [hidden] { display: none !important; }
    body { font-family: Arial, Helvetica, sans-serif; color: #000; background: #d6d3d1; margin: 0; padding: 16px; }
    .toolbar { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; justify-content: center; margin: 0 auto 16px;
               font-size: 14px; }
    .toolbar input { width: 70px; font: inherit; padding: 4px 6px; }
    .toolbar input.note { width: 300px; }
    .toolbar button { font: inherit; padding: 6px 14px; border: 1px solid #78716c; background: #fff; border-radius: 4px; cursor: pointer; }
    .toolbar .hint { width: 100%; text-align: center; color: #44403c; font-size: 12px; }
    .label { width: 4in; height: 6in; margin: 0 auto 16px; background: #fff; padding: 0.15in; display: flex; flex-direction: column;
             overflow: hidden; }
    /* Break before each label after the first (not after each one): Cloudflare appends scripts to the body, so
       :last-child can't be trusted, and a trailing break prints a blank label. */
    .label + .label { page-break-before: always; break-before: page; }
    .company { background: #000; color: #fff; text-align: center; font-weight: 900; font-size: 21px; letter-spacing: .02em;
               padding: 0.08in 0.05in; text-transform: uppercase; line-height: 1.05; }
    .tag { text-align: center; font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; margin: 3px 0 4px; }
    .k { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; display: block; }
    .po { border: 3px solid #000; text-align: center; padding: 2px 4px 4px; }
    .po .v { font-size: 40px; font-weight: 900; line-height: 1.05; word-break: break-all; }
    .row { display: grid; grid-template-columns: 1fr 1fr; border: 2px solid #000; border-top: none; }
    .row > div { padding: 3px 6px; }
    .row > div + div { border-left: 2px solid #000; }
    .row .v { font-size: 17px; font-weight: 700; }
    .vendor { border: 2px solid #000; border-top: none; padding: 3px 6px; }
    .vendor .v { font-size: 17px; font-weight: 700; line-height: 1.15; overflow: hidden; display: -webkit-box;
                 -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
    .products { border: 2px solid #000; border-top: none; padding: 3px 6px; flex: 1; overflow: hidden; }
    .products table { width: 100%; border-collapse: collapse; font-size: 12px; }
    .products td { padding: 1px 0; vertical-align: top; }
    .products td.id { white-space: nowrap; font-weight: 900; font-size: 13px; padding-right: 6px; }
    .products td.q { text-align: right; white-space: nowrap; font-weight: 700; padding-left: 6px; }
    .products .name { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; }
    .products .more { font-size: 11px; font-style: italic; }
    .note { border-top: 2px solid #000; margin-top: 4px; padding-top: 2px; }
    .note .v { font-size: 13px; font-weight: 700; line-height: 1.15; overflow: hidden; display: -webkit-box;
               -webkit-line-clamp: 4; -webkit-box-orient: vertical; }
    .bottom { display: flex; align-items: center; gap: 0.12in; margin-top: 0.08in; }
    .qr { width: 1.45in; height: 1.45in; flex: none; }
    .qr svg { width: 100%; height: 100%; display: block; }
    .bottom .info { flex: 1; min-width: 0; }
    .pallet { font-size: 26px; font-weight: 900; line-height: 1.1; }
    .bottom .small { font-size: 11px; margin-top: 4px; }
    @page { size: 4in 6in; margin: 0; }
    @media print {
      body { background: #fff; padding: 0; }
      .toolbar { display: none; }
      html, body { margin: 0; }
      .label { margin: 0; height: 5.98in; } /* a hair under 6in so rounding never spills onto another label */
    }
  </style>
</head>
<body>
  <form class="toolbar" method="get" action="<%= pallet_labels_purchase_order_path(po) %>">
    <label>Pallets received <input type="number" name="count" min="1" max="<%= PurchaseOrdersController::PALLET_LABEL_LIMIT %>" value="<%= @count %>"></label>
    <label>Note <input type="text" name="note" class="note" maxlength="<%= PurchaseOrdersController::LABEL_NOTE_LIMIT %>" value="<%= @note %>" placeholder="optional, prints on every label"></label>
    <button type="submit">Update</button>
    <button type="button" onclick="window.print()">Print <%= pluralize(@count, 'label') %></button>
    <div class="hint">Print to the Zebra with paper size 4 × 6 in, margins none, scale 100%.</div>
  </form>

  <% 1.upto(@count) do |n| %>
    <section class="label">
      <div class="company"><%= company %></div>
      <div class="tag">Purchased inventory</div>

      <div class="po"><span class="k">PO Number</span><span class="v"><%= po.display_number %></span></div>
      <div class="row">
        <div><span class="k">Received</span><span class="v"><%= received_on.strftime('%m/%d/%Y') %></span></div>
        <div><span class="k">Warehouse</span><span class="v"><%= po.location&.pdi_site_code.presence || po.location&.company_name || '—' %></span></div>
      </div>
      <div class="vendor"><span class="k">Vendor</span><span class="v"><%= po.vendor&.name || po.vendor_id %></span></div>

      <div class="products">
        <span class="k">Product ID · Products on PO</span>
        <table>
          <% shown.each do |line| %>
            <tr>
              <td class="id"><%= line.product_id %></td>
              <td><span class="name"><%= line.display_name %></span></td>
              <td class="q"><%= qty.(line.quantity) %> <%= line.package_code.presence || line.product&.pdi_package_code %></td>
            </tr>
          <% end %>
        </table>
        <% if lines.size > shown.size %>
          <div class="more">+ <%= pluralize(lines.size - shown.size, 'more line') %> (scan for full PO)</div>
        <% end %>
      </div>

      <div class="bottom">
        <div class="qr" data-qr="<%= po_url %>"></div>
        <div class="info">
          <div class="pallet">Pallet <%= n %> of <%= @count %></div>
          <div class="small">Scan to open PO <%= po.display_number %></div>
          <div class="note" data-note-box <%= 'hidden' if @note.blank? %>><span class="k">Notes</span><span class="v" data-note><%= @note %></span></div>
        </div>
      </div>
    </section>
  <% end %>
  <script>
    // The note shows on the labels as it's typed, so Print never needs an Update first.
    document.querySelector('input.note').addEventListener('input', (e) => {
      const text = e.target.value.trim();
      document.querySelectorAll('[data-note-box]').forEach((box) => {
        box.hidden = text === '';
        box.querySelector('[data-note]').textContent = text;
      });
    });
  </script>
</body>
</html>
