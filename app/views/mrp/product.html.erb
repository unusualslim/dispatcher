<% qty = ->(n) { number_with_precision(n, precision: 1, delimiter: ',', strip_insignificant_zeros: true) } %>
<div class="mb-3">
  <%= link_to "← MRP", mrp_path(horizon: @horizon), class: "text-decoration-none small" %>
  <h1 class="mb-0 mt-1"><%= @product&.name %></h1>
  <div class="text-muted small"><%= @product&.id %> · <%= @product&.category %> · <%= link_to 'product page', product_path(@product) if @product %></div>
</div>

<% @plans.each do |plan| %>
  <div class="card shadow-sm mb-4">
    <div class="card-header d-flex justify-content-between flex-wrap gap-2">
      <span class="fw-semibold"><%= plan.location&.company_name || 'No warehouse' %></span>
      <span class="small text-muted">
        On hand <%= qty.(plan.on_hand) %> <%= @product&.unit_of_measurement %>
        · safety <%= qty.(plan.safety) %>
        · <%= plan.manufactured? ? 'production' : 'lead' %> time <%= plan.lead_days %> days
        · runs out <%= plan.runs_out_on&.strftime('%b %-d') || (plan.below_safety_on ? "below safety #{plan.below_safety_on.strftime('%b %-d')}" : '—') %>
      </span>
    </div>
    <div class="card-body p-0">
      <table class="table table-sm align-middle mb-0">
        <thead class="table-light"><tr><th>Date</th><th>What</th><th class="text-end">Change</th><th class="text-end">Balance</th></tr></thead>
        <tbody>
          <tr><td><%= Date.current.strftime('%b %-d') %></td><td>On hand</td><td></td><td class="text-end fw-semibold"><%= qty.(plan.on_hand) %></td></tr>
          <% if plan.rows.empty? %>
            <tr><td colspan="4" class="text-muted text-center py-3">No open orders, production or purchase orders in the horizon.</td></tr>
          <% end %>
          <% plan.rows.each do |row| %>
            <% event = row.event %>
            <tr class="<%= 'table-warning fst-italic' if event.planned? && (event.supply? || event.transfer?) %>">
              <td class="text-nowrap"><%= event.date.strftime('%b %-d') %></td>
              <td>
                <%= event.path ? link_to(event.label, event.path, class: 'text-decoration-none') : event.label %>
                <% event.flags.each do |flag| %>
                  <span class="badge <%= flag == :draft ? 'bg-secondary' : 'bg-danger' %>"><%= flag %><%= " (#{event.original_date.strftime('%b %-d')})" if event.original_date %></span>
                <% end %>
              </td>
              <td class="text-end <%= event.supply? ? 'text-success' : 'text-danger' %>"><%= event.supply? ? '+' : '' %><%= qty.(event.qty) %></td>
              <td class="text-end fw-semibold <%= 'text-danger' if row.balance.negative? %> <%= 'text-warning' if !row.balance.negative? && row.balance < plan.safety %>">
                <%= qty.(row.balance) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>

<% if @unassigned.any? %>
  <div class="card shadow-sm border-warning">
    <div class="card-header fw-semibold">Needs a warehouse</div>
    <div class="card-body small">
      <p class="text-muted">These have no warehouse, so they aren't counted against any warehouse's stock. Set the warehouse on the PO, production order or order line.</p>
      <ul class="mb-0">
        <% @unassigned.each do |event| %>
          <li><%= link_to event.label, event.path %>: <%= qty.(event.qty) %>, <%= (event.original_date || event.date).strftime('%b %-d') %></li>
        <% end %>
      </ul>
    </div>
  </div>
<% end %>
