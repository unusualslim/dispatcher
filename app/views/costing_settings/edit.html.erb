<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Costing Settings</h1>
</div>

<%= form_with url: costing_settings_path, method: :patch, local: true do %>
  <div class="row g-3">
    <div class="col-lg-5">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <label class="form-label fw-semibold" for="labor_rate">Line labor rate ($/hour)</label>
          <div class="input-group" style="max-width: 220px;">
            <span class="input-group-text">$</span>
            <%= number_field_tag :labor_rate, @labor_rate, step: 'any', min: 0, class: 'form-control', required: true %>
          </div>
          <div class="form-text">
            One blended rate for everyone who clocks in on /line. It prices the Line Labor standard on each
            product's BOM and the actual labor on production orders (crew-hours × rate).
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-7">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <div class="fw-semibold mb-1">Production GL accounts (FPST journal)</div>
          <div class="form-text mt-0 mb-3">
            Major-Sub only, e.g. <code>6110-01</code>. Each production order's location supplies the site,
            so lines post as Site-Major-Sub. Cost line accounts are set per
            <%= link_to 'reporting group', reporting_groups_path %>.
          </div>
          <% ProductionOrderJournal::ACCOUNT_ROLES.each do |role, label| %>
            <div class="row g-2 align-items-center mb-2">
              <label class="col-sm-6 col-form-label col-form-label-sm" for="gl_accounts_<%= role %>"><%= label %></label>
              <div class="col-sm-6">
                <%= text_field_tag "gl_accounts[#{role}]", @gl_accounts[role], id: "gl_accounts_#{role}",
                                   class: 'form-control form-control-sm font-monospace', placeholder: 'Major-Sub' %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-3"><%= submit_tag 'Save', class: 'btn btn-primary' %></div>
<% end %>
