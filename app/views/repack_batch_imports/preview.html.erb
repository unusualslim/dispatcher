<div class="container-fluid px-4 mt-4">
  <div class="d-flex justify-content-between align-items-start mb-3">
    <div>
      <h1 class="mb-1">Preview Repack Batch Import</h1>
      <p class="text-muted mb-0">
        <% if @create_count > 0 %>
          <span class="text-success fw-semibold"><%= @create_count %> production orders to create</span>
        <% end %>
        <% if @skip_exists_count > 0 %>
          &nbsp;&middot;&nbsp;<span class="text-muted"><%= @skip_exists_count %> already imported</span>
        <% end %>
        <% if @skip_reversed_count > 0 %>
          &nbsp;&middot;&nbsp;<span class="text-muted"><%= @skip_reversed_count %> reversed (skipped)</span>
        <% end %>
        <% if @skip_no_product_count > 0 %>
          &nbsp;&middot;&nbsp;<span class="text-danger fw-semibold"><%= @skip_no_product_count %> product not found</span>
        <% end %>
      </p>
    </div>
    <%= link_to "Cancel", new_repack_batch_import_path, class: "btn btn-outline-secondary" %>
  </div>

  <%= form_with url: repack_batch_import_path, method: :post, data: { turbo: false } do |f| %>

    <% creates = @rows.select { |r| r.action == :create } %>
    <% if creates.any? %>
      <div class="card shadow-sm mb-3">
        <div class="card-header bg-success text-white">
          <h6 class="mb-0">Production Orders to Create (<%= creates.size %>)</h6>
        </div>
        <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
          <table class="table table-sm table-hover mb-0">
            <thead class="table-light" style="position: sticky; top: 0;">
              <tr>
                <th>PDI Batch</th>
                <th>Date</th>
                <th>Status</th>
                <th>Product</th>
                <th class="text-end">Qty</th>
                <th class="text-center">Components</th>
                <th>Warehouse</th>
                <th>Source</th>
              </tr>
            </thead>
            <tbody>
              <% creates.each do |row| %>
                <tr>
                  <td class="font-monospace small">PDI-<%= row.batch_key %></td>
                  <td class="text-nowrap"><%= row.business_date&.strftime('%b %-d, %Y') || '—' %></td>
                  <td>
                    <% if row.status == 'Posted' %>
                      <span class="badge bg-success">Completed</span>
                    <% else %>
                      <span class="badge bg-warning text-dark">Pending</span>
                    <% end %>
                  </td>
                  <td>
                    <% if row.product %>
                      <%= row.product.name %>
                    <% else %>
                      <%= row.product_name %>
                      <code class="small text-muted ms-1"><%= row.product_id %></code>
                    <% end %>
                  </td>
                  <td class="text-end"><%= number_with_precision(row.qty, precision: 1, strip_insignificant_zeros: true) %></td>
                  <td class="text-center"><%= row.component_count %></td>
                  <td><%= row.warehouse_name || '—' %></td>
                  <td class="small text-muted"><%= row.source %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>

    <% skipped = @rows.select { |r| r.action == :skip_no_product } %>
    <% if skipped.any? %>
      <div class="card shadow-sm mb-3">
        <div class="card-header bg-danger text-white">
          <h6 class="mb-0">Skipped — Product Not Found (<%= skipped.size %>)</h6>
        </div>
        <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
          <table class="table table-sm table-hover mb-0">
            <thead class="table-light" style="position: sticky; top: 0;">
              <tr>
                <th>PDI Batch</th>
                <th>Date</th>
                <th>Product ID</th>
                <th>Product Name</th>
              </tr>
            </thead>
            <tbody>
              <% skipped.each do |row| %>
                <tr class="text-muted">
                  <td class="font-monospace small">PDI-<%= row.batch_key %></td>
                  <td><%= row.business_date&.strftime('%b %-d, %Y') || '—' %></td>
                  <td class="font-monospace small"><%= row.product_id %></td>
                  <td><%= row.product_name %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>

    <% if @skip_reversed_count > 0 %>
      <div class="alert alert-secondary">
        <i class="bi bi-skip-forward"></i> <strong><%= @skip_reversed_count %> reversed batches</strong> will be skipped.
      </div>
    <% end %>

    <% if @skip_exists_count > 0 %>
      <div class="alert alert-secondary">
        <i class="bi bi-check-circle"></i> <strong><%= @skip_exists_count %> batches</strong> already imported — will be skipped.
      </div>
    <% end %>

    <div class="d-flex gap-2 mt-3 mb-5">
      <%= f.submit "Confirm Import", class: "btn btn-success btn-lg" %>
      <%= link_to "Cancel", new_repack_batch_import_path, class: "btn btn-outline-secondary btn-lg" %>
    </div>
  <% end %>
</div>
