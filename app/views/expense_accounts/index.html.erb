<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Expense Accounts</h1>
  <div class="d-flex gap-2 align-items-center">
    <input type="search" id="account-filter" class="form-control form-control-sm" style="width: 260px;"
           placeholder="Filter by number or name…" autocomplete="off">
    <% if @show_inactive %>
      <%= link_to 'Hide inactive', expense_accounts_path, class: 'btn btn-outline-secondary btn-sm text-nowrap' %>
    <% elsif @inactive_count.positive? %>
      <%= link_to "Show inactive (#{@inactive_count})", expense_accounts_path(inactive: 1), class: 'btn btn-outline-secondary btn-sm text-nowrap' %>
    <% end %>
  </div>
</div>

<p class="text-muted" style="max-width: 900px;">
  GL expense accounts that <%= link_to 'expense purchase orders', purchase_orders_path(type: 'expense') %> charge to,
  from PDI's chart of accounts (Expense type; accounts disabled in PDI are inactive). Enter Major-Sub, e.g.
  <code>6810-10</code>; each PO line adds its site, so it shows as Site-Major-Sub. Expense POs aren't sent to PDI: AP
  keys the vendor bill into PDI against these accounts. Untick Active to keep an account out of the PO picker.
</p>

<datalist id="account-groups">
  <% @groups.each do |group| %><option value="<%= group %>"></option><% end %>
</datalist>

<div class="card shadow-sm" style="max-width: 1100px;">
  <div class="table-responsive">
    <table class="table table-sm align-middle mb-0" id="accounts-table">
      <thead class="table-light">
        <tr>
          <th style="width: 110px;">Account</th>
          <th>Name</th>
          <th style="width: 190px;">Group</th>
          <th style="width: 200px;">Notes</th>
          <th class="text-center" style="width: 60px;">Active</th>
          <th class="text-end" style="width: 60px;" title="PO lines charged to this account">Lines</th>
          <th style="width: 130px;"></th>
        </tr>
      </thead>
      <tbody>
        <% @expense_accounts.group_by { |a| a.account_group.presence || 'Other' }.each do |group, accounts| %>
          <tr class="table-secondary group-row"><td colspan="7" class="fw-semibold small"><%= group %> <span class="text-muted fw-normal">(<%= accounts.size %>)</span></td></tr>
          <% accounts.each do |account| %>
            <% form_id = "expense_account_#{account.id}" %>
            <% in_use = @line_counts[account.id].to_i %>
            <tr class="account-row <%= 'text-muted' unless account.active? %>" data-search="<%= "#{account.account} #{account.name}".downcase %>">
              <td><%= text_field_tag 'expense_account[account]', account.account, form: form_id, class: 'form-control form-control-sm font-monospace', required: true, pattern: '\d{4}-\d{2}' %></td>
              <td><%= text_field_tag 'expense_account[name]', account.name, form: form_id, class: 'form-control form-control-sm', required: true %></td>
              <td><%= text_field_tag 'expense_account[account_group]', account.account_group, form: form_id, list: 'account-groups', class: 'form-control form-control-sm' %></td>
              <td><%= text_field_tag 'expense_account[notes]', account.notes, form: form_id, class: 'form-control form-control-sm' %></td>
              <td class="text-center">
                <%= hidden_field_tag 'expense_account[active]', '0', form: form_id, id: nil %>
                <%= check_box_tag 'expense_account[active]', '1', account.active?, form: form_id, class: 'form-check-input', id: "active_#{account.id}" %>
              </td>
              <td class="text-end"><%= in_use %></td>
              <td class="text-end text-nowrap">
                <%= form_with model: account, id: form_id, method: :patch, class: 'd-inline' do %>
                  <button type="submit" class="btn btn-sm btn-primary">Save</button>
                <% end %>
                <% if in_use.zero? && admin? %>
                  <%= button_to 'Delete', expense_account_path(account), method: :delete, class: 'btn btn-sm btn-outline-danger',
                                                                         form: { class: 'd-inline', data: { turbo_confirm: "Delete #{account.account}?" } } %>
                <% end %>
              </td>
            </tr>
          <% end %>
        <% end %>
        <% if @expense_accounts.empty? %>
          <tr><td colspan="7" class="text-muted small py-3">No expense accounts yet. Add the first one below.</td></tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr class="table-light">
          <td><%= text_field_tag 'expense_account[account]', nil, form: 'new_expense_account', class: 'form-control form-control-sm font-monospace', placeholder: '6810-10', required: true, pattern: '\d{4}-\d{2}' %></td>
          <td><%= text_field_tag 'expense_account[name]', nil, form: 'new_expense_account', class: 'form-control form-control-sm', placeholder: 'REPAIR & MAINT - MACH & EQUIP', required: true %></td>
          <td><%= text_field_tag 'expense_account[account_group]', nil, form: 'new_expense_account', list: 'account-groups', class: 'form-control form-control-sm', placeholder: 'Operating Expenses' %></td>
          <td><%= text_field_tag 'expense_account[notes]', nil, form: 'new_expense_account', class: 'form-control form-control-sm' %></td>
          <td></td>
          <td></td>
          <td class="text-end">
            <%= form_with model: ExpenseAccount.new, id: 'new_expense_account', class: 'd-inline' do %>
              <button type="submit" class="btn btn-sm btn-success">Add</button>
            <% end %>
          </td>
        </tr>
      </tfoot>
    </table>
  </div>
</div>

<script>
  (function() {
    const input = document.getElementById('account-filter');
    if (!input) return;
    input.addEventListener('input', function() {
      const q = input.value.trim().toLowerCase();
      document.querySelectorAll('#accounts-table .account-row').forEach(function(row) {
        row.style.display = !q || row.dataset.search.includes(q) ? '' : 'none';
      });
      document.querySelectorAll('#accounts-table .group-row').forEach(function(row) {
        row.style.display = q ? 'none' : '';
      });
    });
  })();
</script>
