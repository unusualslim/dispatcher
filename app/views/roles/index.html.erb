<div class="container-fluid px-4 py-4" style="max-width: 1100px;">
  <div class="d-flex justify-content-between align-items-center mb-1">
    <h1 class="mb-0">Roles</h1>
    <%= link_to 'New role', new_role_path, class: 'btn btn-primary btn-sm' %>
  </div>
  <p class="text-muted small mb-3" style="max-width: 760px;">
    Build roles here and give them to staff on the <%= link_to 'Users', users_path %> page. A user can hold any
    number of roles, and their access adds up: the highest area level of any role, plus every feature right and data
    flag any role grants. A role can't take access away; to keep data from one person, use
    <strong>Hidden from this user</strong> on their user page (works for admins too).
  </p>

  <div class="card shadow-sm">
    <table class="table table-sm align-middle mb-0">
      <thead class="table-light">
        <tr><th>Role</th><th>Areas</th><th>Features</th><th>Data</th><th>Assistant</th><th>Users</th><th></th></tr>
      </thead>
      <tbody>
        <% @roles.each do |role| %>
          <tr>
            <td>
              <%= link_to role.name, edit_role_path(role), class: 'fw-semibold' %>
              <% if role.description.present? %><div class="small text-muted"><%= role.description %></div><% end %>
            </td>
            <td class="small"><%= role.area_summary %></td>
            <td class="small"><%= role.features.map { |f| User::FEATURES.dig(f, :label) }.compact.join(', ').presence || '—' %></td>
            <td class="small"><%= role.data_flags.map { |f| User::DATA_FLAGS.dig(f, :label) }.compact.join(', ').presence || '—' %></td>
            <td class="small"><%= User::ASSISTANT_LEVELS[role.assistant_level] %></td>
            <td class="small"><%= role.users.map { |u| u.full_name.strip.presence || u.email }.sort.join(', ').presence || '—' %></td>
            <td class="text-end"><%= link_to 'Edit', edit_role_path(role), class: 'btn btn-outline-secondary btn-sm' %></td>
          </tr>
        <% end %>
        <% if @roles.empty? %>
          <tr><td colspan="7" class="text-muted text-center py-3">No roles yet.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
