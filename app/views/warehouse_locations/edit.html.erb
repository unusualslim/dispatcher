<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Warehouse Dropdown Locations</h1>
</div>

<div class="row">
  <div class="col-lg-6">
    <div class="card shadow-sm">
      <div class="card-header">
        <strong>Choose which locations appear in the warehouse selector</strong>
        <p class="text-muted small mb-0 mt-1">Only origin/terminal locations (category 1) can appear in the dropdown.</p>
      </div>
      <div class="card-body">
        <%= form_with url: warehouse_locations_path, method: :patch, local: true do |f| %>
          <% @locations.each do |loc| %>
            <div class="form-check mb-2">
              <input type="checkbox"
                     name="location_ids[]"
                     value="<%= loc.id %>"
                     id="loc_<%= loc.id %>"
                     class="form-check-input"
                     <%= 'checked' if loc.show_in_warehouse_dropdown %>>
              <label class="form-check-label" for="loc_<%= loc.id %>">
                <%= loc.company_name %>
                <% if loc.city.present? %>
                  <span class="text-muted small">— <%= loc.city %>, <%= loc.state %></span>
                <% end %>
              </label>
            </div>
          <% end %>

          <% if @locations.empty? %>
            <p class="text-muted">No origin locations found.</p>
          <% end %>

          <div class="mt-3 d-flex gap-2">
            <%= f.submit "Save", class: "btn btn-primary" %>
            <%= link_to "Cancel", root_path, class: "btn btn-outline-secondary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
