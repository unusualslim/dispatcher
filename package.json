{
  "name": "app",
  "private": "true",
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^7.3.0",
    "@popperjs/core": "^2.11.8",
    "@rails/actiontext": "~7.2.400",
    "@types/sortablejs": "^1.15.9",
    "autoprefixer": "^10.6.2",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "esbuild": "^0.28.2",
    "jquery": "^4.0.0",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.32",
    "postcss-cli": "^12.0.0",
    "qrcode-generator": "^2.0.4",
    "sass": "^1.107.0",
    "sortablejs": "^1.15.7",
    "trix": "^2.1.19"
  },
  "scripts": {
    "build": "esbuild app/javascript/*.* --bundle --sourcemap --outdir=app/assets/builds",
    "build:css": "yarn build:css:compile && yarn build:css:prefix",
    "build:css:compile": "sass ./app/assets/stylesheets/application.bootstrap.scss:./app/assets/builds/application.css --no-source-map --load-path=node_modules --quiet-deps --silence-deprecation=import",
    "build:css:prefix": "postcss ./app/assets/builds/application.css --use=autoprefixer --output=./app/assets/builds/application.css",
    "watch:css": "nodemon --watch ./app/assets/stylesheets/ --ext scss --exec \"yarn build:css\""
  },
  "browserslist": [
    "defaults"
  ]
}
